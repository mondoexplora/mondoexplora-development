13:T989,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Panglao",
  "description": "Discover the best hotels in Panglao, Philippines. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Philippines"
  },
  "url": "https://mondoexplora.com/en/destination/panglao",
  "image": "https://images.luxuryescapes.com/65ruc363gkqpxq74w34",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Panglao",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Tropical paradise means white sandy beaches, swaying palm trees, bright blue waters, and sunset cocktails and you’ll find all this and more at Oceanica Resort Panglao. It's not hard to see why this resort is ranked within the top 10% of all properties on Tripadvisor with its warm Bohol hospitality and pristine private stretch of beach. Days stretch long here: swim in the glorious pool, indulge in a pampering treatment at Zenses The Spa, feast on fresh seafood at Oceanica Seafood Restaurant, or lay a towel along Bohol Beach’s sugar-fine sand and while away an afternoon basking in the sun. Marine life is in abundance around Panglao Island, so don your snorkel or dive gear and head out for a glimpse into this marine wonderland, or for those seeking the buzzing nightlife, Alona Beach is brimming with blissed-out beach bars, clubs, live music venues and restaurants.",
          "image": "https://images.luxuryescapes.com/65ruc363gkqpxq74w34",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Panglao",
            "addressCountry": "Philippines"
          },
          "priceRange": "$190",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 190,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/panglao"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
