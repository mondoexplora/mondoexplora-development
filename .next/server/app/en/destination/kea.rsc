  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Kea",
  "description": "Discover the best hotels in Kea, Greece. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Greece"
  },
  "url": "https://mondoexplora.com/en/destination/kea",
  "image": "https://images.luxuryescapes.com/3l9mrdjbojrz77kn8sit",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Kea",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Uncover the untouched beauty of Kea Island with a stay at this five-star hillside resort overlooking the Aegean Sea - perfectly positioned to explore the island's charming villages, ancient ruins and hiking trails. Savour Japanese and Mediterranean fusion at the onsite restaurant, Mizu, or indulge in a rejuvenating treatment at the world-class Cyrene Spa. The hotel is a stone's throw from the pristine Otzias Beach, perfect for a refreshing dip in the salty ocean. As the day draws to a close, retreat to your elegantly appointed room, where floor-to-ceiling windows offer breathtaking views of the surrounding landscape.",
          "image": "https://images.luxuryescapes.com/3l9mrdjbojrz77kn8sit",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Kea",
            "addressCountry": "Greece"
          },
          "priceRange": "$180",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 180,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/kea"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover laidback luxury with a dash of Cycladic charm at Porto Kea Suites, tucked away on Greece's hidden gem island, Kea. Spend sun-drenched days lounging by the pool or indulge in authentic Greek cuisine at the hotel's traditional restaurant. The dedicated bar staff offers refreshing cocktails and light bites served poolside, perfect for those lazy afternoon moments between swims. Nestled in a tranquil spot near Korissia port, the best of Kea is at your fingertips. Stroll to nearby sandy beaches, explore the ancient hiking trails that crisscross the island, or take a short drive to discover Ioulida, the island's picturesque capital known for its stone-built houses and ancient stone lion, carved from a natural slab.",
          "image": "https://images.luxuryescapes.com/2ne6v0uysiv6l5h8l8o",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Kea",
            "addressCountry": "Greece"
          },
          "priceRange": "$154",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 154,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/kea"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
