  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Cebu",
  "description": "Discover the best hotels in Cebu, Philippines. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Philippines"
  },
  "url": "https://mondoexplora.com/en/destination/cebu",
  "image": "https://images.luxuryescapes.com/owtefzap3cyguysypil",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Cebu",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience one of Lapu-Lapu City's most stylish hotels with a stay at the lush five-star Shangri-La Mactan, Cebu. Nestled within a tropical paradise that spans 13 hectares of manicured gardens on the coast of Mactan Island, this beachfront paradise feels remote, yet very central. Designed with inspiration from traditional Filipino architecture, you can expect casual glamour and elements of local craftsmanship and modern technologies, traditional décor and wide swathes of lush greenery. While here, indulge at Chi, The Spa, with a luxurious massage or traditional well-being treatment inspired by ancient Asian practices. Or, get your heart pumping in the fitness centre then take a dip in one of the two swimming pools. Idyllic afternoons are best spent lazing on the private white-sand beach, or adrift with 160 species of aquatic life at the resort's Marine Sanctuary. Foodies are also spoiled for choice with an extraordinary variety of cuisines from every corner of the globe across five restaurants.",
          "image": "https://images.luxuryescapes.com/owtefzap3cyguysypil",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cebu",
            "addressCountry": "Philippines"
          },
          "priceRange": "$162",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 162,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cebu"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
