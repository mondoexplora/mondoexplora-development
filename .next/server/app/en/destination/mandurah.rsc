12:Tffb,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Mandurah",
  "description": "Discover the best hotels in Mandurah, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/mandurah",
  "image": "https://images.luxuryescapes.com/yej937uyblosqc6kmpyi",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Mandurah",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Set on the shores of Comet Bay, surrounded by the Indian Ocean and glittering waters of Dolphin Quay on the Mandurah Ocean Marina, Seashells Mandurah is an ode to beachfront living. Only an hour's drive from Perth and brimming with waterfront restaurants, sprawling waterways, long stretches of coastline and winding wilderness trails, this charming resort town invites you to discover a place with perpetual summer vibes. Do as much or as little as you like, coming and going from your apartment as you please. Mandurah's restaurants and bars are at your fingertips should you choose, or you'll have a full kitchen at your disposal for laidback evenings at your accommodation. There's also a communal BBQ area, perfect for balmy beachfront evenings. Lounge beside the infinity-edge pool or venture further afield for waterside walks and nature park trails - this is easy breezy coastal living at its best.",
          "image": "https://images.luxuryescapes.com/yej937uyblosqc6kmpyi",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mandurah",
            "addressCountry": "Australia"
          },
          "priceRange": "$133",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 133,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mandurah"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Fall in love with the tranquil charms of Western Australia's Mandurah from this sophisticated stay overlooking the serene waters of Mandjar Bay. Only an hour's drive from Perth, the property boasts elegantly appointed rooms and self-contained apartments, perfect for family and friends. Spend your days lounging by the hotel's pool, curled up with a book, take leisurely strolls along the esplanade or head out on an adventurous cruise and get a chance to spot playful bottlenose dolphins. Surrounded by breathtaking beaches, lakes and inlets of the Mandurah-Peel region, the hotel acts as the ideal launchpad for all explorations. Plus, it also offers a vast array of alfresco waterfront restaurants, theatres and museums right on its doorstep.",
          "image": "https://images.luxuryescapes.com/4pcn0l8rfoypszxfsrw",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mandurah",
            "addressCountry": "Australia"
          },
          "priceRange": "$134",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 134,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mandurah"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
