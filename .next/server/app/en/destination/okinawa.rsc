11:Tde6,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Okinawa",
  "description": "Discover the best hotels in Okinawa, Japan. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Japan"
  },
  "url": "https://mondoexplora.com/en/destination/okinawa",
  "image": "https://images.luxuryescapes.com/ab5lqi7ybp7sp19k0uih",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Okinawa",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Combining Japanese tradition with a touch of modern luxury, this seaside sanctuary is your ideal Okinawa retreat. Greeted by views of the East China Sea and nestled amid lush landscapes, spend your days by one of Okinawa's largest pools, float along the lazy river or relax in the adults-only pool while the kids discover the thrilling water slides. Immerse yourself in Okinawan 'chimugukuru' hospitality and savour dynamic local and international cuisine at Le Sensoriel, including regional favourites prepared with a twist. For something a little different, make the most of the unique onsen and open-air public bath experiences onsite.",
          "image": "https://images.luxuryescapes.com/ab5lqi7ybp7sp19k0uih",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Okinawa",
            "addressCountry": "Japan"
          },
          "priceRange": "$88",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 88,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/okinawa"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "InterContinental Ana Manza Beach Resort combines five-star luxury with the best of tradition, in Japan's southern isle of Okinawa. Take in the panoramic waterfront views, dive into the glittering East China Sea at the hotel’s private beach where kaleidoscopic coral reefs await or explore Cape Manza on a catamaran cruise. With world-class dining options within the resort, a luxurious wellness centre and an abundance of resort activities, there’s an endless supply of entertainment at your fingertips.",
          "image": "https://images.luxuryescapes.com/nrxwm89o2zdqfz8t7h",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Okinawa",
            "addressCountry": "Japan"
          },
          "priceRange": "$122",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 122,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/okinawa"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
