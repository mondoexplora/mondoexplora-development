11:T15f3,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Victoria",
  "description": "Discover the best hotels in Victoria, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/victoria",
  "image": "https://images.luxuryescapes.com/dq4f0u1lt0vafufjogg",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Victoria",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "From world-renowned sporting events to graffitied laneways lined with exquisite restaurants and boutiques, to must-see art galleries and museums, Melbourne has something for everyone - and WRAP on Southbank is the perfect launchpad to unearth the city's delights. Take your pick from a stylish studio or modern apartment abode and enjoy an impeccable list of onsite facilities including a shimmering pool, undercover secure parking and a fully equipped fitness centre. While the wonders of Melbourne's lively neighbourhoods may tempt you away from your inner-city base, you can also find exceptional eateries along the Yarra River from Southgate to the Crown Entertainment Complex, maritime adventures at Polly Woodside or treat yourself to a new outfit at DFO South Wharf.",
          "image": "https://images.luxuryescapes.com/dq4f0u1lt0vafufjogg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Victoria",
            "addressCountry": "Australia"
          },
          "priceRange": "$90",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 90,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/victoria"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Delve into Melbourne's eclectic art scene with a stylish stay at this aesthetic retreat, perfectly positioned on Chapel Street, the city's fashion and foodie hub. Each suite or penthouse in this boutique hotel is adorned with the lyrical artwork of renowned Australian artist John Olsen, lending it a characteristic aura. You can take a stroll along the Yarra River or venture a little further to explore Melbourne's sports and entertainment hubs. Back at your art-filled hotel, go for a swim in the glass-bottomed pool overlooking Chapel Street, indulge in a paddock-to-plate dining experience at Spoonbill Restaurant and sip on refreshing drinks at the high-end dive bar, Two Wrongs, after a long day of urban adventures.",
          "image": "https://images.luxuryescapes.com/yjhejewgl45olzdu0nl",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Victoria",
            "addressCountry": "Australia"
          },
          "priceRange": "$100",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 100,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/victoria"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "From stylish boutiques to lively restaurants and bars, the inner-city suburb of South Yarra offer something for everyone. Experience the excitement firsthand with a stylish stay at Oaks Melbourne South Yarra Suites - saunter along Chapel Street or Toorak Road and shop ‘til you drop, get your caffeine fix at any of the ubiquitous cafés Melbourne is famous for or pull up a chair at one of the many restaurants nearby. Venture a little further to the Royal Botanic Gardens and Shrine of Remembrance or hop on the tram or train to easily reach the CBD, where stencilled laneways await you. After a long day of discovery, settle back for a spectacular sunset view on the hotel’s rooftop terrace for a peaceful finish to your day, or retreat to your stylish studio apartment with a kitchenette and private balcony.",
          "image": "https://images.luxuryescapes.com/kd073oegghlioxrh0p",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Victoria",
            "addressCountry": "Australia"
          },
          "priceRange": "$94",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 94,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/victoria"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
}5:["$","main",null,{"className":"min-h-screen","children":[["$","$L10",null,{"pageType":"destination","destination":"Victoria","country":"Australia","hotelCount":3,"minPrice":90}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],"$L12","$L13","$L14"]}]
