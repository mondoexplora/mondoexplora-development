    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Drift into pure bliss at this beachfront sanctuary, nestled in a traditional village setting and perched on the shores of the Dead Sea - the lowest place on the planet. Float in its legendary waters, rich in healing minerals, and let centuries of wellness tradition wash over you. Indulge in world-class pampering at Zara Spa, with hydrotherapy, steam rituals, and Dead Sea mud treatments designed to soothe and renew. Bask by the infinity pool, or unwind on the private beach as the sun dips behind desert mountains. Culinary delights await at nine diverse restaurants and bars, from wood-fired Italian fare at Luigi’s to Mediterranean feasts at The Grill. Plus, don’t miss the daily Movenpick Chocolate Hour to add sweetness to your day. Whether seeking therapeutic renewal or an indulgent escape, this resort offers an unforgettable Dead Sea experience.",
          "image": "https://images.luxuryescapes.com/buqaexjuhbq8u020no3a",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Sweimeh",
            "addressCountry": "Jordan"
          },
          "priceRange": "$109",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 109,
