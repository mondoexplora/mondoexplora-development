12:T2740,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Christchurch",
  "description": "Discover the best hotels in Christchurch, New Zealand. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "New Zealand"
  },
  "url": "https://mondoexplora.com/en/destination/christchurch",
  "image": "https://images.luxuryescapes.com/1664u0oohu79lq9fp0m",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Christchurch",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Unveil the mysteries of the 'Garden City' from the heart of the action in this chic accommodation, blending European elegance with modern flair. Each self-contained suite is equipped with all the essentials, from spacious wardrobes to cosy lounges. Unwind at The Montreal Bar & Restaurant, where locally sourced, seasonal fare meets chic courtyard dining and live music. The flourishing city of Christchurch is known for its art galleries, beautiful gardens, cool street art and cosy cafes, set against a majestic alpine and ocean landscape. Visit Christchurch Art Gallery and Canterbury Museum, stroll down to the verdant Hagley Park or trace Christchurch’s Avon River for beautiful days out.",
          "image": "https://images.luxuryescapes.com/1664u0oohu79lq9fp0m",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Christchurch",
            "addressCountry": "New Zealand"
          },
          "priceRange": "$339",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 339,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/christchurch"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Find yourself in the centre of it all from this sophisticated Christchurch urban haven, perfectly located in the heart of the CBD, within easy walking distance of the Te Pae Christchurch Convention Centre. Soak up the views of the historic Cathedral Square and the distant Southern Alps as you relax and unwind in the bright, airy rooms and feel right at home. If you're looking to explore, the best of New Zealand's 'Garden City' awaits at your doorstep: visit the vibrant Riverside Market, admire the beauty of the Christchurch Botanic Gardens or hop onboard a vintage tram and see the popular landmarks. After a day of exploration, return to your hotel to savour local flavours at The Square Restaurant and pair them with refreshing drinks from the bar.",
          "image": "https://images.luxuryescapes.com/mp459ttd2912dvbtkl2r",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Christchurch",
            "addressCountry": "New Zealand"
          },
          "priceRange": "$91",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 91,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/christchurch"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "The many charms of the Garden City are yours to enjoy from the stylish Rydges Latimer Christchurch. Surrounded by the lush gardens of Latimer Square, this modern sanctuary boasts one of the best addresses in the city, a stone’s throw from the iconic Cardboard Cathedral and funky bars, art galleries and fine-dining restaurants, and a leisurely stroll from the Botanic Gardens and Canterbury Cathedral. Make use of the onsite fitness centre and premium steakhouse, Bloody Mary’s - one of the city’s most-loved restaurants.",
          "image": "https://images.luxuryescapes.com/7ke9xuxlbzodpasfzyq",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Christchurch",
            "addressCountry": "New Zealand"
          },
          "priceRange": "$76",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 76,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/christchurch"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Take a South Island city escape to Crowne Plaza Christchurch, masterfully positioned at the centre of one of New Zealand’s funkiest cities. This stylish base overlooks the historic fountains of Victoria Square and the gentle waters of the Avon River, and the is the perfect spot to discover the Garden City's vast wealth of trendy bars, refined restaurants, cool cafés and vivid street art. After a day exploring the city’s many treasures, retreat to Market Place Restaurant and Bar for exquisite plates backed entirely by local butchers, fishmongers and growers, or head to the Cafe 1851 for a coffee or Social Wine Bar for sauvignon blanc and sensational cocktails.",
          "image": "https://images.luxuryescapes.com/od5xt9s0l5cuisblm6",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Christchurch",
            "addressCountry": "New Zealand"
          },
          "priceRange": "$83",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 83,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/christchurch"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Step into lakeside luxury with a tranquil stay on the banks of Lake Kaikainui, right outside of Christchurch. With the perfect blend of outdoor living and proximity to city comforts, you can tee off at the onsite golf course one day and discover the natural beauty and innovative urban design of Christchurch the next. Indulge in local flavours and mountain views at Lume Restaurant or a casual cocktail at The Sprig Bar and Cafe.",
          "image": "https://images.luxuryescapes.com/6i4duw32lmie88j732mi",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Christchurch",
            "addressCountry": "New Zealand"
          },
          "priceRange": "$85",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 85,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/christchurch"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the secrets of the Garden City at Christchurch's stylish Hotel Montreal, which combines the best of European style with contemporary design. Recognised for its five-star comforts, this suite-only hotel invites you to experience a new meaning of laidback luxury, with stylish and self-contained havens that offer everything you need for a comfortable escape, including a kitchenette, expansive wardrobe area and inviting lounge seating. The fun polo-inspired theme won’t go unnoticed, with odes to the sport are represented in artwork around the hotel, along with a croquet set you can borrow. Your stay, right in the heart of this vibrant city, is only moments from Hagley Park - 165 hectares of wide-open spaces and woodlands. From Hotel Montreal, take a short walk to board one of the beautifully restored trams and enjoy a 17-stop loop, departing every 15 minutes, taking in a host of city highlights including Cathedral Square and New Regent St.",
          "image": "https://images.luxuryescapes.com/6s4a9rs1kx4i1ofog1q",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Christchurch",
            "addressCountry": "New Zealand"
          },
          "priceRange": "$153",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 153,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/christchurch"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 6,
    "bestRating": "5",
    "worstRating": "1"
  }
