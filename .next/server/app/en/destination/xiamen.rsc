  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Xiamen",
  "description": "Discover the best hotels in Xiamen, China. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "China"
  },
  "url": "https://mondoexplora.com/en/destination/xiamen",
  "image": "https://images.luxuryescapes.com/n70t1ho958lj8an2yzsr",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Xiamen",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Enjoy the bustling port city of Xiamen from a luxurious base, perfectly positioned in the heart of this walkable city. This five-star retreat offers sleek facilities including a state-of-the-art fitness centre and a rooftop pool offering panoramic city views. Savour local and international cuisine at the hotel's market-to-table restaurant, or enjoy a drink at the stylish wine bar. Beyond the hotel, explore the bustling Zhongshan Road, brimming with shops and eateries, or visit the historic Gulangyu Island, a UNESCO World Heritage site.",
          "image": "https://images.luxuryescapes.com/n70t1ho958lj8an2yzsr",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Xiamen",
            "addressCountry": "China"
          },
          "priceRange": "$131",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 131,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/xiamen"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the charm of Xiamen at this sophisticated urban retreat, located by the picturesque Wuyuan Bay. Positioned in the Wuyuanwan business district of Huli, this hotel is the perfect base to experience the city’s island allure and cosmopolitan buzz. Stay active with the onsite fitness centre, relax in the spacious outdoor pool and explore the nearby waterfront parks, cultural landmarks and lively markets. Satisfy your appetite with a range of international and Asian dishes at Market Café or savour authentic Cantonese cuisine at Xiang.",
          "image": "https://images.luxuryescapes.com/svmwr2zqfeze0dc8h3o",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Xiamen",
            "addressCountry": "China"
          },
          "priceRange": "$72",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 72,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/xiamen"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Escape to this oceanfront oasis on Xiamen Island, where coastal calm meets the pulse of city life. Hyatt Centric Ocean Front Xiamen places you nearby beaches and the buzzing energy of Zeng Cuo An food street, offering the perfect launchpad to explore the island’s rich synergy of culture, cuisine and natural beauty. Unwind with a dip in the infinity pool overlooking the South China Sea, or find your rhythm in the House of Music, a laid-back lounge with vinyl records and nibbles. Savour sustainably sourced Fujian cuisine and local seafood at Alley 36, then stroll to iconic landmarks like the UNESCO-listed Gulangyu Island or visit Zhongshan Road to satisfy your shopping desires.",
          "image": "https://images.luxuryescapes.com/r9l49widv8e4nc2ryvb",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Xiamen",
            "addressCountry": "China"
          },
          "priceRange": "$78",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 78,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/xiamen"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
