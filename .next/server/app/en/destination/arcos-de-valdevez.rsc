  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Arcos de Valdevez",
  "description": "Discover the best hotels in Arcos de Valdevez, Portugal. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Portugal"
  },
  "url": "https://mondoexplora.com/en/destination/arcos-de-valdevez",
  "image": "https://images.luxuryescapes.com/r4t8fgh3nkbxjfv57vdx",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Arcos de Valdevez",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Leave the hustle and bustle of the more popular Portuguese destinations behind for a relaxing break amid the picturesque country town of Arcos De Valdevez in northern Portugal, where the exquisite Ribeira Collection Hotel awaits. Experience refined elegance at this riverside retreat - a winner at the World Luxury Hotel Awards 2020 - housed in a thoughtfully renovated heritage building dating back to 1916. Facilities include a terrace overlooking the river, three bars, a beautiful spa with sauna, Turkish bath and jacuzzi, and a swimming pool that transforms from indoor to outdoor during the summer months. Embrace the laidback lifestyle of idyllic Arcos de Valdevez - a country jewel showcasing a more traditional side of Portugal, bejewelled with tiny old churches, quaint houses, verdant hills and locally run restaurants offering Portuguese and Mediterranean cuisine. It's just a 1-hour drive to the nearby coastal city of Porto, where you'll find pretty beaches, narrow cobbled streets hiding old merchants' houses, and the lavish São Francisco Church, known for its baroque interiors and ornate gilded carvings.",
          "image": "https://images.luxuryescapes.com/r4t8fgh3nkbxjfv57vdx",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Arcos de Valdevez",
            "addressCountry": "Portugal"
          },
          "priceRange": "$221",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 221,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/arcos-de-valdevez"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
