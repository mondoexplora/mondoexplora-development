      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Welcome to Crowne Plaza Dhaka Gulshan, an IHG Hotel, a sophisticated escape in the heart of Bangladesh's capital city, Dhaka. Offering a comfortable stay for both business and pleasure, the hotel features a modern design with spacious rooms. Start your day with fresh coffee and pastries at Deli cafe, before enjoying a dip at the rooftop infinity pool. Later, enjoy a mocktail at The Oasis Lounge or indulge in delicious dining at one of the hotel's onsite restaurants.",
          "image": "https://images.luxuryescapes.com/aagi85esnwi3g044yac",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Dhaka",
