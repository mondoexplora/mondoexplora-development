12:T2388,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Ibiza",
  "description": "Discover the best hotels in Ibiza, Spain. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Spain"
  },
  "url": "https://mondoexplora.com/en/destination/ibiza",
  "image": "https://images.luxuryescapes.com/idkf1de0esyesav4vtro",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Ibiza",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Pack your dancing shoes: it’s time to escape to Ibiza’s Ocean Drive Talamanca. Perched in a quiet seaside location on the sands of Talamanca Bay, this boutique design-led property sits close to all the island's hotspots, making for the perfect balance of party and peace. It’s a 30-minute walk (or five-minute taxi) to Ibiza Town and a 30-second walk to the beach, while regular buses to the mega-clubs of Pacha and Space depart right outside. Spend your days by one of three pools onsite, lazing on sunloungers and enjoying a concoction or two from the pool bar, while a DJ provides the laidback tunes. When hunger strikes, turn to the light-filled Restaurant, where Asian and Mediterranean flavours fuse for healthy dishes. Over the summer, venture to the Sky Bar, where stunning 360° views of the surrounding landscapes come standard. If you prefer dumbbells over dancing, pop into the fitness centre to work up a sweat, before finding a spot in the airy Lobby Bar for a refreshing cocktail and bite to eat.",
          "image": "https://images.luxuryescapes.com/idkf1de0esyesav4vtro",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ibiza",
            "addressCountry": "Spain"
          },
          "priceRange": "$198",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 198,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/ibiza"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Laidback luxury meets Ibiza's iconic island energy at this stylish retreat, nestled in the vibrant heart of Cala Llonga. Hyde Ibiza features three shimmering pools, seven eclectic dining venues-including Cuyo, Niko, Bungalow, Sonrojo, and Sun & Moon-and direct access to the serene sands of Cala Llonga Beach, providing the perfect balance of relaxation and adventure. Guests can indulge in creative culinary experiences, lounge by the pool with a cocktail in hand, or explore Ibiza’s renowned nightlife and cultural treasures just moments away. Whether you're seeking a sun-soaked getaway or an exciting island adventure, Hyde Ibiza delivers an effortlessly cool stay in one of Europe’s most beloved destinations.",
          "image": "https://images.luxuryescapes.com/km0y1pe9t375yfveyt9",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ibiza",
            "addressCountry": "Spain"
          },
          "priceRange": "$148",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 148,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/ibiza"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Book yourself an invite to the hottest party in town with a stay at Ocean Drive Ibiza, an Ibiza icon that boasts beautiful views of the Old Town and Mediterranean. Sitting across from Marina Botafoch, this stylish Art Deco hotel puts the best of the Balearics at your fingertips: a 10-minute walk one way and you’re on the sands of tranquil Talamanca Bay, while 10 minutes in the other direction gets you to the front door of mega-club Pacha. Ocean Drive Ibiza's classic Art Deco aesthetic takes inspiration from 1920s Miami. Each room and suite is outfitted with tones of lavender and chocolate and views of the Mediterranean or the island’s rugged mountain interior. The best seat in the house is at the rooftop lounge Sky Bar - venture to the hotel’s top level to sip on cocktails and look out to Dalt Vila (Ibiza’s Old Town) and the island of Formentera. Summer sees the bar heaving with partygoers, dancing away to tunes spun by high-profile DJs, while healthy dishes with Latin American and European influences are served in the seasonal restaurant. Come November to April, a calmer crowd calls Ocean Drive Ibiza home, opting for a relaxing and rejuvenating break in the winter sun.",
          "image": "https://images.luxuryescapes.com/urnbtccj8igwur2bld4",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ibiza",
            "addressCountry": "Spain"
          },
          "priceRange": "$130",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 130,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/ibiza"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the vibrant spirit of the Balearic with a stay at Montesol Experimental Ibiza. This bohemian retreat is ideally located in the heart of Ibiza's Old Town, a UNESCO World Heritage site, with the historic Dalt Vila and bustling Marina Botafoch on its doorstep. Savour the flavours of the Mediterranean at the hotel's acclaimed Café Montesol, unwind with a cocktail at the stylish rooftop bar or explore the island's renowned nightlife scene.",
          "image": "https://images.luxuryescapes.com/nzvnzbd8uplu4tu7urfd5",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ibiza",
            "addressCountry": "Spain"
          },
          "priceRange": "$172",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 172,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/ibiza"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "In a serene pocket along Ibiza's northern coast, discover a place where luxury and conscious travel meet - Six Senses Ibiza, perched overlooking the crystal-clear Xarraca Bay. Farm-to-table practices can be found at the Beach Caves, a venue built into the rock face overlooking the ocean, where exquisite meals, epic sunsets and live music await. For a treasured tipple, visit Ibiza 500, the onsite wine cellar where master sommeliers have handpicked the best drops from the verdant Ibiza soil for you to sample. When you've had your fill, hide away in wellness center - spanning 1,200 square metres - that features the RoseBar longevity lounge, steam room, hammam, a state-of-the-art fitness area and seafront yoga deck.",
          "image": "https://images.luxuryescapes.com/yoly3ctf7l6u1jl6rdu",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Ibiza",
            "addressCountry": "Spain"
          },
          "priceRange": "$650",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 650,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/ibiza"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 5,
    "bestRating": "5",
    "worstRating": "1"
  }
}6:["$","main",null,{"className":"min-h-screen","children":[["$","$L11",null,{"pageType":"destination","destination":"Ibiza","country":"Spain","hotelCount":5,"minPrice":130}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$12"}}],"$L13","$L14","$L15"]}]
