12:T34c5,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Florida",
  "description": "Discover the best hotels in Florida, United States. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United States"
  },
  "url": "https://mondoexplora.com/en/destination/florida",
  "image": "https://images.luxuryescapes.com/u1siuryqi87tz1yr2ec",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Florida",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "A sophisticated seasidfe sojourn awaits at The Seagate Hotel & Spa, the only resort in Delray Beach, Florida, offering exclusive access to a pristine private beach. This luxury retreat claims a prime position just steps from the sparkling shoreline and the vibrant Atlantic Avenue, brimming with eclectic boutiques, art galleries, and gourmet dining. Practice your swing at the resort's manicured 18-hole golf course, enjoy a lively game of tennis on the Har-Tru courts, or splash around in the saltwater swimming pool at the nautically decorated beach club. When you're ready to relax, retreat to your private coastal haven, unwind in the world-class spa with a massage, skin or body treatment, or sip cocktails by the pool, or take advantage of the aquatic interiors and exceptionally delicious menu of Atlantic Grille.",
          "image": "https://images.luxuryescapes.com/u1siuryqi87tz1yr2ec",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Florida",
            "addressCountry": "United States"
          },
          "priceRange": "$284",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 284,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/florida"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Steps away from the vibrant shoreline of Miami Beach, find a comforting space to rest and relax at Kimpton Angler's South Beach, an IHG Hotel. Bask in panoramic views at the rooftop pool, indulge in tailored treatments at the tranquil in-house spa, or sip the day away with a herb-infused craft gin cocktail at the ultra-cool Minnow Bar. Nourish your body with a fresh seafood feast at the delectable Seawell Fish N’ Oyster, or nibble on one of the chef’s small bites poolside at Always June.",
          "image": "https://images.luxuryescapes.com/pllk8cc2s8apolp2t0na",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Florida",
            "addressCountry": "United States"
          },
          "priceRange": "$154",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 154,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/florida"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Unwind in tropical paradise at this inviting bayside retreat, located on a 330-acre wildlife preserve on Florida's Captiva Island. Just a stone's throw from the pristine white sands of the Gulf of Mexico, this beachfront oasis offers a wealth of activities for adventure and nature lovers alike, from water sports and fishing to cycling and nature walks. Dine on fresh seafood at Redfish Grill, or enjoy a casual meal at the poolside Scoops and Slices. Explore the island's charming boutiques and art galleries, or take a short drive to the J.N. \\\"Ding\\\" Darling National Wildlife Refuge. With a shiny spa, waterpark and golf course onsite, this is the perfect escape for families of all sizes.",
          "image": "https://images.luxuryescapes.com/26fkl8vk4clbei2byni",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Florida",
            "addressCountry": "United States"
          },
          "priceRange": "$272",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 272,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/florida"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Slow things down with a laidback, secluded escape to the ever-sunny Florida Keys at Hawks Cay Resort, where guests are invited to kick back and relax on the private island of Duck Key. Comfortable rooms and self-contained villas create a home-away-from-home experience, but with the number of activities available, you'll be raring to stay outside all day. Spend your time hopping between the five pools and lagoons, snorkelling in turquoise waters, spotting dolphins or paddling to neighbouring islands. Kids are spoilt for choice with specialised activities: there's a pirate ship pool with a water slide, basketball court, putt-putt golf course, resident mermaid and much more. When hunger strikes, there are six onsite dining venues to choose from, including a poolside tiki grill bar for colourful cocktails and fresh salads.",
          "image": "https://images.luxuryescapes.com/tdtsgjze1oytb17zdf4g",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Florida",
            "addressCountry": "United States"
          },
          "priceRange": "$254",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 254,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/florida"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "A sophisticated Floridian sojourn awaits at this lavish seaside retreat, located on the shores of the pristine Atlantic Beach. One Ocean Resort & Spa claims a prime position just steps from the sparkling shoreline and the vibrant Beaches Town Centre, brimming with eclectic boutiques, art galleries, and gourmet dining. Enjoy the freshest seafood at the upscale Azurea restaurant, or indulge in a rejuvenating treatment at the world-class spa. Explore the nearby Kathryn Abbey Hanna Park, renowned for its scenic trails and freshwater lake, or take a short drive to Jacksonville for a wealth of cultural attractions. The resort also offers a state-of-the-art fitness centre and an outdoor pool overlooking the Atlantic Ocean.",
          "image": "https://images.luxuryescapes.com/dssecaycu2x2thk7pr",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Florida",
            "addressCountry": "United States"
          },
          "priceRange": "$160",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 160,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/florida"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "The warm climate, glorious golden beaches and sapphire waters of Florida’s Gulf Coast beckon - and you are invited to stay at the luxurious Naples Grande Beach Resort. This breathtaking, 23-acre beachfront resort offers a delightful taste of what southern elegance in a lush tropical setting. Couples will love the resort’s modern rooms and stylish spa, while families can make the most of the resort facilities, including three outdoor pools, a thrilling waterslide and private beach. If you can tear yourself away from the exceptional restaurants and bars, 18-hole championship golf course and tournament-grade tennis courts, you'll find yourself perfectly located to explore the UNESCO World Heritage-listed Everglades National Park, a Florida icon, and perhaps spot some of its resident alligators and manatees.",
          "image": "https://images.luxuryescapes.com/djjtwdhnmegutg9r9n8",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Florida",
            "addressCountry": "United States"
          },
          "priceRange": "$156",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 156,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/florida"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Entertainment and activities for all ages are aplenty at this upscale Orlando retreat spread across 800 acres of lush palms and sparkling waterways. With two championship golf courses and a sports field complex you can enjoy tennis, basketball, golf and more, while a luxe spa and two shimmering pools allow for ultimate relaxation. Sample an endless range of dining and drinking options with ten onsite bars and restaurants before venturing just a short drive from the resort to experience the magic of Walt Disney World or Universal Studios with the little ones.",
          "image": "https://images.luxuryescapes.com/456z8vcgtsf265d8zlpa",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Florida",
            "addressCountry": "United States"
          },
          "priceRange": "$195",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 195,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/florida"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover oceanfront relaxation at this sprawling oasis, tucked away in Florida's famed Fernandina Beach on the vibrant Amelia Island. This stunning resort is home to a private beach, a nature-inspired spa, three lush golf courses, tennis courts and tempts with as many as ten onsite restaurants serving prime steaks, fresh seafood, surf-inspired pizzas and Floribbean delights. Overlooking the turquoise waters of the Atltanic Ocean, the expansive resort offers an idyllic tropical retreat, perfect for both family fun as well rekindling the romance. Dive into Northeast Florida's largest poolscape, enjoy the nautical-themed splash park, unwind in the adults-only infinity pool, and savor artisanal tacos and ice-cool drinks. With endless activities like tennis, watersports, trendy shopping, and beach exploration, get ready for an island adventure!",
          "image": "https://images.luxuryescapes.com/77ovjgljvdt7dzbqooyw",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Florida",
            "addressCountry": "United States"
          },
          "priceRange": "$242",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 242,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/florida"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 8,
    "bestRating": "5",
    "worstRating": "1"
  }
