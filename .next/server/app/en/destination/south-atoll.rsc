12:Tf21,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "South Atoll",
  "description": "Discover the best hotels in South Atoll, Maldives. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Maldives"
  },
  "url": "https://mondoexplora.com/en/destination/south-atoll",
  "image": "https://images.luxuryescapes.com/tj97yo7ieuytdm5ipe85",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in South Atoll",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Leave it all behind for the postcard-perfect beauty of the Maldives, staying in five-star luxury at LUX* South Ari Atoll - a drop in the ocean just a 25-minute seaplane ride from Malé. Winner of a Condé Nast Traveller Readers Choice award 2020, this dreamy resort is the setting for a once-in-a-lifetime Maldives escape. Do as much or as little as you like in this island paradise. Relax beside two glittering infinity pools, taste your way around eight eateries and five bars - offering everything from sushi to island-roasted coffee - enjoy music and drinks at Beach Rouge beach club and restaurant, partake in yoga beneath the palms, catch a movie under the stars at Cinema Paradiso or try your hand at watersports. Use the onsite 5-star PADI dive centre to discover the colourful underwater world, with 50 dive sites nearby waiting to be explored, brimming with wildlife from sea turtles to dolphins and whale sharks.",
          "image": "https://images.luxuryescapes.com/tj97yo7ieuytdm5ipe85",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "South Atoll",
            "addressCountry": "Maldives"
          },
          "priceRange": "$250",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 250,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/south-atoll"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in the epitome of five-star luxury at Anantara Dhigu Maldives Resort, a tropical secluded island escape over the magnificent and sparkling Indian Ocean. Perfect for a relaxed family or small group getaway, dive, surf and snorkel in some of the world’s most incredible clear blue waters. Enjoy relaxation beyond all bounds while exploring the pristine coastline, wading in the infinity pool, receiving a tailored beachside spa service or indulging in mouth-watering dining.",
          "image": "https://images.luxuryescapes.com/m09iv1qixriou5r85k",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "South Atoll",
            "addressCountry": "Maldives"
          },
          "priceRange": "$882",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 882,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/south-atoll"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
