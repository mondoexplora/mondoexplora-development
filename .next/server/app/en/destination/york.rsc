12:Teb2,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "York",
  "description": "Discover the best hotels in York, United Kingdom. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United Kingdom"
  },
  "url": "https://mondoexplora.com/en/destination/york",
  "image": "https://images.luxuryescapes.com/d0y28jf81pszxvoptfpb",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in York",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "You'll be immediately enchanted by the English charms of No.1, York within moments of arrival. Housed within a Grade II Listed Regency townhouse of regal proportions, the stunning hotel features dreamy windows, sky-high ceilings and a central sweeping staircase. The exterior is draped in winding ivy and the light from the twinkling lanterns inside and beams outside, adding to the allure and magical atmosphere. Retreat to the hotel bar each day to toast your explorations at The Rhubard Bar, feast on flavour at the Pearly Cow or head to the onsite spa for bespoke treatments. When you're ready to explore, this quaint and historic townhouse is perched just minutes from York Minster in Bootham - a vibrant and stylish shopping and entertainment district. It’s also perfectly placed for a day trip to the stunning Yorkshire Dales National Park and other nearby historical sites.",
          "image": "https://images.luxuryescapes.com/d0y28jf81pszxvoptfpb",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "York",
            "addressCountry": "United Kingdom"
          },
          "priceRange": "$133",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 133,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/york"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Enjoy a royal stay at The Grand York, formerly the Edwardian headquarters of the wealthy North Eastern Railway Company. Incredible facilities at this five-star hotel include an award-winning cookery school, traditional afternoon tea at the Rise Restaurant and the 1906 Bar (be sure to order a cocktail while you're here). Better yet, the hotel's central location means it is only a short amble to the main shopping streets and the Medieval tower walls.",
          "image": "https://images.luxuryescapes.com/qm0mlpbkixbtrb84tb",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "York",
            "addressCountry": "United Kingdom"
          },
          "priceRange": "$254",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 254,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/york"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
