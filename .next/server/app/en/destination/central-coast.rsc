11:Te5c,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Central Coast",
  "description": "Discover the best hotels in Central Coast, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/central-coast",
  "image": "https://images.luxuryescapes.com/2ixvk38098vjo4pzpdk6",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Central Coast",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Central Coast escapes don’t get much sweeter than this. Kick back and enjoy the region’s abundance of beaches, restaurants and bars with a stay at Encore by Mingara, conveniently located just a short drive from the tranquil shores of Tuggerah Lake and the spectacular Wyrrabalong National Park. Check out local highlights including ocean pools, weekend markets, walking and cycling tracks; before your adventures, fuel up with a la carte breakfast at The Roasted Berry, then return to a menu of modern Australian favourites at Hadley's or Australian-Chinese fare at Ming Dragon. Access state-of-the-art fitness centre One by Mingara, including a heated indoor pool, athletic track and group fitness classes including yoga, pilates and more.",
          "image": "https://images.luxuryescapes.com/2ixvk38098vjo4pzpdk6",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Central Coast",
            "addressCountry": "Australia"
          },
          "priceRange": "$199",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 199,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/central-coast"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Escape from Sydney to a coastal haven just 90 minutes away, soaking up sun at The Beachcomber Hotel & Resort. Slip into holiday mode at this bright and vibrant waterfront locale that rivals a Hamptons holiday home. Take in sparkling views of Budgewoi Lake from the Club Cyan bar or one of the many cabanas surrounding the heated deckside pool, and indulge your way all day at The Beachie Pub, Bar & Grill which features a menu of elevated pub classics.",
          "image": "https://images.luxuryescapes.com/h3ag91ow8ecxt3935ji",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Central Coast",
            "addressCountry": "Australia"
          },
          "priceRange": "$111",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 111,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/central-coast"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
