12:T119f,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Puerto Vallarta",
  "description": "Discover the best hotels in Puerto Vallarta, Mexico. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Mexico"
  },
  "url": "https://mondoexplora.com/en/destination/puerto-vallarta",
  "image": "https://images.luxuryescapes.com/ojva3k03xpn7tuqwf1u",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Puerto Vallarta",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Set on a dreamy stretch of coastline on Mexico's Riviera Nayarit is the five-star One&Only Mandarina, a secluded resort overlooking the Pacific Ocean. Be wined and dined at three celebrity chef-led restaurants, or enjoy local, sustainably made tipples at The Treetop bar and savour each captivating sunset. The One&Only Spa is heaven on Earth, serving up a range of treatments using Tata Harper products designed to pamper you into bliss. A dedicated butler will take care of everything during your stay, leaving you free to enjoy the world-class facilities, including six swimming pools, a pristine beach with crystal-clear swimmable water and immersive nature activities. Did we mention the resort's beach club? This oceanfront haven invites you to pad barefoot from your cabana to the warm waters of the ocean, feast on fresh oysters and sip on expertly-mixed drinks in the sunshine.",
          "image": "https://images.luxuryescapes.com/ojva3k03xpn7tuqwf1u",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Puerto Vallarta",
            "addressCountry": "Mexico"
          },
          "priceRange": "$851",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 851,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/puerto-vallarta"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "On the northern edge of Banderas Bay near the historic centre of Puerto Vallarta lies a secluded gem that encapsulates the essence of Mexico - the luxurious five-star Grand Velas Riviera Nayarit. Designed with grandiose architecture and surrounded by stunning tropical landscapes, the award-winning resort features six restaurants showcasing the best culinary delights from around the world. Satisfy your palate with all-inclusive dining and drinks, ranging from traditional Mexican cuisine, Asian fusion delights and flavourful Italian and Mediterranean dishes to classic French simplicity. The stunning azure waters and sparkling white sand beaches are as alluring as the hotel’s sparkling infinity pool and relaxing jacuzzi. Dive off the beautiful coast and spend the day snorkelling, kayak through emerald waters to majestic waterfalls, stroll along Puerto Vallarta’s boardwalk as you take in the sweeping ocean views or visit one of the many nearby golf courses that have made Puerto Vallarta a golf lovers’ paradise. Then, head back to the hotel for a serene holistic treatment at the blissful SE Spa and poolside sunset cocktails.",
          "image": "https://images.luxuryescapes.com/tsldvyj3nw1egtp8eup",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Puerto Vallarta",
            "addressCountry": "Mexico"
          },
          "priceRange": "$874",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 874,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/puerto-vallarta"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
