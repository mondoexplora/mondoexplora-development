12:Ta3c,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Teruel",
  "description": "Discover the best hotels in Teruel, Spain. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Spain"
  },
  "url": "https://mondoexplora.com/en/destination/teruel",
  "image": "https://images.luxuryescapes.com/z0a8xhasz56q085gva",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Teruel",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Right in the heart of Spain's Monroyo countryside, surrounded by rolling hills dotted by vineyards and olive trees, lies the luxurious Torre del Marqués, part of the Small Luxury Hotels of the World collection. Promising guests a serene escape from the hustle and bustle of busy Spanish cities, Torre del Marqués in Teruel sits amid one of the country’s most untouched rural regions, two hours' drive east of Barcelona. Housed in a beautifully restored 18th-century tower, overlooking the verdant hills, the hotel offers a collection of just 18 minimalist rooms - making this a hidden retreat for those in the know, surrounded by nature. Contemporary, elegant and eco-conscious, the hotel boasts luxurious rooms and exquisite facilities, including a sauna and jacuzzi, and a light-filled restaurant offering Mediterranean fare crafted only with local, organic produce. When you can tear yourself away from the hotel's blissful swimming pool, the Spanish countryside is yours to explore: from olive oil tasting to horse riding, the possibilities are endless in beautiful Monroyo.",
          "image": "https://images.luxuryescapes.com/z0a8xhasz56q085gva",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Teruel",
            "addressCountry": "Spain"
          },
          "priceRange": "$293",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 293,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/teruel"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
