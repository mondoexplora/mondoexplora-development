11:T1eda,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Dallas",
  "description": "Discover the best hotels in Dallas, United States. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United States"
  },
  "url": "https://mondoexplora.com/en/destination/dallas",
  "image": "https://images.luxuryescapes.com/q0vt2yju32kf2642bn0q",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Dallas",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in the Southern elegance of this exquisite 1920s Dallas estate, transformed into an ultra-luxe sanctuary. Nestled within Uptown’s leafy enclave, Rosewood Mansion on Turtle Creek effortlessly marries the world-class sophistication of the Rosewood brand with timeless Texan grandeur. At The Mansion Restaurant, savour exquisite French fine dining elevated by bold Dallas flair and heartfelt Southern hospitality. Retreat to The Mansion Bar, an iconic Dallas institution, where evocative Texas landscapes, equestrian motifs and rich cognac-hued leather walls set the stage for signature tequila cocktails and impeccable service. For a timeless ritual, enjoy high tea in the chandelier-lit Mansion Library, then unwind with a float in the outdoor pool before a bespoke signature massage.",
          "image": "https://images.luxuryescapes.com/q0vt2yju32kf2642bn0q",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Dallas",
            "addressCountry": "United States"
          },
          "priceRange": "$899",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 899,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/dallas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Enjoy the very best of Dallas with a stay at Crowne Plaza Dallas Love Field - Med Area, an IHG Hotel, just minutes from the city's vibrant downtown. Indulge in delicious Texas-style cuisine at Bristol Bar & Grill, or unwind with a refreshing dip in the hotel's sparkling indoor pool. The hotel's proximity to the Dallas World Aquarium, Perot Museum of Nature and Science, and the renowned Dallas Museum of Art offers endless exploration opportunities.",
          "image": "https://images.luxuryescapes.com/j56ir1g0cjngnrlxgqn",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Dallas",
            "addressCountry": "United States"
          },
          "priceRange": "$79",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 79,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/dallas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Pristine modernity in the heart of Dallas’ thriving cultural centre, Kimpton Pittman Hotel, an IHG Hotel provides a perfect amalgamation of classic charm and contemporary design to provide top-tier relaxation. Admire the collection of modern art and sleek furnishings that decorate the expansive spaces as you enjoy a crisp beer or a creative cocktail on Deep End’s poolside open-air deck or relax in the plush confines of Elm & Good with a hearty, tavern-inspired feed.",
          "image": "https://images.luxuryescapes.com/bkcjzvuapongzm8h8ljd",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Dallas",
            "addressCountry": "United States"
          },
          "priceRange": "$167",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 167,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/dallas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the grandeur of Texas with a modern, sleek stay in downtown Dallas. Located adjacent to the Dallas Convention Center, this hotel offers a gateway to the city's vibrant arts and culture scene, including the Dallas Museum of Art and the Perot Museum of Nature and Science. Satisfy your palate at one of the plethora of onsite dining options, with dining options at Restaurants on Lamar at your fingertips: from souther-style favourites at Texas Spice to the sophisticated steakhouse, Bob's Steak & Chop House. After a day of exploration, retreat to the Mokara Spa for a rejuvenating treatment or enjoy a drink at the The Owners Box sports bar.",
          "image": "https://images.luxuryescapes.com/7fxv0k3ovd7gsgjuqam",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Dallas",
            "addressCountry": "United States"
          },
          "priceRange": "$292",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 292,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/dallas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Positioned just moments from the Convention Centre, Crowne Plaza Dallas Downtown, an IHG Hotel offers guests the perfect stay in the heart of one of Texas’s most vibrant cities. You’ll be surrounded by plenty of things to see and do, with Dallas World Aquarium, Dallas Zoo and beloved sports stadium American Airlines Centre all within walking distance - return to the hotel's onsite Thrive Restaurant for upscale New American plates in a laidback setting.",
          "image": "https://images.luxuryescapes.com/fp7x5izs20xj8jl72dg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Dallas",
            "addressCountry": "United States"
          },
          "priceRange": "$71",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 71,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/dallas"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 5,
    "bestRating": "5",
    "worstRating": "1"
  }
