12:Ted3,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Masai Mara",
  "description": "Discover the best hotels in Masai Mara, Kenya. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Kenya"
  },
  "url": "https://mondoexplora.com/en/destination/masai-mara",
  "image": "https://images.luxuryescapes.com/q9ck0a9kk6m654hn6mvf",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Masai Mara",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Nestled where the Aitong Hills meet the Mara River in the Olchoro Oirowua Conservancy, this legendary safari retreat puts you front and centre of nature's greatest show. From 38 exquisitely tented rooms, showcasing traditional Maasai style and heritage safari elegance, you'll witness hippo-filled river views and endless wildlife drama right outside your tent flaps. Beyond the incredible game drives and scenic sundowner cocktails, this deluxe retreat serves up bush dining experiences and balloon safaris that'll leave you speechless. The palm-fringed outdoor pool invites blissful soaks and poolside lounging, while a serene onsite spa beckons with indulgent treatments at any time of day.",
          "image": "https://images.luxuryescapes.com/q9ck0a9kk6m654hn6mvf",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Masai Mara",
            "addressCountry": "Kenya"
          },
          "priceRange": "$766",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 766,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/masai-mara"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Wild safari dreams come true at the Olare Mara Kempinski Masai Mara. The five-star property is nestled at the heart of its own private conservancy and promises unrivalled luxury entwined with a classic under-canvas safari experience. Just 12 opulent safari tents - surrounded by golden savannah - offer an intimate experience, while a central lounge and dining area, a tented bar and a shaded swimming pool are the perfect public spaces to come together and share tales of a day on safari. Each evening, fall asleep up to the distant sounds of whooping hyenas, trumpeting elephants and the roar from the resident pride of lions from luxury canvas-style tents.",
          "image": "https://images.luxuryescapes.com/qkwsswm84imk4jttlk3l",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Masai Mara",
            "addressCountry": "Kenya"
          },
          "priceRange": "$1536",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 1536,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/masai-mara"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
