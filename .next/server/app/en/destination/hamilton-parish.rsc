12:Ta12,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Hamilton Parish",
  "description": "Discover the best hotels in Hamilton Parish, Bermuda. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Bermuda"
  },
  "url": "https://mondoexplora.com/en/destination/hamilton-parish",
  "image": "https://images.luxuryescapes.com/py5j5oi6vo5m8jb61ae",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Hamilton Parish",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Blissful island dreams come true at Grotto Bay Beach Resort & Spa, where balmy nights, a turquoise sea fringed by stunning pink sand and subterranean cave wonders await. Ranked in the top 10% of resorts worldwide by Tripadvisor, this top-rated property offers fabulous facilities and incredible natural wonders. A private slice of cotton-candy beach is yours to enjoy: roll out a towel for some sunbathing, splash about in the shallows or go paddleboarding and kayaking. You’re spoilt for choice when it comes to dining - three incredible onsite restaurants and a rum bar serve up mouthwatering dishes and creative cocktails. When you’re looking for the ultimate indulgence, head to the Natura Cave Spa, an underground cave spa where you can enjoy pampering treatments surrounded by ancient stalactites and stalagmites. What's more, a tennis court, Kids' Club, state-of-the-art fitness centre and ample diving and snorkelling sites will make this escape truly unforgettable.",
          "image": "https://images.luxuryescapes.com/py5j5oi6vo5m8jb61ae",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hamilton Parish",
            "addressCountry": "Bermuda"
          },
          "priceRange": "$304",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 304,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hamilton-parish"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
