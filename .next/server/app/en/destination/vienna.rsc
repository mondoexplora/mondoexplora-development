13:T2365,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Vienna",
  "description": "Discover the best hotels in Vienna, Austria. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Austria"
  },
  "url": "https://mondoexplora.com/en/destination/vienna",
  "image": "https://images.luxuryescapes.com/t40rc7mv2k9kea2ed2kd",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Vienna",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Visit the motherland of musical masterpieces and coffee-house culture when you stay at the five-star InterContinental Vienna, an IHG Hotel, placed moments from iconic sights like the world-renowned Vienna State Opera and the stylish shopping district Kaerntner Strasse. Beyond the crystal chandeliers and classic décor are the exceptional Intermezzo Bar - a sultry cocktail den - and the eclectic Parlor restaurant, serving up Austrian and international specialties.",
          "image": "https://images.luxuryescapes.com/t40rc7mv2k9kea2ed2kd",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vienna",
            "addressCountry": "Austria"
          },
          "priceRange": "$179",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 179,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/vienna"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Welcome to the elegant and exquisite Grand Hotel Wien, an IHG Hotel, nestled in the heart of vibrant Vienna. With a history dating back to 1870, this impressive gem has been lovingly restored to include 205 rooms and suites, seven restaurants and bars, a state-of-the-art spa and a spectacular rooftop summer terrace. Just moments away from the world-renowned Vienna State Opera and the shopping mile of Kaerntner Strasse, it couldn't be better placed for a relaxing city break.",
          "image": "https://images.luxuryescapes.com/0n986njikgr6yrsh25ae",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vienna",
            "addressCountry": "Austria"
          },
          "priceRange": "$315",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 315,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/vienna"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Step right up to Vienna's best - including its world-famous museums - at this decidedly offbeat city hideaway, located just steps from many of the city's most renowned sights. Find yourself a nearby cafe to sample a Viennese coffee or spend the day exploring the wonders of the Kunsthistorisches Museum Wien. After days of exploration, sweat it out in the sauna, then refuel with rustic Italin antipasti at RIBELLI and tap-pours at beer garden KVETCH. Later, hop on a hotel bike to chase Vienna’s baroque backstreets or rise above it all at the rooftop bar DACHBODEN, where live music, local wines and skyline views converge to create unforgettable nights.",
          "image": "https://images.luxuryescapes.com/hlkwy9e8mao2zxqucjh",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vienna",
            "addressCountry": "Austria"
          },
          "priceRange": "$110",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 110,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/vienna"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Vienna's buzzing city centre is just a stone's throw from the ultra-stylish Hotel Indigo Vienna - Naschmarkt, an IHG Hotel. Discover a rooftop garden, a leafy courtyard and a terrace, all within walking distance from the state opera and the museums on the Ringstrasse. Hidden among the hotel's secret gardens is the celebrated Pigment restaurant, a must-try venue in Vienna that prides itself on its simple, locally sourced dishes presented in a new and innovative way.",
          "image": "https://images.luxuryescapes.com/o4rzcc0l7qnhi7ixxo0b",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vienna",
            "addressCountry": "Austria"
          },
          "priceRange": "$115",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 115,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/vienna"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Step into refined Viennese elegance just steps from the world-renowned Musikverein and the grand Vienna State Opera. Each artfully designed room at Hotel Am Konzerthaus Vienna - MGallery pays homage to the city’s rich musical heritage, with bespoke furnishings and curated artwork reflecting the creative spirit of Austria’s capital. Begin your day with a gourmet breakfast at APRON, the hotel’s Michelin-starred restaurant, or stroll to the Belvedere Palace to admire Klimt’s masterpieces. In the evening, enjoy expertly crafted cocktails at the chic onsite bar before exploring the vibrant Naschmarkt’s eclectic food stalls and artisan shops.",
          "image": "https://images.luxuryescapes.com/zvua4rtsv6c9o2oxia6n",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vienna",
            "addressCountry": "Austria"
          },
          "priceRange": "$160",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 160,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/vienna"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "For a delightful escape blending modernity and Viennese charm, plus a touch of whimsy, head to voco Vienna Prater, an IHG Hotel, an urban stay located just a five-minute drive from one of Europe's oldest amusement parks - Prater. After a day spent atop the Ferris wheel or admiring the perfectly preserved attractions of Prater, head back to the hotel for a classic cocktail at the onsite Bluebird Bar or a hearty meal at Vienna Vibe restaurant.",
          "image": "https://images.luxuryescapes.com/s1agq9hu8njqik6q3quh",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Vienna",
            "addressCountry": "Austria"
          },
          "priceRange": "$95",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 95,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/vienna"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 6,
    "bestRating": "5",
    "worstRating": "1"
  }
