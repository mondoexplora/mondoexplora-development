13:T8e2,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Lake Louise",
  "description": "Discover the best hotels in Lake Louise, Canada. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Canada"
  },
  "url": "https://mondoexplora.com/en/destination/lake-louise",
  "image": "https://images.luxuryescapes.com/zgny6ml988jq6mwcw2k8",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Lake Louise",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the majesty of the Canadian Rockies from this iconic five-star haven on the shores of Lake Louise. This grand chateau-style hotel is a gateway to the awe-inspiring landscapes of Banff National Park, a UNESCO World Heritage site. Step outside and you're on the doorstep of world-class skiing, scenic hiking trails and lake activities. Indulge in the hotel's high-end amenities, including a state-of-the-art fitness centre and an inviting indoor pool. Savour locally sourced cuisine at one of the six onsite eateries, from fine dining at the Fairview to hearty comfort food at the Lakeview Lounge and unwind with indulgent mountainside treatments at The Spa at Fairmont Chateau Lake Louise.",
          "image": "https://images.luxuryescapes.com/zgny6ml988jq6mwcw2k8",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Lake Louise",
            "addressCountry": "Canada"
          },
          "priceRange": "$383",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 383,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/lake-louise"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
