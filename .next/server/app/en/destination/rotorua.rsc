12:T14e0,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Rotorua",
  "description": "Discover the best hotels in Rotorua, New Zealand. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "New Zealand"
  },
  "url": "https://mondoexplora.com/en/destination/rotorua",
  "image": "https://images.luxuryescapes.com/pts5c4egv3pghd9faj6",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Rotorua",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Get a taste for life by the water with a relaxing, romantic escape to Koura Lodge - a boutique bed and breakfast on the edge of Lake Rotorua. With only nine rooms - all with 180-degree lake views - an outdoor hot tub and kayaks available for guests, this intimate lodge transports you to the heart of a natural wonderland, yet it’s just a five-minute drive from the town centre. Unwind in the peaceful surrounds or ignite your sense of curiosity and explore this idyllic destination. Rotorua is a place where fascinating Māori culture, geothermal activity, adrenaline-fuelled adventure and wellness come together to create an experience to remember.",
          "image": "https://images.luxuryescapes.com/pts5c4egv3pghd9faj6",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Rotorua",
            "addressCountry": "New Zealand"
          },
          "priceRange": "$254",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 254,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/rotorua"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Time to check into pure comfort with Lake Rotorua practically in your backyard, where geothermal wonders let the earth breathe and nature paints its masterpieces. Enjoy complimentary access to geothermal pools, bubble away in the hotel's hot tub, grab a drink on the lakeview terrace at Clarke's Bar and tuck into some tasty bites at Atlas Restaurant. At the Novotel Rotorua Lakeside, you'll find yourself at the centre of the excitement, mere steps away from the lively Eat Street with everything from steaks to ice cream. Sail down the luge at Skyline Rotorua, experience the rush of jet boating on the lake, or learn more about Māori culture and New Zealand's geothermal landscape at Te Puia.",
          "image": "https://images.luxuryescapes.com/d72ap53wxhbs9ptl5tms",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Rotorua",
            "addressCountry": "New Zealand"
          },
          "priceRange": "$91",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 91,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/rotorua"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Uncover the beauty of New Zealand's geothermal wonderland with a stay at this stylish urban sanctuary cradled in the heart of Rotorua. Be it leisure or adventure, this luxurious hotel is stamped with trademark Pullman hospitality and superbly situated for easy access to the city's top attractions, including Lake Rotorua and the Government Gardens. Spend your days exploring the nearby shooting geysers, bubbling mud, natural hot springs, lush forests and Maori cultural centres, or enjoy the vibrant atmosphere at Eat Streat. Back at your hotel, you can relax in your plush room and indulge in farm-to-table delights at Barrel & Co. Bar and Grill, while sipping on refreshing drinks.",
          "image": "https://images.luxuryescapes.com/u7f4mnrr1p9oauyn7yr",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Rotorua",
            "addressCountry": "New Zealand"
          },
          "priceRange": "$127",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 127,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/rotorua"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
