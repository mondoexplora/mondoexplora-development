  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Tanglin",
  "description": "Discover the best hotels in Tanglin, Singapore. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Singapore"
  },
  "url": "https://mondoexplora.com/en/destination/tanglin",
  "image": "https://images.luxuryescapes.com/b7nhyral4nkxczom6iwv",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Tanglin",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover Singapore's vibrant fusion of cultures, iconic sightseeing and unforgettable cuisine in signature luxury at JEN Singapore Tanglin by Shangri-La, a playful property ranked in the top 10% of hotels worldwide by Tripadvisor. Singapore is renowned for its cuisine, from street food hawker fare in Chinatown to Michelin-starred fine dining. Here, you can enjoy an authentic, mouthwatering feast without leaving your hotel. J65 serves up hot, home-style dishes alongside fresh seafood, Ah Hoi's Kitchen is all about authentic Singaporean cuisine and Rumpoles Bar is your go-to for a Singapore-inspired craft cocktail in an exclusive club-like setting. When you're not wining and dining, make use of the hotel's 24-hour gym or take a dip in the outdoor swimming pool and whirlpool. When you’re ready to explore the wonders Singapore has to offer, Orchard Road's retail heaven is just a short walk away, while the open-air food street of Chinatown, where you'll find your next great feed, is a 10-minute drive. Slightly further are the jaw-dropping garden displays of the iconic Gardens by the Bay and Marina Bay Sands.",
          "image": "https://images.luxuryescapes.com/b7nhyral4nkxczom6iwv",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Tanglin",
            "addressCountry": "Singapore"
          },
          "priceRange": "$127",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 127,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/tanglin"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
