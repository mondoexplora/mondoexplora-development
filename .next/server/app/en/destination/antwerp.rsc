13:T1346,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Antwerp",
  "description": "Discover the best hotels in Antwerp, Belgium. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Belgium"
  },
  "url": "https://mondoexplora.com/en/destination/antwerp",
  "image": "https://images.luxuryescapes.com/t11aqmf44n1ml4tacess",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Antwerp",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Tucked in the heart of Belgium's port city, Antwerp, this contemporary escape blends modern comfort with the city’s timeless Flemish charm. Just moments from the Central Station and Antwerp Zoo, it’s the perfect base for exploring the Diamond District, sampling Belgian chocolates, or admiring the city’s artistic soul. Spend your days exploring the iconic cobbled streets, stroll along the Scheldt River and discover historic squares and vibrant galleries, including the Royal Museum of Fine Arts, home to over 1000 pieces of artwork. Then, return to your sleek, self-contained studio, complete with a fully equipped kitchen for a restful evening in.",
          "image": "https://images.luxuryescapes.com/t11aqmf44n1ml4tacess",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Antwerp",
            "addressCountry": "Belgium"
          },
          "priceRange": "$78",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 78,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/antwerp"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Explore the history and jaw-dropping architecture of Belgium's artistic second city with at Crowne Plaza Antwerp, an IHG Hotel. Relaxation comes in many forms here: take a dip in the black-tiled infinity pool, treat yourself to an invigorating hammam treatment at the wellness centre, or enjoy a purifying steam in the sauna. When hunger strikes, sink into the velvet upholstery at ANNA Living & Bar for a deep dive into French and Belgian cuisine or a classic Belgian beer and light snacks.",
          "image": "https://images.luxuryescapes.com/u2itf4cyt1rc2kowuw9",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Antwerp",
            "addressCountry": "Belgium"
          },
          "priceRange": "$74",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 74,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/antwerp"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "A refined refuge conveniently located in the heart of this cosmopolitan city, Hotel Indigo Antwerp - City Centre, an IHG Hotel merges contemporary design with creature comforts. Start your day right in a stylish guestroom inspired by renowned Flemish artists before savouring a breakfast of Belgian waffles and specialty coffee at the onsite restaurant. After a day of exploring Antwerp, relish a sophisticated cocktail in the courtyard or head out to experience bohemian local bars and nightlife.",
          "image": "https://images.luxuryescapes.com/e2bl0axhzlp6fg9n144k",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Antwerp",
            "addressCountry": "Belgium"
          },
          "priceRange": "$67",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 67,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/antwerp"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
