11:T1f21,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Makkah",
  "description": "Discover the best hotels in Makkah, Saudi Arabia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Saudi Arabia"
  },
  "url": "https://mondoexplora.com/en/destination/makkah",
  "image": "https://images.luxuryescapes.com/c1ke84zdaydoxm1b4ov",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Makkah",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Embrace the spiritual heart of Saudi Arabia at this five-star Raffles retreat, ideally located in the vibrant centre of Makkah, just steps from the sacred Kaaba within Masjid Al Haram. For a moment of spiritual reflection, the hotel's prime location allows for easy access to the Grand Mosque, while the shopping delights of Abraj Al Bait Mall are just a short stroll away. After busy days of exploration retreat to the opulence of your spacious suite, adorned with rich textures and elegant furnishings or indulge in a gastronomic journey across the globe at one of the hotel's four restaurants and rejuvenate at the world-class Raffles Spa.",
          "image": "https://images.luxuryescapes.com/c1ke84zdaydoxm1b4ov",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Makkah",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$328",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 328,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/makkah"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in the cultural richness of Saudi Arabia at this modern sanctuary in the holy city, located moments away from Al Masjid Al Haram mosque. Visit the nearby Al-Salam Park for a leisurely stroll or head to the bustling local markets for an authentic Saudi shopping experience. Recharge your spirit and body at the onsite spa and refuel at one of three onsite restaurants, savouring delicious international and traditional Saudi dishes in a warm, inviting atmosphere. Need to maintain your wellness routine? The state-of-the-art fitness centre has all the equipment you need for an energising workout.",
          "image": "https://images.luxuryescapes.com/ceq823wgl3qyolstgoj",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Makkah",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$27",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 27,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/makkah"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Soak up the serene spirituality of Makkah from this sophisticated sanctuary in the iconic Abraj Al Bait complex, offering direct access to Masjid al-Haram and sweeping Kaaba views. Elegant rooms and suites are designed for quiet reflection and comfort, blending contemporary Swiss design with warm Arabian touches. Savour international and traditional flavours at Al Khairat Restaurant and unwind with a soothing tea or coffee at Masharif Tea Lounge. With the Abraj Al Bait Mall just steps away, shopping and entertainment are always within reach. Whether you're visiting for spiritual renewal or simply a peaceful retreat, this haven offers a deeply meaningful stay in the heart of Islam's holiest city.",
          "image": "https://images.luxuryescapes.com/wr72ckldw99jl8hot9",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Makkah",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$151",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 151,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/makkah"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Just across from the resplendent white marbles of Masqid al-Haram, InterContinental Dar Al Tawhid Makkah, an IHG Hotel, is a five-star property only a few steps from the Holy Kaaba and King Fahad Gate. This luxury hotel is located near the city's Islamic sites, such as Mina, Muzdalifah, Mount Arafat and Jabal al-Nour. Beyond its convenient central position, the hotel also boasts a private Prayer Hall and three elegant restaurants serving up international cuisine and traditional specialties.",
          "image": "https://images.luxuryescapes.com/w5062zm2fxmp06emxpjf",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Makkah",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$361",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 361,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/makkah"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Sun-kissed and sophisticated, a stay at voco Makkah, an IHG Hotel promises quiet and convenience in the spiritual heart of Saudi Arabia. Perfect for groups or families, the hotel's location is unbeatable - just a 10-minute drive from the sacred Masjid Al Haram and offering the perfect base to discover Makkah’s countless treasures. Enjoy voco's signature top-notch facilities, including four world-class restaurants, separated musallas and an onsite shopping mall.",
          "image": "https://images.luxuryescapes.com/xg886mem1yfnccm225",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Makkah",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$49",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 49,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/makkah"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 5,
    "bestRating": "5",
    "worstRating": "1"
  }
