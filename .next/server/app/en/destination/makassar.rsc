  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Makassar",
  "description": "Discover the best hotels in Makassar, Indonesia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "url": "https://mondoexplora.com/en/destination/makassar",
  "image": "https://images.luxuryescapes.com/shubgsiqtjj863gazd2",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Makassar",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "The charms of eastern Indonesia's largest city, Makassar, are yours to embrace from this stylish sanctuary that's ideally located in the heart of the city. Chic interiors, modern amenities and well-appointed rooms make this hotel an ideal base for exploring the best of Makassar and the South Sulawesi province. Be within easy reach of the Fort Rotterdam, a 17th-century Dutch fort, the vibrant Losari Beach and indulge in family-friendly fun at Trans Studio Mall, one of the world's largest indoor theme parks. Return to your hotel to take a refreshing dip in the sparkling outdoor pool, savour traditional Indonesian flavours at Square Kitchen and unwind with expertly crafted cocktails from the Lobby Bar to top off your Makassar escape.",
          "image": "https://images.luxuryescapes.com/shubgsiqtjj863gazd2",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Makassar",
            "addressCountry": "Indonesia"
          },
          "priceRange": "$39",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 39,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/makassar"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the vibrant energy of the Indonesian port city of Makassar on the island of South Sulawesi. Situated in the heart of the city, this modern retreat offers easy access to the bustling business district and the enticing shores of Losari Beach. Savour the rich flavours of local cuisine at the hotel's elegant Losari restaurant, or sip a refreshing drink at Toraja bar. Venture out to explore the historical Fort Rotterdam, indulge in retail therapy at the nearby Trans Studio Mall, or simply relax by the sparkling outdoor pool or treat yourself to a rejevenating treatment at the spa.",
          "image": "https://images.luxuryescapes.com/pnungwvcpos13twzsk",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Makassar",
            "addressCountry": "Indonesia"
          },
          "priceRange": "$31",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 31,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/makassar"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover your next place to crash in the heart of South Sulawesi's capital. Wake up refreshed in contemporary rooms, fuel your day with all-day dining options, or unwind with a specialty coffee or evening cocktail at The Placery. Just minutes from the city's main districts, you're perfectly positioned to experience the best of Makassar. Dive into the sparkling outdoor pool or stay on track at the state-of-the-art fitness centre. With convenient access to cultural landmarks like Fort Rotterdam and the Losari Beach waterfront nearby, this is an experience that caters to both work and leisure. Your journey through Indonesia's gateway to the east begins here.",
          "image": "https://images.luxuryescapes.com/piewprfouo9ikrlxwj5c",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Makassar",
            "addressCountry": "Indonesia"
          },
          "priceRange": "$37",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 37,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/makassar"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
