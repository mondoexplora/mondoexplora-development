12:Tc30,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Bellarine Peninsula",
  "description": "Discover the best hotels in Bellarine Peninsula, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/bellarine-peninsula",
  "image": "https://images.luxuryescapes.com/9fpchkbhtf0au12hcmw",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Bellarine Peninsula",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "An escape from everyday life beckons at Starhaven Retreat, a contemporary hideaway set amid the striking beauty of the Bellarine Peninsula with its beaches, lakes, wineries and stunning views. A short drive yet a world away from Melbourne's CBD, this award-winning property - which featured on Grand Designs Australia - overlooks tranquil Port Phillip Bay and offers guests the opportunity to curate their own escape, with a spa, cocktail lounge, 15-seat cinema with a starlit ceiling and all-suite accommodation with private ensuite bathrooms. Joining the growth to green, Starhaven Retreat enjoys Tripadvisor GreenLeaders Platinum Level certification and promotes numerous environmental initiatives among the three categories of electricity, water and recycling. From the production of energy from solar power and using water from 20,000L water tanks to using FSC Certified papers and recycling rigorously, this retreat strives for a sustainable future, without compromising on luxury. If you can tear yourself away from the comfort of your accommodation, Victoria's Bellarine Peninsula is bursting with natural delights. Stroll along pristine beaches, discover the rich history of Geelong and taste spectacular local food and wine, freshly produced by some of Australia’s most awarded makers and growers. Browse local art galleries, sample the fare of local breweries and wineries, stroll the markets and while an afternoon away to live music: it's all here on the Bellarine Peninsula.",
          "image": "https://images.luxuryescapes.com/9fpchkbhtf0au12hcmw",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bellarine Peninsula",
            "addressCountry": "Australia"
          },
          "priceRange": "$352",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 352,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/bellarine-peninsula"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
