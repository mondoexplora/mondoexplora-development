12:Te12,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Wollongong",
  "description": "Discover the best hotels in Wollongong, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/wollongong",
  "image": "https://images.luxuryescapes.com/kty8k7ij6p9fmj2bhui",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Wollongong",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Lose yourself to the laidback lifestyle and coastal beauty of Wollongong with a stay at Hotel TOTTO, a sleek retreat in the heart of this surfy town. Discover the sun-kissed beaches and mingle with the trendy locals as you stroll along the beachfront promenade, dotted with cool cafes and lush green spaces. After days spent in the ocean and evenings spent dancing in tropical style beer-gardens, treat your tastebuds to an authentic wood-fired pizza at BASTA restaurant.",
          "image": "https://images.luxuryescapes.com/kty8k7ij6p9fmj2bhui",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Wollongong",
            "addressCountry": "Australia"
          },
          "priceRange": "$88",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 88,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/wollongong"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Wake up to ocean-tinged air and the sound of waves crashing on the nearby beach at the boutique Adina Apartment Hotel Wollongong. Offering a central location in the vibrant regional city, the hotel is close to plenty of beachfront restaurants and cafés - the perfect snack stops while exploring the surrounding natural beauty. Dive into the heated swimming pool and indulge in the Jacuzzi and sauna, before heading off to see what quaint Wollongong has to offer. Immerse yourself in Buddhist and Hindu culture and architecture, head out on a day trip to the stunning Booderee National Park, or discover why Wollongong has a reputation for some of the best beaches in Australia.",
          "image": "https://images.luxuryescapes.com/hjukufmfqjf22tv5rc1k",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Wollongong",
            "addressCountry": "Australia"
          },
          "priceRange": "$125",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 125,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/wollongong"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
