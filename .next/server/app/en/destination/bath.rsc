12:T2046,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Bath",
  "description": "Discover the best hotels in Bath, United Kingdom. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United Kingdom"
  },
  "url": "https://mondoexplora.com/en/destination/bath",
  "image": "https://images.luxuryescapes.com/lxw8wxuro1c8aaakkeu",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Bath",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Fabulous style and endless charisma are at the forefront of The Bird, Bath hotel, tucked away in the grassy surrounds of the UK's only UNESCO World Heritage-listed city. This vibrant hotel is a stone's throw from iconic Bath Abbey and the romantic city centre, famed for its ancient architecture and Roman relics. But with onsite dining options including decadent afternoon tea and a glass of champagne on the terrace, you may not find reason to leave.",
          "image": "https://images.luxuryescapes.com/lxw8wxuro1c8aaakkeu",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bath",
            "addressCountry": "United Kingdom"
          },
          "priceRange": "$139",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 139,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/bath"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience an elegant heritage escape at Hotel Indigo Bath, an IHG Hotel, a charming hotel set within a beautifully restored Georgian Terrace. Explore this gorgeous area and immerse yourself in the ancient bathhouses that inspired the city's name, before discovering architectural treasures including the Bath Abbey, Roman Baths and Pulteney Bridge. At the hotel, savour delicious fare at The Elder Restaurant or release some endorphins at the stylish gym locate onsite.",
          "image": "https://images.luxuryescapes.com/zt9v98nri88tuq5l4de",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bath",
            "addressCountry": "United Kingdom"
          },
          "priceRange": "$121",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 121,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/bath"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Escape to rolling green hills on a magnificent countryside stay at the quaint and welcoming Homewood. Step inside the hotel’s historic stone walls and be swept away by opulent interiors filled with vibrant art and lavish furniture. If rejuvenation is in order, a visit to the hotel’s luxurious spa is the perfect way to enhance your escape. When hunger bites, sample succulent Mediterranean dishes on the terrace, or indulge under the stars in a futuristic dining dome.",
          "image": "https://images.luxuryescapes.com/uizngck99hijt67vx4bj",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bath",
            "addressCountry": "United Kingdom"
          },
          "priceRange": "$177",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 177,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/bath"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience a boutique, five-star escape at The Roseate Villa, Bath, a quintessential British stay consisting of two beautifully restored Victorian houses in the heart of a historic location. Expect elegant touches such as faux-bookcase wallpaper, bespoke wooden furniture that triggers memories of days gone by and a meticulously landscaped garden that's the perfect setting for a twilight stroll. Indulge in a classic English afternoon tea complete with scones and prosecco, or sip a lavish cocktail mixed by an expert at Henrietta Bar. There’s also a resident dog - Border Terrier Muttley - who will surely make your stay even more unique. Ideally located in a quiet corner of Bath, a moment's walk from the heart of the city centre, The Roseate Villa, Bath, overlooks the perfectly manicured gardens of Henrietta Park - a historic seven-acre park built in celebration of Queen Victoria's Diamond Jubilee in 1897. Stamped with a 2021 Tripadvisor Travellers' Choice Award and ranked in the top three hotels in Bath, this stunning hotel delivers immaculate hospitality and luxury amenities within a short walk of the Jane Austen Museum and the grandeur of Bath Abbey.",
          "image": "https://images.luxuryescapes.com/4sfhle2b4chm0555p78",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bath",
            "addressCountry": "United Kingdom"
          },
          "priceRange": "$108",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 108,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/bath"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Walk through the doors of The Royal Crescent Hotel & Spa and be swept into a world of iconic luxury within the heart of Bath, renowned for its Roman-built baths and UNESCO-listed Georgian architecture. Standing regal and proud for more than 250 years, this five-star, landmark retreat will make you feel effortlessly royal with an award-winning spa and bathhouse surrounded by more than an acre of glorious gardens. Swoon over the period portraiture, look out from tall windows that face the city or back over private gardens, home to Montagu's Mews Restaurant & Bar. Then, elevate your stay with afternoon tea outside (if weather permits) in a sun lounger.",
          "image": "https://images.luxuryescapes.com/858zeel61qpihaq6cjfj",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bath",
            "addressCountry": "United Kingdom"
          },
          "priceRange": "$466",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 466,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/bath"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 5,
    "bestRating": "5",
    "worstRating": "1"
  }
