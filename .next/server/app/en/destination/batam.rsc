    "@type": "OfferCatalog",
    "name": "Hotels in Batam",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Located on a tranquil stretch of hillside overlooking the shimmering South China Sea, this idyllic retreat offers unparalleled, laidback luxury just a short 30-minute ferry ride from Singapore. Home to the only five-star pool villas on Batam, this island paradise is perfect for couples and families alike. Golden sands and tropical palms set the scene for total relaxation. Think fresh seafood, sugar-white beaches and calming yoga classes, while adventure-seekers can enjoy jetskiing, banana boating and kayaking - there's something for everyone. Watch the sun dip below the horizon with a cocktail at TIIGO Beach Club, feast on local seafood at Pantai Restaurant or savour authentic Indonesian flavours at Warung Montigo. From captivating mangrove tours to soothing rituals at Montigo Wellness spa, this is a destination where everyone can find their perfect pace.",
          "image": "https://images.luxuryescapes.com/8csidbf7pgl12j8fzft",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Batam",
            "addressCountry": "Indonesia"
          },
          "priceRange": "$339",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 339,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/batam"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
