  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Batam",
  "description": "Discover the best hotels in Batam, Indonesia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "url": "https://mondoexplora.com/en/destination/batam",
