13:T3173,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Cabo San Lucas",
  "description": "Discover the best hotels in Cabo San Lucas, Mexico. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Mexico"
  },
  "url": "https://mondoexplora.com/en/destination/cabo-san-lucas",
  "image": "https://images.luxuryescapes.com/6b1gs8mt3551bpgoadb",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Cabo San Lucas",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Along the sweeping coast of the Baja California peninsula, you will find Grand Fiesta Americana Los Cabos All Inclusive Golf & Spa - a luxurious, all-inclusive resort. Perched on the shores of Los Cabos, the resort enjoys a never-ending summer where you can frolic amongst the waves, practice your swing on the sea-level golf course and laze by one of the six glittering pools. Devour your favourite dishes from around the globe at one of nine onsite restaurants, sip refreshing tipples from one of six onsite bars or order tacos and cocktails straight to your sun-soaked lounger. For some adults-only rejuvenation, drop the little ones off at the Fiesta Kids Club and slink over to SOMMA WineSPA for unique liquor therapies. The sushi served at Tapas Bar and Fire Pit exudes freshness and is best enjoyed while listening to live music while overlooking the sea. Choose fine Italian dining at Rosato restaurant to taste the succulent ragu or indulge in a meal on the sand at Peninsula restaurant, where elegant international and Asian-inspired dishes showcase a relaxed elegance.",
          "image": "https://images.luxuryescapes.com/6b1gs8mt3551bpgoadb",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cabo San Lucas",
            "addressCountry": "Mexico"
          },
          "priceRange": "$1459",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 1459,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cabo-san-lucas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Along the sweeping coast of Mexico's Baja California peninsula is where you will find the ultra luxurious Montage Los Cabos, a five-star sanctuary that blends natural coastal beauty with authentic Mexican-inspired elements that pay respect to the region's rich and diverse culture. Sheer extravagance is evident at every turn, from the 39-acre private beach to the stunning wellness centre and expansive guest rooms. Savour mouthwatering dishes from across the globe at one of the six bars and restaurants, sip refreshing cocktails by the pool or order tacos straight to your sun-soaked private retreat. For some well-deserved rejuvenation, slink over to Spa Montage for an unrivalled wellness experience or explore the underwater marvels of the region's coral reefs within easy reach.",
          "image": "https://images.luxuryescapes.com/g3miks9mdz21zmupmg9f",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cabo San Lucas",
            "addressCountry": "Mexico"
          },
          "priceRange": "$823",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 823,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cabo-san-lucas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover Mexico’s dreamy city of Cabo San Lucas, where white sandy beaches and soaring stone cliffs meet a vibrant nightlife. Base yourself at the renovated Corazón Cabo Resort & Spa, a luxurious Noble House Resort property on popular Medano Beach. Take a dip in any of the two magnificent ocean-facing infinity pools and when you’re in need of refreshments, ascend to Rooftop 360, the highest rooftop bar in the city. Listen to live DJ sets while sipping a mojito on your private cabana or day bed at the cool Corazón Beach Club, and taste craft beers brewed in Baja Brewing Co., the first and only microbrewery in Baja California Sur. Leaving the resort is a hard task, but the wonders that await in Cabo are well worth it. Private yacht charters, incredible golf courses, world-class sport fishing, exciting nightlife, and luxury shopping are just steps from your retreat.",
          "image": "https://images.luxuryescapes.com/hjz1f1j1iocqfjt0r2h",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cabo San Lucas",
            "addressCountry": "Mexico"
          },
          "priceRange": "$182",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 182,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cabo-san-lucas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Soak up the serenity with an escape to Chileno Bay Resort & Residences, Auberge Resorts Collection - a luxurious, exclusive five-star resort ranked in the top 1% of properties worldwide on Tripadvisor. Perched on its eponymous bay between San Jose del Cabo and Cabo de San Lucas, amongst bougainvillea and cactus, the tranquil haven is a masterclass in relaxed contemporary Cabo style. Saunter down to the sands of Chileno Bay to frolic amongst the waves, or get a closer look at the exquisite coral reefs with the resort’s collection of complimentary watersports. When the sun starts to set, head to the property’s signature restaurant, COMAL, for innovative interpretations of regional flavours and a spectacular Sea of Cortez sunset backdrop.",
          "image": "https://images.luxuryescapes.com/y37l7hyx59qzm2w9j4rd",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cabo San Lucas",
            "addressCountry": "Mexico"
          },
          "priceRange": "$693",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 693,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cabo-san-lucas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Welcome to Vista Encantada Spa Resort & Residences, your own slice of Los Cabos paradise enveloped in an elegant and welcoming ambiance. Set against the backdrop of a striking cliff edge, surrounded by the Pacific Ocean, this exclusive complex is within easy reach of the area’s beaches, restaurants and local attractions, including Pelican Rock and the Museum of Natural History. Discover tranquillity at Milagro Spa, lounge poolside with a cocktail in hand or sample signature cuisines with Mexican, Italian and Western favourites at one of 13 onsite restaurants and bars. Intimate and authentic, Vista Encantada is home to a collection of suites and villas showcasing traditional Mexican architecture and artwork, colonial touches, majestic pillars and romantic archways. While leaving your sumptuous sanctuary is optional, there’s more to explore. Dive into the clear blue waters of the Pacific Ocean or kayak through the waves, head out on a zipling adventure through lush greenery or play a round of golf at one of the nearby courses.",
          "image": "https://images.luxuryescapes.com/hv41axsib8burlw2oljh",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cabo San Lucas",
            "addressCountry": "Mexico"
          },
          "priceRange": "$369",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 369,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cabo-san-lucas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Soak up the tropical allure of Western Mexico's chic Cabo San Lucas from this gorgeous resort, perfectly positioned on the powder-soft shores of Medano Beach. Spend sunny days counting the shades of ocean blues, wade through expansive lagoon pools and look out onto El Arco rock from the pirate ship-themed bar. For the culinary enthusiasts, there is plenty on offer: from juicy burgers at the poolside El Bucanero to traditional Mexican fare served with a contemporary twist at El Patron Mexican Bistro, delight in gourmet delicacies across the resort's six alfresco eateries. Later, head to the onsite Desert Spa, home to award-winning treatments, for some pampering. When it's time to explore, you're mere minutes from beach bars and trendy boutiques.",
          "image": "https://images.luxuryescapes.com/09aunjeuogr929pu8ia",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cabo San Lucas",
            "addressCountry": "Mexico"
          },
          "priceRange": "$271",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 271,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cabo-san-lucas"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in the vibrant energy of Cabo San Lucas with a stay at Bahia Hotel & Beach House, a stylish escape nestled on the edge of the Baja Peninsula. Wander to the nearby Medano Beach, the area's most popular sandy stretch, or explore the marina's bustling shops and restaurants. Enjoy a refreshing dip in the pool, savour authentic Mexican cuisine at Bar Esquina, or sip on handcrafted cocktails at the iconic SUR Beach House, positioned directly on the shoreline.",
          "image": "https://images.luxuryescapes.com/63llfp3ifbccwry6mm",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cabo San Lucas",
            "addressCountry": "Mexico"
          },
          "priceRange": "$218",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 218,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cabo-san-lucas"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 7,
    "bestRating": "5",
    "worstRating": "1"
  }
}6:["$","main",null,{"className":"min-h-screen","children":[["$","$L12",null,{"pageType":"destination","destination":"Cabo San Lucas","country":"Mexico","hotelCount":7,"minPrice":182}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$13"}}],"$L14","$L15","$L16"]}]
