12:T21d3,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "New South Wales",
  "description": "Discover the best hotels in New South Wales, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/new-south-wales",
  "image": "https://images.luxuryescapes.com/6dx0fffa5xrsnudk09pg",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in New South Wales",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Set on 50 acres of native bushland and sand dunes fronting Belongil Beach, this luxurious, design-led escape lets nature set the pace and barefoot elegance reign. Just a few minutes north of Byron Bay, the resort feels a world away with private villas inspired by the surrounding ecosystems - Dunal, Rainforest, Eucalypt and Wetlands - each thoughtfully crafted with natural textures. Days unfold slowly here, with mornings spent on a daybed at the adults-only pool or floating in the vast central lagoon shaded by palms. Azure Bar and Grill serves seasonal dishes made from local ingredients, while the Botanica Beach Lounge spills out onto the sand with plush lounges and ocean views. Sink into serenity at Osprey Spa, or if you're feeling adventurous, the resort's outdoor activities range from sunrise horse rides along the beach to dips in the surf and forest walks through tea tree groves. Even getting into town is a dream, with the world's first solar-powered train accessible from the resort ready to take you gliding through the dunes to Byron’s heart.",
          "image": "https://images.luxuryescapes.com/6dx0fffa5xrsnudk09pg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "New South Wales",
            "addressCountry": "Australia"
          },
          "priceRange": "$201",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 201,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/new-south-wales"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Plentiful beaches, lush hinterland and the historic harbourfront await when you escape to the stylish Rydges Newcastle. With a contemporary design and spacious rooms overflowing with coastal charm, the hotel sits in the heart of the city, just steps away from shimmering beaches, boutiques and cafés. Make the most of the glistening pool, restaurant and bar, before exploring this charming destination, affectionately known as 'Newie'.",
          "image": "https://images.luxuryescapes.com/twqrtwq3zoulnf55umli",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "New South Wales",
            "addressCountry": "Australia"
          },
          "priceRange": "$115",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 115,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/new-south-wales"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Nestled in the Bouddi Peninsula just 90 minutes north of Sydney, the seven-acre Pretty Beach House property is the embodiment of Australian outback luxury. With four exquisite pavilions to choose from - Treetops Pavilion, Bayview Pavilion, Hideaway Pavilion and The Retreat - this all-inclusive haven provides unrivalled seclusion and elegance, complemented by world-class hospitality and an array of lavish amenities. Enjoy breathtaking intimate dining spaces, a wine cellar, magnificent sandstone open fireplace, infinity pool and a hand-crafted Stefano Ferrara pizza oven - all designed to make you feel at home. Authentic, earthy interiors and unique bespoke soft furnishings await, with plush mud-brick walls and sandstone floors engulfing the entire property.",
          "image": "https://images.luxuryescapes.com/klaiu8ksg992isd4zvt",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "New South Wales",
            "addressCountry": "Australia"
          },
          "priceRange": "$2515",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 2515,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/new-south-wales"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in the vibrant heart of Sydney with a stay at this central launchpad. Rydges Australia Square boasts cosy rooms, each offering a peaceful escape from the city's energetic pulse. Eat and drink your heart out onsite: indulge in French-inspired cuisine, refresh your palette with a spritz at the wine bar or opt for in-room dining for the perfect night in. Step outside and find yourself moments from the architectural marvel of Australia Square and the historic The Rocks district. Venture a little further to discover harbourside dining at Circular Quay or take a stroll to the Royal Botanic Garden. With the city's celebrated art galleries, museums and shopping precincts within easy reach, this hotel gives you access to the best of central Sydney.",
          "image": "https://images.luxuryescapes.com/v4xf74gg69fq39eg587",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "New South Wales",
            "addressCountry": "Australia"
          },
          "priceRange": "$119",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 119,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/new-south-wales"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "If you’re planning the perfect rural escape, look no further than Evanslea Luxury Boutique Accommodation in Mudgee. This charming retreat offers comfortable cottage stays amid lush gardens and is close to amazing wineries, great restaurants and breathtaking scenery - ensuring endless opportunities for fun and relaxation. This five-star, four-and-a-half-acre property boasts a majestic lake lined with lush greenery, a tennis court and a refreshing outdoor pool.",
          "image": "https://images.luxuryescapes.com/hix60or37556lwajcn2",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "New South Wales",
            "addressCountry": "Australia"
          },
          "priceRange": "$179",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 179,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/new-south-wales"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 5,
    "bestRating": "5",
    "worstRating": "1"
  }
