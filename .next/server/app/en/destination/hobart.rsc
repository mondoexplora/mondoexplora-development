12:T3b61,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Hobart",
  "description": "Discover the best hotels in Hobart, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/hobart",
  "image": "https://images.luxuryescapes.com/i17ddmxunykp20h2r59g",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Hobart",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Stay on the northern fringes of the capital in one of Tasmania's most significant heritage properties, dating back to 1887. With the city centre just a short drive away, this heavenly escape places you close to top-notch restaurants, vibrant bars, impressive galleries and museums, with enough distance to feel as if you’re worlds away from the everyday. Stretching across three expansive levels, this elegant lodge offers guests cosy sitting rooms with crackling fireplaces and views that stretch across Hobart to kunanyi / Mount Wellington. This charming boutique lodge is where refined luxury meets the tranquillity of nature.",
          "image": "https://images.luxuryescapes.com/i17ddmxunykp20h2r59g",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$229",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 229,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Built in 1847, the Islington Hotel's historic charm and cosy vibes offer the perfect place to rejuvenate, surrounded by picture-perfect Mount Wellington views, precious artworks, crackling fires and sun-drenched terraces. After indulging in a decadent breakfast, experience the grandeur, natural beauty and charm of the capital city, home to a vibrant live music scene, dramatic art galleries and gourmet dining options.",
          "image": "https://images.luxuryescapes.com/1loxerur6hnda1sk94l",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$142",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 142,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Escape to Tasmania's historic capital with a stylish stay at the heritage-listed Rydges Hobart - a charming retreat in the trendy neighbourhood of North Hobart. Sneak away for a relaxing escape in a magical destination packed with world-class art, epicurean discoveries, one-of-a-kind cafés, indulgent wine and cocktail bars and picturesque cobblestone streets, all perched on the edge of a beautiful harbour. When you return after a day of exploring, dine at 1898 Restaurant and Bar, set within the historic main building with a fireplace and courtyard.",
          "image": "https://images.luxuryescapes.com/a5jhl4f6jachbn4n3jtw",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$72",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 72,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Escape to the heart of Hobart with a stay at Crowne Plaza Hobart, an IHG Hotel, masterfully positioned on Liverpool Street near a bustling collection of cafés, boutiques and historic theatres. Admire stunning views of mighty Mt. Wellington over espressotinis at rooftop bar The Deck or feast on grilled, market-fresh seafood at Core restaurant and bar, serving seasonal plates backed by Tasmania's succulent local produce - a shining example of what makes Hobart’s culinary culture so brilliant.",
          "image": "https://images.luxuryescapes.com/bgemm3g0gmnsox8hpf8j",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$105",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 105,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the very best of Tasmania's capital with a stay in the heart of the thriving harbourfront city at Hotel Grand Chancellor Hobart, located on the postcard-perfect waterfront. Relax and enjoy the view before heading out to hop between cosy cafes, fabulous restaurants and lively bars. Return to the welcoming hotel and make the most of its world-class facilities, including a heated indoor pool with incredible skyline views.",
          "image": "https://images.luxuryescapes.com/7d8h4nb9so2t021yedcr",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$90",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 90,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the history, natural beauty and lively vibe of Hobart with a stay at Wrest Point. Delight in the breathtaking views of the Derwent River, Mount Wellington and the city from your elegant accommodation, before setting out to explore all that the capital has to offer, including Salamanca Market, historic Battery Point and the renowned Museum of Old and New Art (MONA). You'll be spoilt for culinary choice with nine restaurants and bars onsite, including The Point Revolving Restaurant, perched on the 17th floor. When not eating or drinking, take dips in the indoor pool, or soak up the thrilling entertainment at the casino or Entertainment Centre.",
          "image": "https://images.luxuryescapes.com/u0sjvafylkd6sd7j8c1",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$62",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 62,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience a hotel that feels like a luxury cruise, not just a city stay, all within walking distance of Hobart’s best. Situated on the city’s most historic wharf, boasting timber panelling, sweeping windows and subtle reminders of its storied past, it’s impossible not to be wowed by the seaside splendour of the iconic MACq 01 Hotel. After days of uncovering Hobart’s wonders, retreat to your designer room, each embodying the storied Tasmanian spirit through quirky artwork, raw materials and earthy tones. Later, savour freshly caught Tasmanian seafood at Old Wharf Restaurant, with a backdrop of the dazzling harbour, before a nightcap by The Lounge's open fire.",
          "image": "https://images.luxuryescapes.com/f2jjh3q78b7mj6b4r5bl",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$150",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 150,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Soak up the allure of Tasmania's capital from this sophisticated Mövenpick sanctuary ideally positioned in the heart of Hobart's vibrant waterfront precinct. Take this chance to discover Hobart's rich culture, history and lip-smacking cuisine as you explore the iconic Salamanca Market, stroll the harbour and admire the Royal Tasmanian Botanical Gardens. Back at your hotel, unwind in your plush room and when hunger strikes, indulge in a culinary journey at the onsite Tesoro Modern Italian Restaurant sampling local dry-aged meats and house-made tiramisu. For art enthusiasts, the world-renowned Museum of Old and New Art is only a short ferry ride - or 20-minute drive - away and awaits exploration.",
          "image": "https://images.luxuryescapes.com/vvnnsoikkry8qlq93yd5",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$80",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 80,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Australia’s first dedicated art hotel combines luxury hospitality and creative expression, housed in a historic jam factory on Hobart’s bustling waterfront. With exposed brick, steel beams and soaring ceilings, the building’s industrial character is elevated by contemporary details and an impressive art collection from Tasmanian creatives. Perfectly positioned in the heart of Hobart, spend your days exploring the colonial-era streets, award-winning restaurants and the stunning riverside, or perhaps dive deeper into the hotel’s collection on their Art and History Tour. Indulge in Tasmania’s finest produce at Landscape Restaurant & Grill and cheers to your stay with a handcrafted cocktail at IXL Long Bar.",
          "image": "https://images.luxuryescapes.com/yare7xrbt20lc0u19n3d",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$128",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 128,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the charm of Tasmania's capital with a central stay located in the heart of Hobart's bustling waterfront district. This contemporary hotel is within easy reach of the city's renowned Salamanca Market, historic Battery Point and the Tasmanian Museum and Art Gallery. Start each morning at Cafe Collins, before embracing all that the southern capital has to offer, including the Royal Botanic Gardens and the Museum of Old and New Art (MONA). Return each night to impeccable hospitality and cosy cloud-like beds.",
          "image": "https://images.luxuryescapes.com/d10b3s1dnlvwpu7407h3",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hobart",
            "addressCountry": "Australia"
          },
          "priceRange": "$89",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 89,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hobart"
      }
    ]
