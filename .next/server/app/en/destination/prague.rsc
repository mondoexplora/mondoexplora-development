13:T1ac3,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Prague",
  "description": "Discover the best hotels in Prague, Czech Republic. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Czech Republic"
  },
  "url": "https://mondoexplora.com/en/destination/prague",
  "image": "https://images.luxuryescapes.com/x5jxjxbbyq4jb3nn61",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Prague",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Stay at the heart of Prague at this chic retreat in the historic Old Town. Positioned near legendary landmarks including the Astronomical Clock and Charles Bridge, this hotel's location offers unparalleled access to the city’s rich history, vibrant culture and bustling nightlife. Each morning, savour a sumptuous breakfast at the stylish onsite restaurant before exploring the city's cobbled lanes, lined with charming boutiques and eateries. After a day of sightseeing on a guided, English-speaking city tour (select packages only), retreat to the hotel's library for a quiet read, then familiarise yourself with local drops during a daily wine tasting at the sophisticated bar. Unwind in exclusive rooms, blending modern comfort with classic charm, and rejuvenate freely in the luxurious spa facilities.",
          "image": "https://images.luxuryescapes.com/x5jxjxbbyq4jb3nn61",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Prague",
            "addressCountry": "Czech Republic"
          },
          "priceRange": "$359",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 359,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/prague"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Find yourself enraptured by Art Deco excellence with a stay at this prestigious Luxury Collection hotel in the heart of Prague. Step through the sophisticated marble foyer and be welcomed by an abundance of sparkling facilities, including a rejuvenating wellness area with a fitness centre and two massage rooms, the elegant Alcron restaurant serving authentic Czech cuisine and a moody cocktail bar showcasing a dazzling menu of unique cocktails and elusive spirits.",
          "image": "https://images.luxuryescapes.com/cpw50uzq09kwdsvfs5dd",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Prague",
            "addressCountry": "Czech Republic"
          },
          "priceRange": "$154",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 154,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/prague"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover Prague's famous landmarks from the Mandarin Oriental Prague, a sophisticated hotel built on the site of a 14th-century Dominican monastery. The hotel's history is evident through the high-gated walls, vaulted ceilings and period features - it's like taking a step back in time. Prague's most iconic sights are at your fingertips, including Charles Bridge and Prague Castle. When you're not exploring the town, enjoy summer nights on Spices Terrace with cocktails and dinner, indulge in a treatment in the spa (housed in a former chapel), or work out in the fitness centre.",
          "image": "https://images.luxuryescapes.com/tsiuphrnxrcdd7thozhw",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Prague",
            "addressCountry": "Czech Republic"
          },
          "priceRange": "$363",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 363,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/prague"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the unique fairytale charm of Prague at the boutique BoHo Prague Hotel, rated among the top 10% of hotels on Tripadvisor. Located just steps from the Old Town Square, this luxury hotel places you within easy reach of top attractions including Prague Castle, Charles Bridge, St. Vitus Cathedral and Wenceslas Square. Fuel your sightseeing with the delicious local chimney cake, a hearty plate of dumplings or a refreshing beer from any of the nearby restaurants and cafés. Once you’ve had your fill of the ‘Golden City’, return to your boutique retreat, offering gastronomic excellence at the onsite restaurant and a wellness area with gym, sauna and spa bath. Each room offers a superior level of modern comfort with stylish grey, cream and pastel interiors, LCD TV and high-speed Wi-Fi.",
          "image": "https://images.luxuryescapes.com/xfi3xmd1gs1erztx4t3",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Prague",
            "addressCountry": "Czech Republic"
          },
          "priceRange": "$200",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 200,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/prague"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 4,
    "bestRating": "5",
    "worstRating": "1"
  }
