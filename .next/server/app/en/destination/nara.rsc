12:Td82,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Nara",
  "description": "Discover the best hotels in Nara, Japan. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Japan"
  },
  "url": "https://mondoexplora.com/en/destination/nara",
  "image": "https://images.luxuryescapes.com/u71lch9u0qgu9jmtxxjm",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Nara",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience a fusion of modern luxury and traditional charm in Japan's ancient capital, Nara. This elegant retreat is perfectly positioned for exploring the Kansai region's rich history, with the UNESCO World Heritage-listed temples of Kyoto, deer-filled parks of Nara City and iconic eating streets of Osaka all easily accessed by rail. After a day of sightseeing, soak in serenity at the hotel's very own hot spring baths and indulge in bliss at the sauna before unwinding at the Onsen Lounge with a refreshing drink.",
          "image": "https://images.luxuryescapes.com/u71lch9u0qgu9jmtxxjm",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Nara",
            "addressCountry": "Japan"
          },
          "priceRange": "$56",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 56,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/nara"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in Japan's ancient capital with a stay at this contemporary Novotel gem. Savour Italian flavours with a local twist at the onsite Trattoria Ponte Nara restaurant, before indulging in pure relaxation at the onsite Wellness Lounge, complete with Japanese-style public baths. The hotel's prime location places you within easy reach of sought-after spots, including Nara Park and its friendly deer, Todai-ji Temple and more. After a day of exploring, come back to homey rooms, pleasing decor and world-class amenities for a relaxing stay.",
          "image": "https://images.luxuryescapes.com/rii5ocw3frq1m3duuwlu",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Nara",
            "addressCountry": "Japan"
          },
          "priceRange": "$73",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 73,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/nara"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
