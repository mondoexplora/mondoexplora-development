  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Chiang Rai",
  "description": "Discover the best hotels in Chiang Rai, Thailand. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Thailand"
  },
  "url": "https://mondoexplora.com/en/destination/chiang-rai",
