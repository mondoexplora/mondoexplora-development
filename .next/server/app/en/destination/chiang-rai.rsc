  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Chiang Rai",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the wonderous beauty of Chiang Rai, a northern Thai city cradled by mountains and filled to the brim with ancient temples, spiritual sites, art and cultural experiences. Located on the banks of the Kok River, The Riverie by Katathani offers something for everyone, from outdoor pools and a mini waterpark to the calming tranquillity of Tivaa Ratrii Spa. Enjoy a cocktail at Jujube Pool Bar before choosing which of the three restaurants to dine at: try authentic Thai plates at Blossom Restaurant where the food is surpassed only by the views, dine on mouthwatering Cantonese Dim Dum at China Garden and swim up to the Jumanji Bar for tipples against views of the Kok River. Further afar, Chiang Rai beckons with authentic Thai experiences. Take a short drive to the ethereal Wat Rong Suea Ten or Khun temples, wander past the gardens at the Chiang Rai Walking Street and browse artisan goods at the night bazaar.",
          "image": "https://images.luxuryescapes.com/1m56ds3ldkat2e6ujlop",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Chiang Rai",
            "addressCountry": "Thailand"
          },
          "priceRange": "$359",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 359,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/chiang-rai"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the wonderous beauty of northern Thailand with a five-star stay at The Riverie by Katathani, on the banks of the Kok River. This elegant escape has something for everyone, from outdoor pools and a mini waterpark to the calming tranquillity of Tivaa Ratrii Spa. Enjoy a cocktail at Jujube Pool Bar before choosing which of the three restaurants to dine at: try authentic Thai plates at Blossom Restaurant where the food is surpassed only by the views.",
          "image": "https://images.luxuryescapes.com/s60frfoojhjrcil3lyyjj",
          "address": {
            "@type": "PostalAddress",
