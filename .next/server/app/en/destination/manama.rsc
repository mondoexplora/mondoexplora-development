12:Te50,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Manama",
  "description": "Discover the best hotels in Manama, Bahrain. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Bahrain"
  },
  "url": "https://mondoexplora.com/en/destination/manama",
  "image": "https://images.luxuryescapes.com/x5w1ka5dng60ihozjsx",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Manama",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Relax in ultimate luxury at InterContinental Bahrain, an IHG Hotel, beautifully located overlooking the mesmerising Bahrain Financial Harbour. Surrounded by culture, Bahrain is the perfect destination for adventurous families or couples, with this hotel offering a glittering oasis in the Middle Eastern heat. Take a dip in the opulent swimming pool, partake in some self-care at Spa InterContinental or the onsite fitness centre, or indulge in an exquisite dining experience at one of the four onsite restaurants.",
          "image": "https://images.luxuryescapes.com/x5w1ka5dng60ihozjsx",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Manama",
            "addressCountry": "Bahrain"
          },
          "priceRange": "$127",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 127,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/manama"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience a slice of Arabian paradise at this Manama gem set along the shimmering shores of Bahrain. The resort features a private beach, tranquil spa and a variety of dining options, including Zytoun, serving Mediterranean and Middle Eastern cuisine all day, and La Perle dishing up some fresh seafood. The resort is just a short drive from the Al-Fateh Grand Mosque and the Bahrain Fort, two must-visit historical sites. For a unique shopping experience, visit the Manama Souq, a traditional market filled with local goods and charming trinkets, perfect for finding the ideal holiday memento. After a day of exploration, return to the comfort of your spacious room, soak in the bathtub or enjoy a refreshing dip in the outdoor pool.",
          "image": "https://images.luxuryescapes.com/9m7fm3x7ps8oonzwv4xg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Manama",
            "addressCountry": "Bahrain"
          },
          "priceRange": "$118",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 118,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/manama"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
