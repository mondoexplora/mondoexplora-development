  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Gurugram",
  "description": "Discover the best hotels in Gurugram, India. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "India"
  },
  "url": "https://mondoexplora.com/en/destination/gurugram",
  "image": "https://images.luxuryescapes.com/h5iwm94l6yeqxgappyaf",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Gurugram",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Ideally situated on the outskirts of New Delhi, Crown Plaza Gurgaon is an urban retreat perfect for rest and revitalisation. Take a refreshing dip in the outdoor pool or rejuvenate your mind and body at the Bodyzone fitness centre and spa. A diverse range of delectable dishes sure to satisfy your appetite await at Cafe G restaurant, as well as the option to indulge in a sophisticated spirit at the ConneXions lobby bar or a sweet treat at the Delicious pastry shop.",
          "image": "https://images.luxuryescapes.com/h5iwm94l6yeqxgappyaf",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Gurugram",
            "addressCountry": "India"
          },
          "priceRange": "$72",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 72,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/gurugram"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "For a stylish and modern stay within a flourishing hub, Holiday Inn Gurugram Sector 90, an IHG Hotel is the ideal comfortable retreat after days spent exploring New Gurugram. Treat yourself to the variety of choices at Viva All Day Dining, serving up both buffet and à la carte Indian, Asian and Western cuisines, as well as delicious beverages and cocktails at the cosy Viva Bar. From the relaxing outdoor pool to the fitness centre, find a space to kick back and enjoy your time away.",
          "image": "https://images.luxuryescapes.com/0sx05bjovri4sirmqdrg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Gurugram",
            "addressCountry": "India"
          },
          "priceRange": "$48",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 48,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/gurugram"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Located in the corporate hub of Udyog Vihar, this hotel offers comfort and convenience for business and leisure travellers alike. Unwind in stylish rooms, kick back at the coffee-to-cocktails bar, or squeeze in a workout at the 24/7 fitness centre. Just minutes from major business parks and a stone's throw from New Delhi Airport, this is your urban oasis in central Gurugram. Indulge in global culinary delights at Gallery Cafe, take a refreshing dip in the outdoor pool, or host your next meeting in versatile event spaces. With the vibrant shopping districts of Ambience Mall and Cyber Hub nearby, everything is taken care of.",
          "image": "https://images.luxuryescapes.com/h1vz85dfb6pj8gzjph9",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Gurugram",
            "addressCountry": "India"
          },
          "priceRange": "$62",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 62,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/gurugram"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
