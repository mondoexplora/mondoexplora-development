11:T110e,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Tuscany",
  "description": "Discover the best hotels in Tuscany, Italy. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Italy"
  },
  "url": "https://mondoexplora.com/en/destination/tuscany",
  "image": "https://images.luxuryescapes.com/b48uikreykct1kzy1bg9",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Tuscany",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Located in the rolling hills of Val d’Orcia, a UNESCO World Heritage Site, this utterly blissful five-star retreat is your gateway to the beauty of Tuscany. This historic Medici villa, a proud member of The Leading Hotels of the World, offers breathtaking panoramic views of vineyards and olive groves. Renowned for its natural thermal springs, Fonteverde Lifestyle & Thermal Retreat features a world-class spa with multiple indoor and outdoor pools, where mineral-rich waters emerge at 42°C, providing a world of therapeutic benefits. Wake to breakfast with landscape views at La Corte Restaurant, spend nights sipping wine at Bar il Falconiere or slink into plush seats for dinner at Ferdinando I Restaurant, housed inside a Renaissance-era portico.",
          "image": "https://images.luxuryescapes.com/b48uikreykct1kzy1bg9",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Tuscany",
            "addressCountry": "Italy"
          },
          "priceRange": "$789",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 789,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/tuscany"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "If you’re looking for an authentic Italian experience in the Tuscan countryside, then this secluded haven - just an hour outside of Pisa and Lucca - may be the perfect place for you to taste la dolce vita. Surrounded by thick olive groves, vineyard-cloaked valleys and lush hills, the stunning Toscana Resort Castelfalfi is the perfect base to fall in love with all provincial Italy has to offer. A one-of-a-kind showcase of the Italian lifestyle, the sprawling resort is complete with a long list of five-star facilities. Wine and dine on authentic cuisine across six gourmet restaurants and bars, tee-off on the 27-hole golf course, take a dip in the heated indoor and outdoor swimming pools and unwind at a blissful spa self-proclaimed to be 'Tuscany's best spa' with a Finnish sauna, Turkish bath and sensory showers. Plus, this retreat is home to its very own olive oil and wine estate and boasts numerous activities to help you embrace the Italian culture, including cooking classes and truffle hunting (charges apply). When the time comes to leave your luxe hideaway, you could visit the beautiful cities of Pisa, the ‘cradle of the Renaissance’ Florence, San Gimignano and Volterra.",
          "image": "https://images.luxuryescapes.com/wt54xm0im8ps30la302",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Tuscany",
            "addressCountry": "Italy"
          },
          "priceRange": "$423",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 423,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/tuscany"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
}5:["$","main",null,{"className":"min-h-screen","children":[["$","$L10",null,{"pageType":"destination","destination":"Tuscany","country":"Italy","hotelCount":2,"minPrice":423}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],"$L12","$L13","$L14"]}]
