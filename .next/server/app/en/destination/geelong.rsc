12:T1ab2,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Geelong",
  "description": "Discover the best hotels in Geelong, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/geelong",
  "image": "https://images.luxuryescapes.com/dhxeviy7wfc6sb5affwb",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Geelong",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the allure of Geelong's coastal charms with a stay at this sophisticated hotel, perfectly positioned mere moments from the bustling promenade and the city centre. Take advantage of the hotel's strategic location and explore the local art scene at the Geelong Gallery, indulge in retail therapy at Westfield Geelong and take a leisurely stroll along the stunning waterfront. After a day of discovery, take a refreshing dip in the heated indoor pool or simply kick back and relax in your well-appointed room. Savour flavour-focused cuisine at Maestro Restaurant and Bar, boasting a wide array of locally sourced grilled meats, fresh produce, craft beers and wines. For an additional dash of adventure, enjoy a bird’s-eye view of Geelong’s green surrounds from the nearby Giant SkyWheel.",
          "image": "https://images.luxuryescapes.com/dhxeviy7wfc6sb5affwb",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Geelong",
            "addressCountry": "Australia"
          },
          "priceRange": "$209",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 209,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/geelong"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Revel in the tranquil charms of one of Victoria's finest regional cities at this contemporary Novotel retreat, overlooking Geelong's serene waterfront. Take advantage of the hotel's prime CBD location and explore the thriving culinary and cultural arts scene, drive along Great Ocean Road and wander along the Art Deco-inspired Eastern Beach. Back at your hotel, swim laps in the indoor pool or head to the hotel's waterfront restaurant, Tempo and savour lip-smacking preparations starring Victoria's local produce and flavours. Perfect for both friends and family, take delight in the hotel's signature hospitality and make the most of your Geelong adventure.",
          "image": "https://images.luxuryescapes.com/yxq0xyt8u4vc3grp3w69",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Geelong",
            "addressCountry": "Australia"
          },
          "priceRange": "$93",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 93,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/geelong"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Enjoy some well-deserved time away at the Holiday Inn & Suites Geelong, an IHG Hotel, a bright, social hub where the lively promenade and bustling Geelong city centre are just steps away. Get a bird's-eye view of Geelong’s green surrounds from the nearby Giant SkyWheel, or spend the day poolside at your hotel. When it's time to eat, Maestro restaurant and bar is a flavour-filled showcase of meats, fresh produce, coffee, craft beers and wines. The restaurant transforms into a show kitchen after breakfast - watch the chefs in action as they fire up the grills for lunch and dinner.",
          "image": "https://images.luxuryescapes.com/qmhis4atgduxtrvp0ebs",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Geelong",
            "addressCountry": "Australia"
          },
          "priceRange": "$82",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 82,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/geelong"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Enjoy a leisurely stay at the modern Rydges Geelong, conveniently located in the heart of the Geelong CBD with sweeping views of picturesque Corio Bay. Decorated with contemporary furnishings, this stylish hotel is ideally located for a scenic holiday. Sip a cocktail beside the refreshing pool at the Nautica Pool Bar and Kitchen, indulge in one of their modern Australian dishes, or take an outing to the neaby iconic Eastern Beach Reserve, ideal for an entertaining family outing. Stroll around the city and sample the lively restaurant and bar scene before relaxing in your comfortable room with panoramic views.",
          "image": "https://images.luxuryescapes.com/ynh0sr0veglxu5u738k",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Geelong",
            "addressCountry": "Australia"
          },
          "priceRange": "$93",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 93,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/geelong"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 4,
    "bestRating": "5",
    "worstRating": "1"
  }
