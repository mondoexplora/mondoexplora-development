      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover Asheville's best from this historic stay overlooking the Blue Ridge Mountains. This century-old resort is a haven of North Carolina hospitality, offering locally sourced cuisine at the upscale Vue 1913, craft cocktails at the rustic Great Hall Bar and a Donald Ross-designed championship golf course. Omni Grove Park Inn makes relaxation easy: enjoy time spent at the 43,000-square-foot subterranean The Spa, featuring eucalyptus steam rooms, therapeutic waterfalls and an oversized, mountain view hot tub.",
          "image": "https://images.luxuryescapes.com/kc2wiwoacruw38j9qcb8",
          "address": {
