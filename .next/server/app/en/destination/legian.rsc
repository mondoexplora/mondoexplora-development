12:T146d,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Legian",
  "description": "Discover the best hotels in Legian, Indonesia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "url": "https://mondoexplora.com/en/destination/legian",
  "image": "https://images.luxuryescapes.com/lxn4fj3v1rqsfl6stp",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Legian",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Bask in the tranquillity of Astagina Resort Villa and Spa Bali, a cocoon of serenity where tropical elegance and traditional Balinese style emanate from every corner. Unwind in the lush gardens, plunge into the glittering pools, savour authentic Indonesian fare at Pangi Bistro or indulge in relaxing treatments at the Anjali Spa. Situated in the Legian and only a 10-minute walk to the pristine sands of the Double Six Beach, this gorgeous escape will help you rejuvenate in style.",
          "image": "https://images.luxuryescapes.com/lxn4fj3v1rqsfl6stp",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Legian",
            "addressCountry": "Indonesia"
          },
          "priceRange": "$60",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 60,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/legian"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience Balinese bliss at the centrally located Mercure Bali Legian. Just minutes away on foot from dazzling Legian Beach and Kuta Beach, this well-appointed sanctuary places you close to the market action and beach paradise at the heart of Bali’s popular Legian area. After long days soaking up the waterside vibes, return to your elegantly designed lodgings for a dip in the sparkling infinity pool, embrace international cuisine at Ancak Restaurant & Lounge, then toast to incredible Indonesia with a drink at the chic Poole Bar & Lounge. For ultimate relaxation, visit the onsite spa and wellness centre for rejuvenating treatments and holistic therapies in a serene atmosphere, perfect for enhancing your luxurious getaway.",
          "image": "https://images.luxuryescapes.com/s4lxs07tjpf782x0htpt",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Legian",
            "addressCountry": "Indonesia"
          },
          "priceRange": "$50",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 50,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/legian"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Relax in the pinnacle of paradise at this five-star beachfront haven perfectly poised between Bali's famous Kuta and Legian beaches. While the local area is dotted with vibrant bars and trendy restaurants, this luxurious hotel feels quiet and exclusive thanks to a ring of Balinese tropical gardens, hiding three pools, a breathtaking spa and an onsite restaurant. There's plenty to discover beyond the hotel - including some of Bali's best day clubs and boutique shopping - but this luxury oasis has plenty to entice you to stay and simply lounge within the hotel's grounds. Treat yourself to a global dining affair at Montage or opt for something a little more relaxed with a drink and small bite at one of three stunning bars.",
          "image": "https://images.luxuryescapes.com/d636szrlt9s6kfadtyi",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Legian",
            "addressCountry": "Indonesia"
          },
          "priceRange": "$94",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 94,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/legian"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
