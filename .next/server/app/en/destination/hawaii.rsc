11:T2efb,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Hawaii",
  "description": "Discover the best hotels in Hawaii, United States. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United States"
  },
  "url": "https://mondoexplora.com/en/destination/hawaii",
  "image": "https://images.luxuryescapes.com/048amylf0m7k5o32jp",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Hawaii",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "When it comes to unforgettable Big Island stays, this magnificently renovated oceanfront escape has everything. Resting on the Kona Coast above the lava-rock cliffs of Keauhou Bay, this 22-acre resort is one of the only places in the world where gentle, giant manta rays swim right up to the shoreline. Make a splash at the oceanfront pool and waterslide, offering endless family-friendly fun for both kids and adults, all with breathtaking views of the Pacific. Take a dip in the shimmering lagoon pool, toast to good times at Piko cafe and wine bar or relax at the poolside Holua Poolside Bar & Lounge before returning to your serene room.",
          "image": "https://images.luxuryescapes.com/048amylf0m7k5o32jp",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hawaii",
            "addressCountry": "United States"
          },
          "priceRange": "$729",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 729,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hawaii"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the allure of Waikiki at this adults-only retreat, the ideal launchpad for your island adventures. This stylish hotel in the heart of Waikiki, near the popular International Market Place, seamlessly blends island life with modern comforts and is just moments from the crystal-clear waters of the Pacific Ocean - perfect for swimming and snorkelling. Romer House Waikiki exceeds every expectation, with a serene wading pool surrounded by softly upholstered daybeds and relaxed sling deck chairs. Indulge in a modern twist on Hawaiian cuisine at 855-ALOHA, where fusion-inspired dishes and signature cocktails are served in a tranquil, open-air setting, with nightly live entertainment. When not exploring this neighbourhood clubhouse, venture out to explore the bustling Kalakaua Avenue, lined with high-end boutiques and local eateries, visit the Duke Kahanamoku Statue, take a surfing lesson or explore O’ahu’s diverse attractions.",
          "image": "https://images.luxuryescapes.com/f3c5wjvvhc94sw1v0wh7",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hawaii",
            "addressCountry": "United States"
          },
          "priceRange": "$729",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 729,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hawaii"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the best of iconic Hawaii with a stay at ‘Alohilani Resort Waikiki Beach, perfectly positioned in the heart of Honolulu’s glamorous main beachfront promenade, Kalakaua Avenue. Admire the resort’s breathtaking oceanarium or visit SWELL, a sprawling, cabana-flanked infinity pool and bar offering panoramic views over the Pacific Ocean from its high floor elevation. The dining is top-notch - head to Morimoto Asia for a taste of the renowned Iron Chef’s masterful Asian plates, Piccola Onda for Italian bites served with a Roman flair or savour small-batch, artisanal scoops at Double Fat Ice Cream, Hawaii’s best-loved ice creamery.",
          "image": "https://images.luxuryescapes.com/4r6a8zqk0gowg30qnsv1",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hawaii",
            "addressCountry": "United States"
          },
          "priceRange": "$303",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 303,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hawaii"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Retreat to a glorious Hawaiian island oasis, where the grass is greener, the water is clearer and the drinks are sweeter, with a stay at Timbers Kaua'i Ocean Club & Residences. Embrace the classic laidback and vibrant culture of Hawaii while admiring panoramic views of the turquoise ocean stretching out from the front door. Spend your days exploring nearby beaches and tropical forests, floating in the incredible two-tiered infinity pool or rejuvenating in Nanea Spa. Tee off at The Ocean Course, a Jack Nicklaus Signature, to soak up the longest stretch of oceanfront golf in Hawaii. Take your tastebuds on a delicious adventure to the Garden Isles with fresh farm-to-table dishes served up at Hualani’s Restaurant, finishing with a refreshing cocktail at the poolside bar.",
          "image": "https://images.luxuryescapes.com/ng19re7pzsokqsk0bbeo",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hawaii",
            "addressCountry": "United States"
          },
          "priceRange": "$2235",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 2235,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hawaii"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "If you’re chasing sun, sand, shopping and tropical bliss, Outrigger Waikiki Beach Resort is the place to be. A stay at this modern beachfront haven is sure to leave you feeling well-rested and relaxed. Catch some rays at the shimmering pool, drop by Infinity Spa for moments of indulgence or break a sweat at the fitness centre. When hunger strikes, savour some of Oahu's favourite dining at popular Duke's Waikiki, pick up a tropical smoothie at Sunrise Shack, stop by at Pai's Deli for healthy sandwiches or take in magnificent views of Diamond Head at Hula Grill Waikiki. Take part in the many activities available at the hotel, including stand-up paddleboard yoga, flower lei making and surfing. For adventures beyond your idyllic oasis, spend your days shopping on Kalakaua Avenue's fashion mile, hiking the trails at Diamond Head, uncovering the history of Pearl Harbor, or admiring the scenery at Manoa Falls.",
          "image": "https://images.luxuryescapes.com/n5x1wcqnh4wzctub95g",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hawaii",
            "addressCountry": "United States"
          },
          "priceRange": "$300",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 300,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hawaii"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Hawaii’s sun-drenched beaches, picturesque bays and towering volcanic peaks are nothing short of tropical bliss. Experience it all with an escape to the iconic OUTRIGGER Reef Waikiki Beach Resort, a much-loved beachfront hideaway in the heart of Waikiki. Perfectly positioned directly on Waikiki Beach, where the city meets the sea, OUTRIGGER Reef Waikiki Beach Resort is the place to be following a spectacular US$80 million refurbishment. Resort upgrades include a complete refresh of all guestrooms, an overhaul of the onsite restaurants and bars, plus a plethora of newly created wellness and fitness experiences, including state-of-the-art Peloton and Technogym equipment. A stay at this stylish oasis will leave you feeling reinvigorated, recharged and inspired.",
          "image": "https://images.luxuryescapes.com/5fntyxeiedh8r75ny451",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hawaii",
            "addressCountry": "United States"
          },
          "priceRange": "$269",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 269,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hawaii"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the magic of Hawaii at Outrigger Kona Resort and Spa, a family paradise on the sun-kissed shores of Hawaii's Big Island. This idyllic retreat is a stone's throw from vibrant Kailua-Kona town, brimming with historic sites and oceanfront dining. Kids and grown-ups alike will love the multi-level fantasy pool with a 200-foot water slide, manta-ray viewing and sweeping views of the Pacific Ocean. Hit the spa to relax and as the sun sets, savour the flavours of Hawaii at the resort's Wailele Café.",
          "image": "https://images.luxuryescapes.com/kdqlvoxinxenj94qc4nce",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hawaii",
            "addressCountry": "United States"
          },
          "priceRange": "$227",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 227,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hawaii"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 7,
    "bestRating": "5",
    "worstRating": "1"
  }
