12:T14ea,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Tulum",
  "description": "Discover the best hotels in Tulum, Mexico. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Mexico"
  },
  "url": "https://mondoexplora.com/en/destination/tulum",
  "image": "https://images.luxuryescapes.com/1c2ttu4dm2uyi364bxr",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Tulum",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Weave through the lush Mayan jungle to reach this enchanting, bohemian-style sanctuary sitting on the edge of the Caribbean Sea. Connect with nature's rhythms as you venture from your private oasis to the resort’s sun-lounger-lined infinity pool or continue straight into the shimmering ocean. At the heart of the resort is Moro - an all-day eatery with sweeping glass walls, floor cushions and an alfresco area enveloped by a canopy of Yucatan palms. Recentre yourself at the resort's wellness hub, with lymphatic massages or hydrating facials, or discover a new hobby through the weekly schedule of complimentary activities, including breathwork, yoga classes and live music.",
          "image": "https://images.luxuryescapes.com/1c2ttu4dm2uyi364bxr",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Tulum",
            "addressCountry": "Mexico"
          },
          "priceRange": "$549",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 549,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/tulum"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Beach paradise meets Mayan mystique at this five-star beachside resort. A haven of bliss overlooking the swaying palms and rolling waves of Riviera Maya, the property leaves its mark on all who visit and draws guests from far and wide to escape into a tropical sanctuary. This retreat invites you to bask in the endless sunshine by one of its five stunning outdoor pools or unwind along the private stretch of ocean, perfect for snorkelling, kayaking and paddleboarding. For true indulgence, visit the world-class Conrad Spa Tulum and immerse yourself in a treatment nestled amid a mangrove forest. You’ll be spoilt for choice with nine unique restaurants and bars to discover. Share an Izakaya-inspired menu with your loved ones at Kengai, start your day with American classics and international specialities at Arbolea and lose track of time sipping cocktails at the pool bar Ultramar.",
          "image": "https://images.luxuryescapes.com/dn8pe6cyt6zx1pvqdca",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Tulum",
            "addressCountry": "Mexico"
          },
          "priceRange": "$879",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 879,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/tulum"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover an oasis of tropical tranquillity nestled between the pristine shoreline and the lush jungle at Kimpton Aluna Resort Tulum, an IHG Hotel. Stroll down to the beachfront to enjoy crystal-clear water and soft white sand or relax beside the adults-only rooftop pool, with a cocktail in hand. Kickstart your days in paradise with an organic breakfast at Parallel 20° and later, watch the sun dip below the horizon while enjoying refreshing drinks and fusion cuisine at Bhanu Sky Kitchen. Your coastal dream awaits.",
          "image": "https://images.luxuryescapes.com/sx1mxhnelbuknr6h40z",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Tulum",
            "addressCountry": "Mexico"
          },
          "priceRange": "$131",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 131,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/tulum"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
