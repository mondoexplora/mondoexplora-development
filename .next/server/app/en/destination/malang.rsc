11:Ta36,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Malang",
  "description": "Discover the best hotels in Malang, Indonesia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "url": "https://mondoexplora.com/en/destination/malang",
  "image": "https://images.luxuryescapes.com/4mm08spj95ybx15bs8u",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Malang",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the vibrant city of Malang from the comfort of the five-star Grand Mercure Malang Mirama. Perfectly situated in the heart of the city, this contemporary and stylish hotel offers convenient access to some of Malang’s most iconic attractions. Just a short walk from the renowned Rainbow Village, with its strikingly colourful murals and artistic vibe, and only a few minutes from the historic Tugu Square, guests are immersed in the unique cultural landscape of the city. Indulge in authentic Indonesian cuisine at the hotel’s elegant onsite dining venue, Trimurti Restaurant, where you can enjoy a wide selection of buffet offerings or choose from an extensive à la carte menu, showcasing the rich and diverse flavours of the region. Pay a visit to the state-of-the-art fitness centre for those looking to stay active or take respite at the tranquil spa offering a range of rejuvenating treatments. Whether you’re looking to energize or recharge, the Grand Mercure Malang Mirama ensures every aspect of your stay is nothing short of extraordinary.",
          "image": "https://images.luxuryescapes.com/4mm08spj95ybx15bs8u",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Malang",
            "addressCountry": "Indonesia"
          },
          "priceRange": "$45",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 45,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/malang"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
