13:Tf8a,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Sharm El Sheikh",
  "description": "Discover the best hotels in Sharm El Sheikh, Egypt. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Egypt"
  },
  "url": "https://mondoexplora.com/en/destination/sharm-el-sheikh",
  "image": "https://images.luxuryescapes.com/uyg9zq0vmu2metpwqqfl",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Sharm El Sheikh",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Escape to paradise at Rixos Radamis in stunning Sharm El Sheikh, where the Red Sea meets world-class accommodation. This spectacular resort transforms your getaway into an unforgettable adventure with pristine beaches, crystal-clear waters and Egypt's legendary hospitality. Indulge your every craving at 23 incredible bars and restaurants from sizzling Mexican at Cactus to Mediterranean delights at Riviera and ocean-fresh seafood at Salt. Cool off in the glistening outdoor pool, then surrender to pure bliss at the amazing Anjana Spa. Children will love Rixy Kids Town, an enchanting world for kids to embrace games and play. Every moment here is designed to exceed your wildest vacation dreams.",
          "image": "https://images.luxuryescapes.com/uyg9zq0vmu2metpwqqfl",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Sharm El Sheikh",
            "addressCountry": "Egypt"
          },
          "priceRange": "$285",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 285,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/sharm-el-sheikh"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Indulge in the epitome of luxury at this lavish adults-only sanctuary nestled along the pristine shores of the Red Sea in the picturesque city of Sharm El Sheikh. Here, days unfold beside one of seven sparkling pools, each a serene haven or lively social hub. As the sun sets, the resort transforms into a playground of entertainment with live music, DJ sets and themed parties. Culinary enthusiasts can indulge across eight restaurants, sampling Indian, Japanese, Ottoman and Italian flavours, while the resort's nine bars dole out delicious drinks. Just outside, adventure seekers can explore the underwater world of the Red Sea, renowned for its vibrant coral reefs and diverse marine life. After a day of exploration, return for some restorative treatments and pampering at the luxe Anjana Spa.",
          "image": "https://images.luxuryescapes.com/cvpidanjjhd1xazx7tis",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Sharm El Sheikh",
            "addressCountry": "Egypt"
          },
          "priceRange": "$276",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 276,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/sharm-el-sheikh"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
