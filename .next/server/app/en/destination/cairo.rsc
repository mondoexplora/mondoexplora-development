12:T17e1,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Cairo",
  "description": "Discover the best hotels in Cairo, Egypt. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Egypt"
  },
  "url": "https://mondoexplora.com/en/destination/cairo",
  "image": "https://images.luxuryescapes.com/2sixkwhmquzfvzv7llnj",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Cairo",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Combine upscale comfort with modern luxury at Crowne Plaza West Cairo Arkan, an IHG Hotel, a recently opened haven of classical grandeur in the heart of the city. Part of the world-renowned Crowne Plaza brand, this premium retreat perfectly encapsulates the spirit of Cairo with your wellbeing in mind. Discover outstanding amenities, including an impressive selection of dining options, a fully-equipped fitness room, outdoor pool, and impeccable, personalised service.",
          "image": "https://images.luxuryescapes.com/2sixkwhmquzfvzv7llnj",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cairo",
            "addressCountry": "Egypt"
          },
          "priceRange": "$196",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 196,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cairo"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Escape to the world of the pharaohs and stay in Egypt's grand five-star InterContinental Citystars Cairo, an IHG Hotel. This central retreat offers luxurious pools to escape the Egyptian heat and nine onsite restaurants and bars, providing diverse dining experiences to suit any appetite. Using this hotel as a launchpad, follow the footsteps of the ancient Egyptians and discover the alluring history of the pyramids, crypts, mosques and museums.",
          "image": "https://images.luxuryescapes.com/ex6muxjr47g82gaav5",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cairo",
            "addressCountry": "Egypt"
          },
          "priceRange": "$174",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 174,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cairo"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Combine the perfect location with world-renowned luxury at the InterContinental Cairo Semiramis, an IHG Hotel, located on the banks of the Nile. Relax in unparalleled comfort with easy access to the pyramids, while the exciting bazaars of old Cairo are located just steps from your front door. After days spent exploring ancient wonders, return for a refreshing dip in the rooftop pool, while the spa stands ready to pamper you.",
          "image": "https://images.luxuryescapes.com/cyx634h57i00v9nwn59",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cairo",
            "addressCountry": "Egypt"
          },
          "priceRange": "$108",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 108,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cairo"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the perfect fusion of modern sophistication and ancient wonder at this towering five-star Fairmont retreat, ideally perched along the banks of the River Nile. Striking a picture of allure against the Cairo skyline and boasting a rooftop pool offering panoramic views of the Great Pyramid of Giza on the horizon, the hotel exudes Egyptian charm and luxury. You can spend your days unwinding in the plush, well-appointed rooms or embark on a gastronomic journey across the hotel's six dining venues, or savour a cocktail at the onsite bars. If you're looking to destress, head to the lavish Fairmont Spa for restorative treatments.",
          "image": "https://images.luxuryescapes.com/jkj7e6ophwwosodoodjn",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cairo",
            "addressCountry": "Egypt"
          },
          "priceRange": "$170",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 170,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cairo"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 4,
    "bestRating": "5",
    "worstRating": "1"
  }
