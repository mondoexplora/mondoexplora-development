11:Tf3e,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Minnesota",
  "description": "Discover the best hotels in Minnesota, United States. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United States"
  },
  "url": "https://mondoexplora.com/en/destination/minnesota",
  "image": "https://images.luxuryescapes.com/3b4ti429g4ad9s1fdodta",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Minnesota",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in lakeside luxury of The Hotel Landing, a stylish retreat nestled in the heart of Wayzata, just minutes from downtown Minneapolis. This chic boutique hotel offers an exquisite blend of comfort and sophistication, with Lake Minnetonka's sparkling waters just a stone's throw away. Indulge in the culinary delights of the on-site ninetwentyfive restaurant or explore the vibrant local dining scene. Venture out on a leisurely stroll along the picturesque Lake Street and return to the relaxing sanctuary of Läka Spa to unwind as you please.",
          "image": "https://images.luxuryescapes.com/3b4ti429g4ad9s1fdodta",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Minnesota",
            "addressCountry": "United States"
          },
          "priceRange": "$266",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 266,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/minnesota"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the grandeur of Minnesota with a sophisticated stay at this luxurious urban retreat, nestled in the heart of Eagan in downtown Minneapolis. A perfect base for both shopping and sporting enthusiasts, take advantage of this Nordic-inspired hotel's enviable location, lying adjacent to the headquarters of the Minnesota Vikings and only a short drive from The Mall of America and other boutiques. After a long day of city exploration, return to your chic abode and savour locally-inspired cuisine at the award-winning Kyndred Hearth restaurant and sip on ingredient-forward cocktails at the eclectic Ember & Ice lounge, overlooking the training facilities of the Vikings', complete with multiple TVs for tuning into live match entertainment. For a spot of relaxation, head to the spa for some much-needed pampering and cool off with a swim in the year-round indoor pool.",
          "image": "https://images.luxuryescapes.com/h1war054cp1bxy4rqfyb",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Minnesota",
            "addressCountry": "United States"
          },
          "priceRange": "$143",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 143,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/minnesota"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
