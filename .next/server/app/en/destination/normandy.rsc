12:T9e0,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Normandy",
  "description": "Discover the best hotels in Normandy, France. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "France"
  },
  "url": "https://mondoexplora.com/en/destination/normandy",
  "image": "https://images.luxuryescapes.com/qqlz29ubdow3vzhz73of",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Normandy",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Leave it all behind for the glorious French countryside, staying in palatial luxury at Château d’Audrieu - part of the prestigious Relais & Châteaux collection. A jewel at the heart of Normandy, this grand five-star hotel is just a 30-minute drive from the seaside and D-Day beaches, and 20 minutes from Bayeux, home of the legendary Bayeux tapestry. Nestled within 25 acres of parkland, this spectacular historic chateau, which dates back to 1715, invites you to step back in time to the French Regency era. Fine gastronomy is served beneath glittering chandeliers and luxurious treatments are delivered at the Spa by Sothys. The splendour doesn’t stop in the gilt-trimmed halls: a stroll through the grounds unveils a heated swimming pool at the edge of the forest and a collection of beautifully manicured gardens, including a French formal garden, rose garden and vegetable garden. There is no finer place to immerse yourself in the famous French joie de vivre.",
          "image": "https://images.luxuryescapes.com/qqlz29ubdow3vzhz73of",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Normandy",
            "addressCountry": "France"
          },
          "priceRange": "$316",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 316,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/normandy"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
