13:Te26,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Philadelphia",
  "description": "Discover the best hotels in Philadelphia, United States. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United States"
  },
  "url": "https://mondoexplora.com/en/destination/philadelphia",
  "image": "https://images.luxuryescapes.com/f5znkq5lmd2tjwpb1vm",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Philadelphia",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the allure of the City of Brotherly Love from this central sanctuary, situated in the heart of the city's vibrant Rittenhouse Square district. Savour gourmet dining at Chez Colette, renowned for its fusion of French and American cuisine, or sip on expertly crafted cocktails at Liberte Urban Chic Lounge, When you're ready to explore, find yourself within easy reach of Philadelphia's famed landmarks, including the Liberty Bell, Independence Hall, and the Philadelphia Museum of Art. The hotel is also a short stroll from the city's premier shopping district, offering a plethora of high-end boutiques and designer stores.",
          "image": "https://images.luxuryescapes.com/f5znkq5lmd2tjwpb1vm",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Philadelphia",
            "addressCountry": "United States"
          },
          "priceRange": "$199",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 199,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/philadelphia"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the City of Brotherly Love with ease at Kimpton Hotel Palomar Philadelphia, an IHG Hotel in the heart of Center City, Philadelphia. Ride a custom-designed bike to the historic Liberty Bell, climb the Rocky Steps at the Philadelphia Museum of Art, or stroll the leafy avenues of University City. Reset between adventures with a state-of-the-art fitness centre and yoga mat in each room. Unwind in style with a hosted wine hour in the evening, then recline with in-room dining from Square 1682.",
          "image": "https://images.luxuryescapes.com/ay5a8mxvuwibs8hr0q6e",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Philadelphia",
            "addressCountry": "United States"
          },
          "priceRange": "$154",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 154,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/philadelphia"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
