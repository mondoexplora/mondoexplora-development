11:T1164,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Hayman Island",
  "description": "Discover the best hotels in Hayman Island, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/hayman-island",
  "image": "https://images.luxuryescapes.com/n3rra26xcl44biy66axs",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Hayman Island",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "A jewel on the shores of the sun-drenched Whitsundays, this award-winning resort boasts breathtaking natural beauty on its doorstep. An icon of island luxury with direct access to the shimmering waters of the Great Barrier Reef, this magnificent resort invites you to take a dip in one of Australia’s largest swimming pools or recline in a private pool cabana overlooking azure ocean waters. Catering to those who appreciate the finer things, InterContinental Hayman Great Barrier Reef boasts five diverse dining options, ranging from the signature ocean-facing restaurant, Pacific, to Mediterranean-influenced Amici. Unwind at the world-class Hayman Spa & Salon - which exudes tranquillity from the moment you enter, or find a private spot to admire the captivating sunsets that transform the sky each evening. When adventure calls, step outside the resort to find yourself in the heart of the UNESCO World Heritage-listed Great Barrier Reef. Glide through the crystal-clear waters on a kayak or embark on a blue pearl hike to reach breathtaking panoramic views. Whether you're looking for a romantic escape or that dreamy setting for a family trip, this world-class resort is where core memories are made.",
          "image": "https://images.luxuryescapes.com/n3rra26xcl44biy66axs",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hayman Island",
            "addressCountry": "Australia"
          },
          "priceRange": "$1569",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 1569,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hayman-island"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Located on the shores of the sunkissed Whitsundays, InterContinental Hayman Island Resort is a jewel surrounded by breathtaking natural beauty. An icon of island luxury with direct access to the shimmering waters of the Great Barrier Reef, this magnificent resort invites you to take a dip in one of Australia's largest swimming pools or recline in a private pool cabana overlooking shimmering ocean waters. Unwind in the tranquil embrace of the onsite spa, savour gourmet delights at four distinct dining venues and be captivated by the mesmerising sunsets that paint the sky each evening.Whether you’re looking for out-of-this world diving, a romantic escape or a dreamy setting for a family trip, this world-class resort is where travel memories are made.",
