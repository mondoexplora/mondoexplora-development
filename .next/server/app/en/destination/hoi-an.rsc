12:T219c,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Hoi An",
  "description": "Discover the best hotels in Hoi An, Vietnam. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Vietnam"
  },
  "url": "https://mondoexplora.com/en/destination/hoi-an",
  "image": "https://images.luxuryescapes.com/zhrbgth3hm4ocx6jxxf",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Hoi An",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "An escape to Hoi An’s enchanting Ancient Town beckons with a stay at this elegant retreat, where Vietnamese charm meets refined Art Nouveau design. Just steps from the Thu Bon River and the lantern-lit lanes of the UNESCO-listed Old Town, this sanctuary blends cultural discovery with five-star comfort, boasting romantic decor inspired by the 17th‑century love story of Japanese merchant Sotaro and Vietnamese Princess Wakaku. Make the most of the hotel's premium facilities with endless laps in the rooftop pool, indulgent spa treatments and delectable dining. Savour mouthwatering Japanese at Wakaku or opt for local flavours at Faifo Cafe before enjoying sunset tipples at one of three onsite bars. Spend days cycling over bridges and let the lantern-lit rivers guide your travels. Find yourself at the night market browsing hundreds of diverse vendors, stumble upon charming tea houses and lose yourself among the city’s age-old facades. End each day in paradise by ascending to The Deck - the highest rooftop bar and lounge in Hoi An - where spectacular views of the Thu Bon River beckon.",
          "image": "https://images.luxuryescapes.com/zhrbgth3hm4ocx6jxxf",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hoi An",
            "addressCountry": "Vietnam"
          },
          "priceRange": "$419",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 419,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hoi-an"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Modern luxury meets ancient traditions at this sophisticated stay just moments from the UNESCO heritage-listed Hoi An Ancient Town. With a sparkling pool at its centre, five diverse eateries, a serene day spa and sauna, a fitness centre and an exclusive cinema room, days spent in the resort are just as colourful as those exploring Hoi An. Start your day with a delicious buffet breakfast before unearthing lantern-lit alleys, humming street markets and historic buildings. You'll be spoilt for choice between lunch or dinner at Swim City's laid-back poolside setting, BANG HUU's artisanal coffee shop or XUA & NAY's relaxed urban bistro. Wafaifo Resort Hoi An’s contemporary architecture, sprinkled with traditional Vietnamese motifs, provides the ultimate oasis amid an energetic city. The serenity continues to the onsite spa, where a tension-melting massage will cap off the perfect stay.",
          "image": "https://images.luxuryescapes.com/rdkchvegojrjxaeupjj9",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hoi An",
            "addressCountry": "Vietnam"
          },
          "priceRange": "$509",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 509,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hoi-an"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Bask in the luxury of Bliss Hoi An Beach Resort & Wellness, located alongside the picturesque Binh Minh beach. This hidden gem is a wellness paradise, enveloped by lush tropical gardens and direct beach access and offering high-quality spa treatments and revitalising yoga and Tai Chi classes. Savour the finest Vietnamese delicacies at the exclusive restaurant and embark on private tours to discover the hidden gems of Hoi An and its ancient surroundings.",
          "image": "https://images.luxuryescapes.com/dkgsrjwqkqrfcvpxmchk",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hoi An",
            "addressCountry": "Vietnam"
          },
          "priceRange": "$92",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 92,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hoi-an"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Step through traditional Vietnamese doors to discover this serene retreat where a sprawling pool flows among palm-fringed gardens, framed by a long stretch of pristine private beach. Lose track of time while gliding through the water on a kayak, escape to the ultra-tranquil Victoria Spa for a treatment or catch a film at the onsite cinema. Savour Asian and European dishes at the L’Annam Restaurant, unwind poolside with a tropical tipple from Faifo Bar or enjoy a game of billiards at Elephant Bar. When it’s time to venture into town, the quaint streets and canals of the UNESCO heritage-listed Hoi An Ancient Town are just 15-minutes away.",
          "image": "https://images.luxuryescapes.com/96rn2d5a4j5dccauwbu",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hoi An",
            "addressCountry": "Vietnam"
          },
          "priceRange": "$92",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 92,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hoi-an"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Retreat to the banks of the Hoai River at this enchanting escape designed to embrace the very best of this vibrant Vietnamese town. With hints of local architecture intertwined with sleek modern features, this charming hotel is the perfect riverside abode, just minutes from the UNESCO World Heritage Site of Hoi An Ancient Town. Savour Mediterranean flavours at the onsite restaurant, sip cocktails by the pool and take a moment of rest at Breathe Spa - here, there's no reason to rush.",
          "image": "https://images.luxuryescapes.com/e060g5aee1mjsbuoulni",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Hoi An",
            "addressCountry": "Vietnam"
          },
          "priceRange": "$125",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 125,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/hoi-an"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 5,
    "bestRating": "5",
    "worstRating": "1"
  }
