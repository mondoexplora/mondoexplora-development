11:T268e,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Launceston",
  "description": "Discover the best hotels in Launceston, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/launceston",
  "image": "https://images.luxuryescapes.com/avq9mav02tan71mmpcdm",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Launceston",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience Tasmania’s lush valleys, gourmet produce and breathtaking landscapes from your base at Hotel Grand Chancellor Launceston, a charming 4.5-star hotel with an iconic heritage façade. During your stay, drop in at the onsite Avenue Restaurant and feast on some of Tasmania’s freshest local produce, while evenings are for a quiet drink at the bar - choose from handcrafted cocktails and Tasmanian wines, ciders, gins and whiskies. You’re perfectly placed to explore the city and its excellent eateries, shops and cafés. Take a stroll down Brisbane Street Mall, see a live sports match at Aurora Stadium and enjoy a pint and a tour at James Boag's Brewery. What’s more, the picturesque Tamar Valley and its renowned wineries, charming villages and local producers (think artisanal cheese, fresh cherries and truffles), is just a 30-minute drive away.",
          "image": "https://images.luxuryescapes.com/avq9mav02tan71mmpcdm",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Launceston",
            "addressCountry": "Australia"
          },
          "priceRange": "$55",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 55,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/launceston"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Explore the rich history and vibrant culture of Tasmania with a stay at this centrally located Launceston property. This elegant hotel is perfectly positioned in the heart of Launceston, a stone's throw from the city's iconic landmarks, including the Queen Victoria Museum at Inveresk and the hiking trails of Cataract Gorge. Plus, the Tamar Valley wine region is just a 30-minute drive away. Back at the hotel, enjoy a drink at the Titanium Bar & Bistro or indulge in a gourmet meal cooked to perfection. The hotel is also a neighbour to the marvellous City Park so take advantage and indulge in a leisurely stroll.",
          "image": "https://images.luxuryescapes.com/o3l10bqn9z8nociicti",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Launceston",
            "addressCountry": "Australia"
          },
          "priceRange": "$74",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 74,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/launceston"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Revel in the fusion of history and modern luxury at this lavish hotel housed in a superbly converted series of 1960s grain silos and majestically positioned on the banks of the Tamar River in Launceston's Inveresk precinct. Relax and unwind in the sophisticated rooms designed within the historical silos and savour farm-to-table dining at the Grain of the Silos restaurant. Overlooking Cataract Gorge, Seaport and Royal Park, the nine-storey hotel is a stone's throw from the heart of Launceston. Take a leisurely walk along the riverfront boardwalk, visit the nearby Queen Victoria Museum, or return to your abode and pamper yourself with restorative treatments at the Silo Day Spa.",
          "image": "https://images.luxuryescapes.com/5ymdhvaoscqve8zudi6b",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Launceston",
            "addressCountry": "Australia"
          },
          "priceRange": "$130",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 130,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/launceston"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the charm of Launceston with a stylish stay perfectly positioned on the city's vibrant waterfront. On the site of an old dry dock, overlooking the Tamar River Basin and Royal Park, the hotel is just a short stroll from the heart of Launceston's cultural precinct, filled with historic buildings, boutiques and eateries. Dine at the onsite restaurant, Mudbar, offering a fusion of Asian and modern Australian cuisine, or explore the nearby Cataract Gorge, a natural wonderland of walking trails, gardens and wildlife. The hotel is also a short drive from the Tamar Valley wine region, home to some of Tasmania's finest vineyards.",
          "image": "https://images.luxuryescapes.com/vkoo0pn9lv5xdwfklg2r",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Launceston",
            "addressCountry": "Australia"
          },
          "priceRange": "$128",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 128,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/launceston"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Picture a blend of sprawling resort gardens, immaculate golfing greens, natural scenery and endless activities set across 300 acres of lush parkland. All this and more awaits at this countryside resort, making it the ultimate destination for the perfect combination of adventure and relaxation. Indulge to the max at the onsite pool and sauna, spot wildlife right from your cosy room or suite, explore scenic horse-riding trails or easily venture into the heart of Launceston for a day of discovery. At Country Club Tasmania, everything you need is within reach.",
          "image": "https://images.luxuryescapes.com/2lx3a7u5qq0w8umaupd",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Launceston",
            "addressCountry": "Australia"
          },
          "priceRange": "$75",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 75,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/launceston"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the charm of Tasmania's second-largest city with a stay in the heart of Launceston. You'll be perfectly placed to explore the city's vibrant culinary scene, with renowned eateries and the Tamar Valley wine route, home to over 30 wineries, just a short stroll away. Venture further to discover the breathtaking Cataract Gorge Reserve or the Queen Victoria Museum and Art Gallery. Back at the hotel, indulge in locally sourced cuisine at the onsite restaurant, The Charles, or relax in the comfort of your stylishly appointed rooms.",
          "image": "https://images.luxuryescapes.com/zd6oecaxxbol84839s52",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Launceston",
            "addressCountry": "Australia"
          },
          "priceRange": "$75",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 75,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/launceston"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 6,
    "bestRating": "5",
    "worstRating": "1"
  }
