11:Tf06,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Mahe",
  "description": "Discover the best hotels in Mahe, Seychelles. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Seychelles"
  },
  "url": "https://mondoexplora.com/en/destination/mahe",
  "image": "https://images.luxuryescapes.com/8xkdin75b2zs4654cgh",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Mahe",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Dive deep into a luxurious tropical paradise at Anantara Maia Seychelles Villas, an opulent getaway framed by breathtaking ocean and forest views. Enjoy true tranquility with a restorative treatment at Anantara Spa, where therapies include infusions of local herbs and fruits, or indulge in a tailored dining experience with the resort’s Dining by Design offering. For the wine connoisseurs, take your tastebuds on a journey at The Wine Boutique with a curated wine pairing menu.",
          "image": "https://images.luxuryescapes.com/8xkdin75b2zs4654cgh",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mahe",
            "addressCountry": "Seychelles"
          },
          "priceRange": "$2013",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 2013,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mahe"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover island luxury in the form of Kempinski Seychelles Resort, an indulgent escape surrounded by sparkling azure waters, expansive nature reserves and the white sands of the spectacular Baie Lazare. Situated on the south coast of Seychelles' largest island, the five-star resort is perfectly perched for enjoying all that the tropical paradise has to offer. The newly refurbished hotel boasts a contemporary design inspired by the island’s natural beauty, along with world-class facilities. Learn how to scuba dive in the on-site diving centre, soak up the sun on the secluded beach mere steps from your room, or marvel at the astounding marine life found in the house reef. Kids will be entertained at the Kids Club, while parents or honeymooners can indulge in a romantic private dining experience next to the Indian Ocean. With four distinct dining options and a sumptuous spa, you'll finish your holiday well fed, well watered and well rested.",
          "image": "https://images.luxuryescapes.com/97mh37eajhota1smfeg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mahe",
            "addressCountry": "Seychelles"
          },
          "priceRange": "$322",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 322,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mahe"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
