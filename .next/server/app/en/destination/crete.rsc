11:T2285,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Crete",
  "description": "Discover the best hotels in Crete, Greece. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Greece"
  },
  "url": "https://mondoexplora.com/en/destination/crete",
  "image": "https://images.luxuryescapes.com/1nmg8xjeejgui0s5oek",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Crete",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Step right into an island explorer’s dream with a picturesque stay in Crete's charming village of Plaka, overlooking Spinalonga Island and the turquoise expanse of the Aegean Sea. Situated near the popular tourist town of Elounda, you'll find uninterrupted bliss within moments of arriving: unwind beside the glimmering split-level infinity pool with a cocktail in hand, find a cosy sunbed on Plaka Beach or uncover new levels of rejuvenation with a tailored treatment at Armonia Spa. Relish gastronomic perfection at the resort’s various eateries and bars, set against a postcard-perfect Greek island backdrop, before calling it a day in your heavenly room or suite, complete with your own private pool. Wake up to the gentle sounds of the Aegean as the sun rises, promising another day of serenity.",
          "image": "https://images.luxuryescapes.com/1nmg8xjeejgui0s5oek",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Crete",
            "addressCountry": "Greece"
          },
          "priceRange": "$789",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 789,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/crete"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the epitome of Crete luxury with a stay at this beachfront oasis overlooking Mirabello Bay. Explore the charming coastal town of Agios Nikolaos, or venture further afield to Archanes, renowned for its vineyards and olive groves. Return to your tranquil base and take a dip in two glittering infinity pools which appear to merge harmoniously with the bay beyond, or simply savour a refreshing beverage at the hotel's onsite bars.",
          "image": "https://images.luxuryescapes.com/v3b2fyr61qf4gqtjhf6",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Crete",
            "addressCountry": "Greece"
          },
          "priceRange": "$156",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 156,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/crete"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Part of the Small Luxury Hotels of the World, these gorgeous clifftop Mediterranean suites and villas promise boutique elegance high above the shimmering waters of Mirabello Bay. With each villa boasting unrivalled privacy and breathtaking views over Crete, it's the perfect way to soak up the island's natural splendour. Savour farm-to-table cuisine at the Argo Restaurant, savour craft cocktails and fresh coffee at Argo Pool Bar, or head out on the complimentary shuttle to the resort's own private beach club for watersports or seaside drinks. Ready to unwind? Melt away with a therapeutic session at Elixir Spa. Venture out to explore the charming fishing village of Elounda, or visit the historic town of Agios Nikolaos, renowned for its vibrant nightlife and picturesque lake.",
          "image": "https://images.luxuryescapes.com/bdfjtxhxqr12qrca1efa",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Crete",
            "addressCountry": "Greece"
          },
          "priceRange": "$270",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 270,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/crete"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Greek island opulence awaits at Minos Beach Art Hotel, a chic five-star Crete oasis overlooking the glistening waterfront of Mirabello Bay. Adorned with a wealth of contemporary art and a façade of fuchsia blooms, this architectural retreat (part of the prestigious Design Hotels collections) balances minimalist design with maximum luxury. This is an ultra-modern oasis softening 2.5 kilometres of rugged Cretan coastline through its elegant assembly of waterfront accommodation and picturesque gardens. When you're not plunging into the sun-kissed ocean or sipping cocktails at the beachfront bar, choose to bask in the Greek heat on one of two private beaches or escape the rays with a stroll around the hotel's open-air art museum. Nourish your soul with authentic food and wine across three exceptional restaurants and indulge in a daily Kafeneion pick-me-up at the traditional coffee shop before curating your day in paradise. The onsite dive centre offers an array of activities for the adventurous, from windsurfing to waterskiing, while the wellness spa promises absolute bliss for those seeking relaxation.",
          "image": "https://images.luxuryescapes.com/a73hnlyuxg0rwl27w7l",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Crete",
            "addressCountry": "Greece"
          },
          "priceRange": "$276",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 276,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/crete"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Dive into seaside sophistication at this meticulously designed resort, complete with an Olympic-sized lagoon pool, the famed Minotaur restaurant showcasing original Picasso art, and the rejuvenating Elixir Alchemy Spa. Days are full of outdoor recreation, while evenings delight with live music and magnificent sunsets on the resort's private beach. Marvel at the classic Grecian architecture surrounding the resort or take in the historic white-washed churches in the nearby village of Gouves. Explore the vibrant waterfront restaurants and shops or take a trip further afield to ancient ruins and archaeological museums, ideal for learning about the rich history of this Mediterranean paradise.",
          "image": "https://images.luxuryescapes.com/gqg07xxgnt8ol0n5wfw",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Crete",
            "addressCountry": "Greece"
          },
          "priceRange": "$225",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 225,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/crete"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 5,
    "bestRating": "5",
    "worstRating": "1"
  }
}5:["$","main",null,{"className":"min-h-screen","children":[["$","$L10",null,{"pageType":"destination","destination":"Crete","country":"Greece","hotelCount":5,"minPrice":156}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],"$L12","$L13","$L14"]}]
