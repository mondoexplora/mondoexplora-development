  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Cradle Mountain",
  "description": "Discover the best hotels in Cradle Mountain, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/cradle-mountain",
  "image": "https://images.luxuryescapes.com/svqi0b4hnmzbh4ono7t",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Cradle Mountain",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Whisk away on a weekend of nature-filled romance with a tranquil stay in the mountains. Uncover a shining jewel deep in Tasmania's breathtaking Cradle Mountain wilds that puts picture-worthy views at the forefront of every experience. Far from the stressors of daily life, overlooking Cradle Mountain-Lake St Clair National Park in the World Heritage-listed Tasmanian Wilderness, you can find a harmonious blend of rustic charm and modern comfort in cozy cabins, timber-built suites and contemporary Pencil Pine Cabins. Strike a perfect balance between relaxation and adventure, with everything from bushwalks through the thriving reserves to steamy rejuvenation in the Waldheim Alpine Spa. Delve deeper into Tasmania’s abundant nature with a culinary experience like no other. Experience the Highland Restaurant's paddock-to-plate philosophy firsthand with a painstakingly prepared dinner and paired local wines. For something a little more casual, enjoy a hearty meal or warming nightcap at the lodge’s Tavern Bar & Bistro while overlooking the sprawling natural surrounds.",
          "image": "https://images.luxuryescapes.com/svqi0b4hnmzbh4ono7t",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cradle Mountain",
            "addressCountry": "Australia"
          },
          "priceRange": "$399",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 399,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/cradle-mountain"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Whisk away a special someone for some nature-filled romance with a tranquil stay at this stunning Cradle Mountain escape. Uncover a shining crown jewel deep in Tasmania's breathtaking alpine region with rustic charm and modern comfort in cosy cabins and timber-built suites. Enjoy everything from thrilling bushwalks through the thriving reserves to a moment of rejuvenation at the Waldheim Alpine Spa. Sample the Highland Restaurant's paddock-to-plate philosophy, or for something a little more casual, enjoy a hearty meal and warming nightcap at the lodge’s Tavern Bar & Bistro while overlooking sprawling natural beauty.",
          "image": "https://images.luxuryescapes.com/f5t3ybl6merjiwyylpsk",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Cradle Mountain",
            "addressCountry": "Australia"
