13:T1439,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Mooloolaba",
  "description": "Discover the best hotels in Mooloolaba, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/mooloolaba",
  "image": "https://images.luxuryescapes.com/9oa84gqre9c4lkzvudmg",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Mooloolaba",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Renowned as one of the best beaches in the South Pacific and just a short drive from the world-famous Australia Zoo, Mooloolaba is a must-visit destination along the Sunshine Coast. These self-contained apartments meld home-away-from-home comforts with luxury living, featuring private balconies or courtyards, floor-to-ceiling windows and modern kitchens bathed in natural sunlight. Onsite, you can swim laps in the pool and stay fit in the fitness centre, all just moments from the main thoroughfare, then toast your escape with wine on your private balcony. Your spacious apartment puts you within steps of the patrolled main beach, where white-sandy shores open up to rolling sapphire waves and delicious seaside fare lines the esplanade - perfect for a day spent in your included cabana. This sun-drenched destination offers access to some of Australia's best experiences, including Sea Life Sunshine Coast.",
          "image": "https://images.luxuryescapes.com/9oa84gqre9c4lkzvudmg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mooloolaba",
            "addressCountry": "Australia"
          },
          "priceRange": "$339",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 339,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mooloolaba"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the best of the Sunshine Coast with a stay along the beautiful Mooloolaba Beach. Perfectly positioned on the Esplanade, this beachfront retreat is a stone's throw from the vibrant Mooloolaba dining and shopping precinct and less than a 30-minute drive from Australia Zoo. With an outdoor pool, indoor heated pool, and a fabulous rooftop barbecue area, this escape offers a perfect blend of relaxation and activity.",
          "image": "https://images.luxuryescapes.com/xef0zpjzzrf6ho50ryt",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mooloolaba",
            "addressCountry": "Australia"
          },
          "priceRange": "$120",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 120,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mooloolaba"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the ultimate laidback escape at this five-star beachfront haven, ideally located on the sun-kissed shores of Mooloolaba Beach in Queensland's Sunshine Coast. This incredible high-rise retreat places the Mooloolaba Esplanade and its iconic beach at your fingertips with a list of facilities to keep you entertained, including an outdoor pool and spa, gym, steam room and a movie theatrette. Plunge into this postcard-perfect location from your luxurious apartment and you'll never want to leave.",
          "image": "https://images.luxuryescapes.com/ahz2u9ttpg0y2j81kg6p",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mooloolaba",
            "addressCountry": "Australia"
          },
          "priceRange": "$737",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 737,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mooloolaba"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
