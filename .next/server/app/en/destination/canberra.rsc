12:T4425,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Canberra",
  "description": "Discover the best hotels in Canberra, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/canberra",
  "image": "https://images.luxuryescapes.com/gr3wudfdcszz5knz9g6p",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Canberra",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Soak up Canberra’s impressive cultural experiences, top-notch restaurants and burgeoning art scene with a central city stay at this welcoming heritage-listed hotel. Originally opened in 1927 and listed on the Register of the National Estate, the Mercure Canberra is part of the capital's rich history. Use this conveniently located abode as your home base while exploring treasures like the Australian War Memorial or Old Parliament House. Boasting outstanding service, superb old-world charm and a welcoming atmosphere, guests of this iconic Canberra institution are guaranteed a relaxing retreat.",
          "image": "https://images.luxuryescapes.com/gr3wudfdcszz5knz9g6p",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$159",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 159,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/canberra"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Tucked away among the NewActon precinct's stylish bars, glam restaurants and quirky entertainment venues, Canberra’s hidden gem sets the standard for pure comfort. The hotel's unique 'gallery' theme ensures a one-of-a-kind stay, with a sculpture garden that spills into the foyer and art installations that turn corridors into creative spaces. Take in the full Canberra experience with tailored culinary moments and immersive cultural experiences on your doorstep, with your hotel located near Lake Burley Griffin and within walking distance of Parliament House. Indulge in a bespoke gourmet experience at the hotel's renowned Canberra institution, the acclaimed Italian trattoria, Bicicletta.",
          "image": "https://images.luxuryescapes.com/hplxgtttio74of72kisj",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$209",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 209,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/canberra"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in the wonder of Australia’s capital with a glamorous stay at A by Adina Canberra in the heart of the city. Designed by award-winning architects Bates Smart, the beautiful sculptural exterior impresses while the warm, plush interiors are ideal for relaxation after days exploring the ACT’s many museums, parks and cultural sites. Keep up your fitness regime in the hotel’s gym, or treat yourself to a series of delectable dishes and cocktails at one of the esteemed venues next door.",
          "image": "https://images.luxuryescapes.com/zphlmslzxmiy552m09",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$139",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 139,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/canberra"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Treat yourself to a relaxing city stay at Abode Belconnen, a boutique retreat bordering the beautiful Lake Ginninderra in Canberra's north-west. Located in the picturesque suburb of Belconnen, only 20 minutes from the Australia Capital Territory's iconic attractions, this stylish apartment hotel is the perfect launchpad for exploring the very best of Canberra - including the National Gallery of Australia and Parliament House - and relaxing after adventure-filled days. Great for long or short stays, each stylishly appointed studio or apartment features a kitchenette, laundry facilities and TV with STAYCAST streaming. For wholesome food, you needn't go far, with Westfield Belconnen less than a 15-minute walk away, and the sophisticated No.10 Restaurant + Bar and the convenient Abode Pantry - stocked with healthy frozen meals and drinks - onsite. Plus, there's a foyer lined with retro-inspired bikes - perfect for an afternoon cycling around the Lake Ginninderra circuit.",
          "image": "https://images.luxuryescapes.com/nbgh266m6ao5htdeam3",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$86",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 86,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/canberra"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Escape to the nation’s capital with a stylish stay at the Rydges Canberra - a charming retreat ideally located in the Parliamentary Triangle of Canberra. Sneak away for a relaxing escape in a burgeoning destination packed with upscale eateries, microbreweries, indulgent wine and cocktail bars and award-winning coffee roasters, then tap into the history of the country, with top attractions including Parliament House, the National Gallery of Australia and the National Portrait Gallery all within close reach. When you return after a day of exploring, relax at The George Bar with a signature cocktail or let yourself be taken on a culinary journey at The George Grill.",
          "image": "https://images.luxuryescapes.com/56q3ask3asfmbx23bp8v",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$84",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 84,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/canberra"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Find yourself mere moments from the vibrant Canberra CBD with a stay at this sleek abode, perfectly positioned in the heart of the city. The modern hotel boasts lavish rooms as well as self-contained apartments tailored to your comforts and is within easy access of cultural landmarks, including Parliament House, the Australian War Memorial and the National Gallery of Australia. Swim laps in the indoor heated pool, relax in the sauna and tuck into sumptuous food at the Stock Bar & Kitchen. If you wish to explore, take a short stroll to reach Braddon district, renowned for its artisan coffee shops and innovative modern Australian eateries.",
          "image": "https://images.luxuryescapes.com/b8one1kyxoema2ekpr2l",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$66",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 66,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/canberra"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Soak up Canberra’s impressive cultural experiences, top-notch restaurants and burgeoning art scene with a central city stay at this welcoming, heritage-listed hotel, located on the eastern edge of stylish Braddon. Originally opened in 1927 and listed on the Register of the National Estate, the Mercure Canberra is part of the capital's rich history. From your conveniently located abode, mere moments from the CBD and vibrant New Acton precinct, it's easy to explore treasures like the National Gallery of Australia, the War Memorial or Old Parliament House.",
          "image": "https://images.luxuryescapes.com/qz307fue8nuomy8358hi",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$74",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 74,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/canberra"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Take in the best of Australia’s tranquil capital with a stay at the contemporary Crowne Plaza Canberra, an IHG Hotel. Perfect for business travellers or a romantic city escape, the hotel creates a welcoming atmosphere with an ideal CBD location close to the museums and galleries, the bustling shopping district and an array of vibrant restaurants and bars. Take a relaxing short drive through Canberra’s iconic wine region and explore charming towns like Bungendore, Gundaroo and Murrumbateman, along with stunning local vineyards and sophisticated cellar doors. After a long day of discovery, grab a decadent dinner at the hotel’s Redsalt Restaurant, serving up modern Australian fare, before relaxing with an evening cocktail in hand.",
          "image": "https://images.luxuryescapes.com/muy4jzuiqc2y6xxwq3mn",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$87",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 87,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/canberra"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Cast your vote for a sophisticated stay on the edge of Canberra’s political stage, near eclectic cinemas, iconic monuments and the city’s vibrant dining scene, at the timelessly elegant Abode Kingston. Stamped with a Tripadvisor Travellers' Choice 2020 badge, this modern boutique hotel’s star feature is its location in one of the city’s most desirable postcodes, Kingston - a short bike ride from Capital Hill, less than a 15-minute walk from the reinvigorated Kingston Foreshore, and enviably close to the area’s café culture hub, Parliament House and the National Gallery. So much more than your ordinary Canberra accommodation, this hotel fuses stylish décor with moody ambience and designer-cool rooms and studios. There's the convenient Abode Pantry, stocked with healthy frozen meals, drinks, midnight snacks and more onsite, and a hotel foyer lined with retro-inspired bikes along one wall. Feel like a Kingston local as you delve into this political playground of foodie delights, arts, culture and history, before returning to your ultimate city abode. **Luxury Escapes inclusions (select nights)** - A **welcome bottle of wine** to toast to your sophisticated Kingston escape - **Daily in-room bottled water** for the morning after a night on the town - **Guaranteed 11am checkout** to make the most of your stay - Stay connected with **complimentary Wi-Fi** throughout - **Two-hour bike hire** per person, per stay, to help you explore the city (for stays of 2+ nights) - **A$15 food and drink credit** per package, per stay to use at the onsite Abode Pantry (for stays of 2+ nights) - An **additional A$5 (A$20 total) food and drink credit** per package, per stay (for stays of 3+ nights) - An **additional A$5 (A$25 total) food and drink credit** per package, per stay (for stays of 4+ nights) - An **additional A$5 (A$30 total) food and drink credit** per package, per stay (for stays of 5+ nights) **Need more space?** Upgrade to the Executive Studio, offering a sofa bed for one extra guest (charges apply).",
          "image": "https://images.luxuryescapes.com/mqttkh555j5n8ct7vvaj",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$92",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 92,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/canberra"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in Australia's intimate and cultured capital city with a stylish lakeside stay at a beautifully appointed property near Lake Ginninderra. Make use of the hotel's fitness centre or savour a meal at Selection Bistro, located in the adjoining Canberra Labor Club. Venture out to discover the city's iconic landmarks, including the Australian War Memorial and the National Gallery, or indulge in retail therapy at world-class shopping centres. For nature enthusiasts, scenic national parks beckon, while sports aficionados will appreciate proximity to major stadiums.",
          "image": "https://images.luxuryescapes.com/im46o5y62pjot3g8etu",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Canberra",
            "addressCountry": "Australia"
          },
          "priceRange": "$75",
