11:T1026,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "San Antonio",
  "description": "Discover the best hotels in San Antonio, United States. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United States"
  },
  "url": "https://mondoexplora.com/en/destination/san-antonio",
  "image": "https://images.luxuryescapes.com/86mffcqw3c9ughnw476n",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in San Antonio",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Soak up the charms of a Spanish-style grand hacienda, perched on the banks of the vibrant River Walk in downtown San Antonio's heart. Find yourself within easy reach of some of the city's best shopping, dining and entertainment hubs, hop on a river cruise and explore historical sites like the Alamo - whatever you wish, the hotel's prime location makes it an ideal base. To unwind, take a stroll along the River Walk or swim laps or lounge by the serene courtyard pool. When hunger strikes, savour South Texan cuisine with Latin and French influences at Four Brothers and sip on exquisite margaritas at El Colegio. Take relaxation to the next level with a restorative treatment at Mokara Spa.",
          "image": "https://images.luxuryescapes.com/86mffcqw3c9ughnw476n",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "San Antonio",
            "addressCountry": "United States"
          },
          "priceRange": "$183",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 183,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/san-antonio"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Step into an inviting world infused with Southern charm, offering a balance of upscale elegance, rejuvenating spa facilities and genuine hospitality. Situated in close proximity to San Antonio's River Walk, a landmark pedestrian promenade lined with quaint cafes and shops, you will leave feeling pampered after wellness sessions in the dry sauna and eucalyptus-infused steam room. Picture yourself lounging out by the rooftop pool or sipping cocktails while taking in the city's buzzing ambience. When hunger strikes, dine your way through the three onsite restaurants, from the Oyster Bar at Ostra to the combination of South Texas, Latin and French cuisine at Four Brothers. Discover San Antonio's rich variety of cultural gems such as the Alamo, where pivotal events in Texan history unfolded, and the lively Pearl District, known for its eclectic dining options, weekly farmers market and amphitheatre, providing a lively backdrop for live music and events.",
          "image": "https://images.luxuryescapes.com/yszlbqktwtrq3phhxe",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "San Antonio",
            "addressCountry": "United States"
          },
          "priceRange": "$247",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 247,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/san-antonio"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
