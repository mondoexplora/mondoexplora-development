11:T1a06,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Jeddah",
  "description": "Discover the best hotels in Jeddah, Saudi Arabia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Saudi Arabia"
  },
  "url": "https://mondoexplora.com/en/destination/jeddah",
  "image": "https://images.luxuryescapes.com/21hcr3hlpih7q9uu5m7",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Jeddah",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the vibrant heart of Jeddah in style at the elegant residence in town. Just 51 minutes from King Abdulaziz International Airport and the scenic Jeddah Corniche, this modern hotel offers spacious rooms with all the comforts you need-minibar, AC and more. Unwind at the rooftop pool, indulge in spa treatments, or enjoy international cuisine at Palm Restaurant. Perfect for business or leisure, the hotel features sleek meeting rooms and is a short drive from top attractions like the iconic Jeddah Tower, King Fahd’s Fountain and Red Sea Mall. Whether you're exploring the historic charm of Old Jeddah or relaxing seaside, this is your gateway to the city’s best.",
          "image": "https://images.luxuryescapes.com/21hcr3hlpih7q9uu5m7",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Jeddah",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$93",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 93,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/jeddah"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Enjoy a luxurious city retreat on the coast of Saudi Arabia and take in stunning views of the Red Sea at InterContinental Jeddah, an IHG Hotel. Overlooking the Jeddah Corniche and King Fahad's Fountain, and close to historic locations and shopping areas, this is the perfect base from which to explore this cosmopolitan city. Be spoilt for choice when dining at one of the five restaurants onsite, cool off by plunging in the outdoor pool or relax in a stylish and comfortable room or suite.",
          "image": "https://images.luxuryescapes.com/vqlctddji9lcbhq2rhc5",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Jeddah",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$149",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 149,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/jeddah"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience true modern comfort at this stylish oasis, ideally located on Jeddah's bustling Malik Road. Dive into the city's history at the nearby Al-Balad district, a UNESCO World Heritage site, or indulge in a shopping spree at the upscale Mall of Arabia. At the end of the day, retreat to your spacious retreat, complete with a kitchenette and stunning vistas. Continue the indulgence by the sunlit rooftop pool, indulge in relaxing spa treatments and sample international flavours at Ibis Kitchen. Whether you’re exploring the historic charm of Old Jeddah or relaxing seaside, this is your gateway to the city’s best, with the comforts of home back to return to each day.",
          "image": "https://images.luxuryescapes.com/onztyu5fq4lhb3uas4r",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Jeddah",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$94",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 94,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/jeddah"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "The magic of Jeddah awaits with a five-star stay at this sleek Mövenpick retreat, ideally located near vibrant shopping districts, the historic Al-Balad and modern attractions like teamLab Borderless. When you're not out exploring, unwind with a massage, take a dip in the rooftop pool or sip a mocktail while soaking in views of the port city skyline. Savour a variety of international flavours at Al Deira, the hotel's all-day dining restaurant offering everything from buffet spreads to themed nights. For a more relaxed dining experience, Al Moltaqa Café serves afternoon tea and light treats in a regal, 16th-century-inspired setting.",
          "image": "https://images.luxuryescapes.com/rck90hscx4z0v2e96ok",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Jeddah",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$87",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 87,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/jeddah"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 4,
    "bestRating": "5",
    "worstRating": "1"
  }
