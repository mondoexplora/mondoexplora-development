  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Washington DC",
  "description": "Discover the best hotels in Washington DC, United States. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United States"
  },
  "url": "https://mondoexplora.com/en/destination/washington-dc",
  "image": "https://images.luxuryescapes.com/zxb471hhklyhf6grckgd",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Washington DC",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in America's esteemed history with a stay at Kimpton George Hotel, an IHG Hotel, located in the renowned Capitol Hill district. Learn more about the political heritage of Washington DC in the heart of downtown with access to iconic landmarks like the Capitol Building, Washington Monument and the Lincoln Memorial. After a day of exploration, fuel up at the onsite Bistro Bis or stretch your muscles in the fitness centre before turning into your heritage-themed room.",
          "image": "https://images.luxuryescapes.com/zxb471hhklyhf6grckgd",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Washington DC",
            "addressCountry": "United States"
          },
          "priceRange": "$144",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 144,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/washington-dc"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Take your place among dignitaries and diplomats with a stay at this prestigious hotel, situated in the heart of Washington DC's vibrant downtown district. This opulent retreat is a stone's throw from the White House, the National Mall and the Smithsonian Museums, placing you at the epicentre of American history and culture. Savour French-American cuisine at the onsite Opaline Bar & Brasserie, or venture out to explore the city's diverse culinary scene. The hotel's state-of-the-art fitness centre and tranquil spa offer the perfect respite after a day of sightseeing.",
          "image": "https://images.luxuryescapes.com/anz6psx1ii57xidseyq",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Washington DC",
            "addressCountry": "United States"
          },
          "priceRange": "$236",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 236,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/washington-dc"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in a captivating fusion of history and contemporary elegance at Kimpton Hotel Monaco Washington DC, an IHG Hotel, nestled in the vibrant Penn Quarter. Explore iconic landmarks of the nation's capital, indulge in a vibrant shopping, dining, and nightlife scene, and enjoy seamless access to public transport. After a busy day exploring, delight in a selection of share plates and expertly crafted cocktails at the onsite Dirty Habit restaurant and bar.",
          "image": "https://images.luxuryescapes.com/3abdpaiqgk8yvtrysj5u4",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Washington DC",
            "addressCountry": "United States"
          },
          "priceRange": "$162",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 162,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/washington-dc"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
