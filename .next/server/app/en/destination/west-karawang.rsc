13:T9dc,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "West Karawang",
  "description": "Discover the best hotels in West Karawang, Indonesia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Indonesia"
  },
  "url": "https://mondoexplora.com/en/destination/west-karawang",
  "image": "https://images.luxuryescapes.com/eraexpcyx6g0lbbp2s9zi",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in West Karawang",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Immerse yourself in the rich culture of Indonesia with a stay at this chic hotel located in the heart of Karawang, steps from Karawang Central Plaza. This elegant retreat is perfectly positioned for exploring the city's vibrant markets, historic temples and lush botanical gardens. Savour the flavours of authentic Indonesian cuisine at Kemuning Restaurant, Japanese fusion at Kunoichi Japanese Restaurant, or relax with a drink at the sophisticated Voula Lounge & Bar. Unwind after a productive day in a refreshing swimming pool, let little ones explore the Kids Zone or splash into fun at Wonderland Adventure Waterpark - a stone's throw away. The hotel's state-of-the-art fitness centre and tranquil spa offer a sanctuary for relaxation and rejuvenation. With direct access to a shopping mall and exciting city excursions available, this retreat offers a seamless stay where business meets pleasure in the heart of West Java.",
          "image": "https://images.luxuryescapes.com/eraexpcyx6g0lbbp2s9zi",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "West Karawang",
            "addressCountry": "Indonesia"
          },
          "priceRange": "$34",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 34,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/west-karawang"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 1,
    "bestRating": "5",
    "worstRating": "1"
  }
