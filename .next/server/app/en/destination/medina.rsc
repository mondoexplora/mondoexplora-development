12:Te29,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Medina",
  "description": "Discover the best hotels in Medina, Saudi Arabia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Saudi Arabia"
  },
  "url": "https://mondoexplora.com/en/destination/medina",
  "image": "https://images.luxuryescapes.com/mj5huzxm6c835hyujb0m",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Medina",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "In the heritage heart of Medina, Crowne Plaza Madinah, an IHG Hotel, is the perfect place to rest your head. Close to the Prophet's Mosque and with a free shuttle direct to the entrance of Al Masjid an Nabawi, this hotel is an especially convenient staging point within the Muslim-only centre of this sacred city. Savour Saudi specialties and international dishes at the Al Rawdah restaurant or venture out into marvellous Medina for restaurants, markets and shopping malls.",
          "image": "https://images.luxuryescapes.com/mj5huzxm6c835hyujb0m",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Medina",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$100",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 100,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/medina"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Embrace the spiritual rhythm of Saudi Arabia's Madinah from this modern sanctuary, perfectly located just a short walk from the striking Prophet’s Mosque, one of the holiest sites in Islam. Step inside to discover elegant rooms with family-friendly layouts and thoughtful amenities, plus sweeping views of the Haram courtyard. When hunger strikes, savour authentic Saudi cuisine and international flavours at Al Salam restaurant, dine on healthy meals at The Lounge Restaurant and indulge your sweet tooth with Mövenpick's daily signature chocolate hour. With direct access to Anwar Al Madinah Mall and unrivalled proximity to the gates of the mosque, this is the perfect base for all your Madinah explorations.",
          "image": "https://images.luxuryescapes.com/1d4wu1coxgp1gastfeaw",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Medina",
            "addressCountry": "Saudi Arabia"
          },
          "priceRange": "$194",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 194,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/medina"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
