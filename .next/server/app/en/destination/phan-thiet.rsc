12:Ted0,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Phan Thiet",
  "description": "Discover the best hotels in Phan Thiet, Vietnam. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Vietnam"
  },
  "url": "https://mondoexplora.com/en/destination/phan-thiet",
  "image": "https://images.luxuryescapes.com/5haebvsm5cl2op500itr",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Phan Thiet",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Between famous red and white sand dunes overlooking the shining waters of the South China Sea lies Anantara Mui Ne Resort, a boutique haven of beachfront seclusion just four hours from Ho Chi Minh City. After sun-soaked days exploring Cham ruins, wandering the resort’s sprawling tropical gardens or savouring some of Asia's best kitesurfing, return to authentic lagoonside bites at L’Anmien or fine wines and Asian-inspired tapas at The Wine Room.",
          "image": "https://images.luxuryescapes.com/5haebvsm5cl2op500itr",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Phan Thiet",
            "addressCountry": "Vietnam"
          },
          "priceRange": "$162",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 162,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/phan-thiet"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover a charming haven set between the East Sea’s turquoise waters and Mui Ne’s golden dunes. A luxury beachfront resort nestled in lush foliage, relaxation will wash over you in one of two palm-fringed infinity pools, overlooking the ocean mere steps away. Seek serenity at the resort’s onsite spa, a tranquil sanctuary where Asian healing traditions interweave into holistic wellness journeys. Wine and dine at three exquisite restaurants and bars or immerse yourself in traditional Vietnamese cuisine in a step-by-step cooking class. Though it’s tempting to stay at the resort, Mui Ne’s Fairy Stream - a mesmerizing wonderland of natural waters and rock formations - is well worth the adventure. Take day trips to the famous White and Red Sand Dunes that are perfect for an exciting adventure. When night falls, don’t miss the sunset at the historic Mui Ne Fishing Village.",
          "image": "https://images.luxuryescapes.com/hpkn0z3igvxa3amwbxnr",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Phan Thiet",
            "addressCountry": "Vietnam"
          },
          "priceRange": "$169",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 169,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/phan-thiet"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 2,
    "bestRating": "5",
    "worstRating": "1"
  }
