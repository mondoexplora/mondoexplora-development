11:T42b1,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Santorini",
  "description": "Discover the best hotels in Santorini, Greece. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Greece"
  },
  "url": "https://mondoexplora.com/en/destination/santorini",
  "image": "https://images.luxuryescapes.com/ihmrd2s48bity9ctuo",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Santorini",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover new levels of Greek luxury at this five-star island haven perched only a five-minute walk from Oia's picturesque town centre, perfect for those spectacular Santorini sunsets. Spend your days stretched out by one of six outdoor pools, or stick to your suite for ultimate privacy and seclusion - each comes with a veranda overlooking the Aegean and an outdoor jacuzzi or private pool. Dial up the relaxation at the award-winning Anassa Spa or invigorate mind and body in the fully equipped fitness centre. Reward yourself with the Mediterranean cuisine of Alios Ilios restaurant or sip on a cocktail or two at the Akratos Poolside Bar - wherever you choose, the sunset is bound to make you swoon.",
          "image": "https://images.luxuryescapes.com/ihmrd2s48bity9ctuo",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$729",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 729,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "This boutique resort is a dream come true, blending upscale luxury with soothing relaxation in perfect harmony. Imagine it as your personal paradise, where you can sip a drink in your private infinity pool while enjoying the stunning views of Santorini’s world-famous caldera. Wander the charming streets of Oia or Fira, where white-washed buildings and sweeping views of the Aegean Sea come straight out of a postcard. Then, retire to your opulent suite in Imerovigli, known as the 'Balcony of the Aegean'. When it comes to pampering, this resort spares no expense. Enjoy world-class beauty and wellness treatments at Kallos Spa, from rejuvenating massages to invigorating yoga sessions. Afterwards, head to Throubi Restaurant, where Greek and Mediterranean cuisine shine with dishes crafted from fresh local ingredients, all while enjoying romantic sunset views from the dining terrace.",
          "image": "https://images.luxuryescapes.com/f35xwmgkjs9lybr12c9",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$1519",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 1519,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Journey across the sunken caldera to experience five-star luxury in Santorini, where stunning black sands, whitewashed architecture and the sparkling Aegean Sea set the scene. Nestled in the charming Kamari village, this chic hideaway epitomises Greek island elegance, with Italian-inspired touches and exquisite dining options. Indulge in poolside cocktails at the Pool Bar or savour Mediterranean flavours at Zaffron Restaurant. Spend sunlit days uncovering Kamari Vvllage’s treasures - from ancient ruins to taverna-lined boardwalks and Santorini’s only open-air cinema - then unwind at one of the resort’s luxe pools or on its private stretch of beach.",
          "image": "https://images.luxuryescapes.com/oaf5uyrfhaisciof9ls",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$609",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 609,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Carved gracefully into the cliffs of dreamy Santorini's Oia, right above the enchanting Ammoudi Bay, sits Santo Mine Oia Suites. Built on a former stone mine, each of the 37 suites making up this hideaway come with their own glistening private pools. Indulge in the local Greek cuisine while taking in incredible vistas over the Aegean Sea at The Sunset Restaurant, sip a botanical cocktail poolside or explore the wine cellar. For a touch of extra bliss, head to the spa for a rejuvenating treatment.",
          "image": "https://images.luxuryescapes.com/pmpntn24s6tz929l19ax",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$304",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 304,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience unparalleled bliss enveloped by the velvet blue of the Aegean Sea, unbeatable views of the charming Caldera and impeccable five-star service on your next Santorini stay at the Canaves Oia Suites. Situated on the clifftops above the island's labyrinth-like alleys, this award-winning hideaway offers a world-class stay. Enjoy an intimate Mediterranean dinner on the spectacular Panorama Balcony, savour the finest Greek cuisine under the stars at Petra Restaurant or taste the region's finest wines with a wine tasting journey curated by Canaves Oia. Create memories to last a lifetime with those closest to you with a private yacht charter or indulge in a treatment in the calming caves of Canaves Oia Spa. Experience life's finest splendour within the Cycladic beauty of this opulent Santorini getaway.",
          "image": "https://images.luxuryescapes.com/3h0j2up8o8m6sjyk631g",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$650",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 650,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Part of the Small Luxury Hotels of the World collection, Canaves Epitome stands out among an ocean of extravagance in Santorini. Expect accommodation adorned in Cycladic whites with earthy volcanic stone features, and two sumptuous dining spaces offering freshly caught seafood from Ammoudi Bay, the iconic fishing cove dazzling below the resort. Boasting inventive cocktails and Aegean views, Elements and Omnia offer fine dining to a truly cinematic backdrop. Even the seamless infinity pool draws your eye out to the horizon, where Santorini’s most photographed town, Oia, clings to the caldera. With a world-class spa built inside a natural cave, offering famous Rassul mineral mud baths, and private pools in each idyllic suite or villa, you couldn’t come closer to paradise.",
          "image": "https://images.luxuryescapes.com/r80uppe188tin9wo3w",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$495",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 495,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Cross the sunken caldera and embrace five-star island luxury with a stay at Grace Hotel, a modern cliffside sanctuary perched high above the dazzling Aegean Sea. There’s no better place to catch a spellbinding Santorini sunset than from your private terrace, and this extraordinary hotel offers that and much more. Perfect for honeymooners, romantics and dreamers, Grace Hotel is also an epicurean’s paradise, with onsite Varoulko Santorini effortlessly showcasing the island’s abundance of fresh produce and modern Greek gastronomy, mouthwateringly delicious enough to earn the restaurant a coveted Michelin star.",
          "image": "https://images.luxuryescapes.com/yvimxzmqqbvl8ymv15xg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$625",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 625,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover a new level of Greek luxury in the suites and villas at Santo Pure Oia Suites & Villas, a five-star escape perched only a five-minute walk from the Oia's picturesque town centre - and Santorini's spectacular sunsets. Spend your days stretched out by one of the six outdoor pools, or stick to your suite and villa for the ultimate in privacy - each comes with a veranda overlooking the Aegean and an outdoor jacuzzi or private pool. Dial up the relaxation at the award-winning Anassa Spa or invigorate mind and body in the fully equipped gym. Reward yourself with the Mediterranean cuisine of Alios Ilios restaurant or sip on a cocktail or two at the Akratos Poolside Bar - wherever you choose, the sunset is set to be spectacular.",
          "image": "https://images.luxuryescapes.com/dqtd75imlwtlhnlwuai",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$284",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 284,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Moments from the famed volcanic sand of Santorini's beaches, you’ll discover Nikki Beach Resort & Spa Santorini, a five-star lifestyle destination for discerning travellers. Pairing cutting-edge architecture with breathtaking views over the Aegean, the boutique resort is a haven for honeymooners and hedonists looking for the ultimate in relaxation and rejuvenation. Just eight kilometres from Santorini’s capital, Fira, and six kilometres from Ancient Thera, it’s perfectly positioned for enjoying the very best of the Greek isle. Just how you find your zen each day is up to you: spend hours hopping from the black sands of Monolithos to the 25-metre outdoor pool, working up a thirst only quenched by a cocktail from the swim-up bar. Embrace sensational serenity at the sophisticated Nikki Spa, before taking it up a notch at Nikki Beach Club, where resident DJs provide the soundtrack to smoothie-sipping and sushi roll-snacking. As the day rolls on, sample the blend of traditional Greek cuisine with a unique Peruvian style at the beachfront restaurant, Escape, or pop into the all-day bistro - Nikki Beach Restaurant - for light and fresh organic dishes. Finish every evening at the rooftop Soul Lounge, before retiring to your contemporary room or suite to do it all over again.",
          "image": "https://images.luxuryescapes.com/97ehweafigktt0ln7vut",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$380",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 380,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Santorini Secret Suites & Spa is a dreamy, romantic, five-star oasis perched atop the sheer cliff faces of an ancient sunken volcano. Wander past picturesque traditional white buildings topped with blue-domed roofs, and explore the nearby town of Oia bursting with cafes, restaurants, boutiques and stunning churches. Make the journey down the dramatic cliffside to immerse yourself in the crystal-clear waters of the caldera or admire the sparkling views from the hotel's glistening infinity pool. Enjoy a refreshing cocktail by the Pool Bar or indulge in Greek and Mediterranean cuisine with a fine dining experience at Black Rock Restaurant.",
          "image": "https://images.luxuryescapes.com/1aboz6e3tjzlx8s1eslq",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Santorini",
            "addressCountry": "Greece"
          },
          "priceRange": "$346",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 346,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/santorini"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 11,
    "bestRating": "5",
    "worstRating": "1"
