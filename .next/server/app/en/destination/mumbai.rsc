12:T18cc,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Mumbai",
  "description": "Discover the best hotels in Mumbai, India. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "India"
  },
  "url": "https://mondoexplora.com/en/destination/mumbai",
  "image": "https://images.luxuryescapes.com/drp3lhbidsu5v193ogqg",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Mumbai",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Experience the pinnacle of comfort at Grand Hyatt Mumbai Hotel & Residences. Nestled in the vibrant Santacruz district, this urban resort boasts spacious apartments, rooms and suites with city and garden views. Dive into the outdoor pool and recharge at the poolside bar, treat yourself at Club Oasis Spa or savour culinary masterpieces across six restaurants and bars. Just minutes from the airport and the Bandra Kurla Complex, this hotel puts Mumbai at your fingertips. After days exploring nearby temples or shopping at upscale malls, return to the hotel and relax amid 12 acres of lush greenery.",
          "image": "https://images.luxuryescapes.com/drp3lhbidsu5v193ogqg",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mumbai",
            "addressCountry": "India"
          },
          "priceRange": "$108",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 108,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mumbai"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Uncover the endless heritage and boundless charm of vibrant Mumbai from your base at Holiday Inn Mumbai International Airport, an IHG hotel. With easy access to the airport terminals, waste no time setting off on your adventures. After busy days, stay in and dine at the multi-cuisine restaurant or re-energise with a caffeine hit at the 24-hour cafe. Watch the planes take off and admire the misty skyline from the rooftop pool, or treat yourself to a massage at Tattva spa.",
          "image": "https://images.luxuryescapes.com/herf9kctp5r44xys8o",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mumbai",
            "addressCountry": "India"
          },
          "priceRange": "$72",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 72,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mumbai"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the perfect blend of beachside bliss and city sophistication at this contemporary haven overlooking Mumbai's Juhu Beach. Take a refreshing dip in the inviting outdoor pool, rejuvenate with luxurious spa treatments or keep up with your routine at the fully equipped fitness centre. Savour a variety of global flavours at one of five dining venues, including a beachfront restaurant perfect for sunset dinners. When you're ready to explore, the bustling Juhu Beach promenade, ISKCON Temple and Prithvi Theatre are all just moments away. Venture further to marvel at the ancient rock-cut temples of Elephanta Island, a short ferry ride away.",
          "image": "https://images.luxuryescapes.com/v2eu61x0mm8p3ul5uft2",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mumbai",
            "addressCountry": "India"
          },
          "priceRange": "$98",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 98,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mumbai"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Mumbai's UNESCO World Heritage-listed Art Deco precinct is yours to discover when you stay at InterContinental Marine Drive-Mumbai, an IHG Hotel. Wining and dining is a celebration here: discover romance at the rooftop Dome bar where views of the Arabian Sea are savoured alongside cocktails and premium wines, or dine at Kebab Korner for authentic and exquisite Indian cuisine. When you need a break from the heat, make a splash in the rooftop pool or dig into comfort food at L&S Bistro.",
          "image": "https://images.luxuryescapes.com/zv95kngqcfsx97xqv9dc",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Mumbai",
            "addressCountry": "India"
          },
          "priceRange": "$103",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 103,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/mumbai"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 4,
    "bestRating": "5",
    "worstRating": "1"
  }
