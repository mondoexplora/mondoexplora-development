12:T139d,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Taipei",
  "description": "Discover the best hotels in Taipei, Taiwan (Province of China). Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Taiwan (Province of China)"
  },
  "url": "https://mondoexplora.com/en/destination/taipei",
  "image": "https://images.luxuryescapes.com/je1jbbjewhl3n1raarqm",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Taipei",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Modern Taiwanese sophistication and old-world Western influences meet at the Regent Taipei, an IHG Hotel, a gorgeous property that encapsulates Taipei's melting-pot of cultures. An ideal location in the heart of the metropolis places a myriad of iconic Taipei attractions within walking distance, while onsite classic Regent amenities include sumptuous restaurants, sleek rooftop pool, luxury brand boutiques, and elevated offerings such as traditional calligraphy lessons and personalised charcuterie service.",
          "image": "https://images.luxuryescapes.com/je1jbbjewhl3n1raarqm",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Taipei",
            "addressCountry": "Taiwan (Province of China)"
          },
          "priceRange": "$221",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 221,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/taipei"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "In the riverside Dazhi district, Hotel Indigo Taipei North, an IHG Hotel is a vibrant gateway to the modern metropolis of Taipei. Dynamic guest rooms burst with colour and personality, delicious dishes await at the T.R Bar & Kitchen and a fully-equipped fitness centre will get your heart racing. Escape the hustle and bustle at the Meiti Riverside Park, or find welcome diversions at the nearby Miramar Entertainment Park, where entertainment, dining and retail are at your fingertips.",
          "image": "https://images.luxuryescapes.com/ci3o66uphlwbg6vcffz",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Taipei",
            "addressCountry": "Taiwan (Province of China)"
          },
          "priceRange": "$129",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 129,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/taipei"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "There's arguably nowhere more regal to stay when in Taipei than the renowned Mandarin Oriental, Taipei. This five-star haven, which has hosted the likes of Tom Cruise and Madonna, promises to dazzle with French chateau-inspired interiors and an enviable location on tree-lined Dunhua North Road, just a 10-minute drive from Xinyi shopping district. An urban oasis, this is the perfect introduction to the magic of Taiwan, with a glistening outdoor swimming pool offering spectacular vistas and cuisine worthy of one of Asia’s greatest dining destinations. Try contemporary Italian at Bencotto and late-night classics and cocktails at M.O. Bar.",
          "image": "https://images.luxuryescapes.com/vdhxts2qkmdswqlb34eq",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Taipei",
            "addressCountry": "Taiwan (Province of China)"
          },
          "priceRange": "$283",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 283,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/taipei"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 3,
    "bestRating": "5",
    "worstRating": "1"
  }
