11:T2044,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Seattle",
  "description": "Discover the best hotels in Seattle, United States. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "United States"
  },
  "url": "https://mondoexplora.com/en/destination/seattle",
  "image": "https://images.luxuryescapes.com/wkhfevzm8tdwmenbebbt",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Seattle",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Kimpton Palladian Hotel, an IHG Hotel, sits in the heart of Seattle's vibrant Belltown neighbourhood, offering guests convenient access to the iconic Pike Place Market, the scenic waterfront and an array of Seattle's finest new restaurants, charming cafés and trendy boutiques. Once you're done exploring, relax in your masculine-chic styled room with luxe amenities and contemporary furnishings that reflect Belltown’s hip heritage.",
          "image": "https://images.luxuryescapes.com/wkhfevzm8tdwmenbebbt",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Seattle",
            "addressCountry": "United States"
          },
          "priceRange": "$170",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 170,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/seattle"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the vibrant streets, bustling marketplaces and lively music scene of the Emerald City from the heart of Seattle's prestigious Queen Anne neighbourhood at The Maxwell Hotel - rated among the top 10% of properties worldwide on Tripadvisor. This art-inspired boutique property is only a few minutes' walk from iconic landmarks, including the Seattle Center, Space Needle, Museum of Pop Culture, Pike Place Market, Seattle Opera and Pacific Northwest Ballet. The whimsical Staypineapple Hotels are built as celebrations of the living arts. The lobby, guestrooms and stylish indoor pool are dotted with bold and beautiful abstract pieces and decorative tiling, with Staypineapple's signature yellow accents and pineapple logo making a frequent appearance. The chic Pineapple Bistro & Bar is an understated tribute to elegance and artistic excellence - with an extravagant floor-to-ceiling digital art wall - and the perfect place to enjoy a build-your-own mac and cheese masterpiece or new favourite cocktail around a welcoming community table and u-shaped bar. Combining unmatched sophistication and charm with modern chic, thoughtful features and gracious service, The Maxwell Hotel is sure to put a smile on your face.",
          "image": "https://images.luxuryescapes.com/rjvjj81hno1s576scnc",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Seattle",
            "addressCountry": "United States"
          },
          "priceRange": "$129",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 129,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/seattle"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Enjoy the laidlack Pacific Northwest living while connecting to the city's vibrance with a sojourn at Crowne Plaza Seattle - Downtown, an IHG Hotel. This urban sanctuary puts you in the perfect position to explore popular landmarks, from the Space Needle to Pike Place Market. Savour regional flavours at Regatta Bar and Grille, open daily for breakfast and dinner, or discover the city's thriving food scene, full of fresh seafood and farm-to-table recipes.",
          "image": "https://images.luxuryescapes.com/9su69driq974no4msin",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Seattle",
            "addressCountry": "United States"
          },
          "priceRange": "$115",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 115,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/seattle"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Stay in Seattle's historic West Edge neighbourhood, just steps from the Elliott Bay waterfront, at The Alexis Royal Sonesta Hotel - a charming hotel built in 1901 and luxuriously updated with modern comforts. For mouthwatering dishes, rare whiskeys and handcrafted cocktails, spend an evening at The Bookstore Bar & Café. If an afternoon of pampering sounds appealing, Chroma Spa offers a tranquil space to enjoy a full-body massage or botanical hair treatment. And when you're looking to get moving, the onsite fitness centre features Peloton bikes that are guaranteed to elevate your workout.",
          "image": "https://images.luxuryescapes.com/w1fikqil0ctx7aaf8p6v",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Seattle",
            "addressCountry": "United States"
          },
          "priceRange": "$148",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 148,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/seattle"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Nestled in the heart of Seattle, Kimpton Hotel Monaco Seattle, an IHG Hotel, exudes an irresistible blend of sophistication and charm. Each elegantly appointed room offers plush furnishings and sumptuous bedding. Indulge in the finest chef-crafted burgers and milkshakes at Outlier restaurant whilst enjoying a glass of wine on the cozy outdoor patio, equipped with fire pits. This pet-friendly hotel comes with a 24-hour fitness facility and a yoga mat in every room.",
          "image": "https://images.luxuryescapes.com/ro88tnzj1bk32ae21a7c",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Seattle",
            "addressCountry": "United States"
          },
          "priceRange": "$166",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 166,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/seattle"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 5,
    "bestRating": "5",
    "worstRating": "1"
  }
