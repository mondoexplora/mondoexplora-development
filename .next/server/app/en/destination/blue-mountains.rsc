12:T2be7,{
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "Blue Mountains",
  "description": "Discover the best hotels in Blue Mountains, Australia. Find exclusive deals and luxury accommodations.",
  "containedInPlace": {
    "@type": "Country",
    "name": "Australia"
  },
  "url": "https://mondoexplora.com/en/destination/blue-mountains",
  "image": "https://images.luxuryescapes.com/lktfgbwviyz6mdg3bw",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Hotels in Blue Mountains",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Proudly perched atop hazey rolling canyons, Lilianfels Blue Mountains Resort and Spa offers guests privileged views of New South Wales' prized UNESCO World Heritage-listed Blue Mountains National Park. Find reprieve from the stresses of everyday life with a soul-soothing treatment at Lilanfels Spa, float weightlessly in the heated indoor pool or dine, sip and sample decadent cuisine at any of the resort's onsite dining options, including the award-winning Darley's Restaurant & Bar",
          "image": "https://images.luxuryescapes.com/lktfgbwviyz6mdg3bw",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Blue Mountains",
            "addressCountry": "Australia"
          },
          "priceRange": "$206",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 206,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/blue-mountains"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Leave it all behind for the impressive natural beauty of the UNESCO World Heritage-listed Blue Mountains with a stay at the boutique Parklands Country Gardens and Lodges. Ideally located, days can be spent discovering the surrounding national park, wining and dining on local produce at the nearby town of Blackheath, and embracing the tranquil atmosphere of this unique part of Australia. Be sure to indulge with a hot stone massage at the onsite Parklands Day Spa.",
          "image": "https://images.luxuryescapes.com/v6ryu5qg522wehz4cava",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Blue Mountains",
            "addressCountry": "Australia"
          },
          "priceRange": "$161",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 161,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/blue-mountains"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover a world beyond modern luxuries, to a palace full of glamour and grandeur, with an opulent stay at The Hydro Majestic Hotel. Tucked away in the Blue Mountains, this wellness retreat-turned-hotel boasts dining options, including the award-winning Wintergarden restaurant, with breathtaking views of the lush Megalong Valley. Brimming with a natural elegance and filled with an incredibly romantic atmosphere, this Art Deco-inspired destination is the perfect escape.",
          "image": "https://images.luxuryescapes.com/v6w3mruworp9w57hv7nbc",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Blue Mountains",
            "addressCountry": "Australia"
          },
          "priceRange": "$122",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 122,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/blue-mountains"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Discover the heart of the Blue Mountains from Chalets at Blackheath, a five-star, eco-friendly accommodation and member of the esteemed Small Luxury Hotels of the World portfolio. Settled within the UNESCO World Heritage-listed Blue Mountains, the property houses four charming chalets designed to celebrate native Australian bushland. Experience boutique country elegance and cosy nights in front of the open fire, relax with a good book in hand in the communal onsite library and explore the magical surroundings.",
          "image": "https://images.luxuryescapes.com/xgzax9ho968jbkpot08",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Blue Mountains",
            "addressCountry": "Australia"
          },
          "priceRange": "$559",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 559,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/blue-mountains"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Let the magic of the Blue Mountains take hold when you stay at the five-star Spicers Sangoma Retreat, an all-inclusive forest sanctuary that harnesses the calming effects of nature. Be romanced by soaring views of the Nepean River as you discover the hidden indulgences of the ultra-private suites, each boasting treehouse-style luxury. Rest and relax in the main lounge, where a mosaic of animal hide ottomans, tribal artwork and rustic wooden furnishings arouses curiosity, with a backdrop of birdsong and bushland, ever-present thanks to floor-to-ceiling windows. Celebrated chefs take you on a culinary journey every evening at the sophisticated Restaurant Amara, where a degustation menu is inspired by a daily harvest, all sourced from within an hour's radius. Once you've tasted the region's bounty, deepen your connection to the local area with a range of recreational activities, including private abseiling, canyoning, hiking and mountain biking adventures.",
          "image": "https://images.luxuryescapes.com/qkb45ld4ozfgllrv2zy2o",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Blue Mountains",
            "addressCountry": "Australia"
          },
          "priceRange": "$1061",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 1061,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/blue-mountains"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Escape to the magic of the UNESCO World Heritage-listed Blue Mountains when you stay at Echoes Boutique Hotel & Restaurant. Hanging over the Jamison Valley, the hotel's unique location lends to uninterrupted panoramas and dramatic scenery. Relax at Echoes Day Spa with an extensive list of spa rituals and massage therapy including hot stone massages, facials, soak therapies and body treatments including body wraps. Afterwards, dine at the award-winning Echoes Restaurant & Bar.",
          "image": "https://images.luxuryescapes.com/5360fkakhrme1utdzxp",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Blue Mountains",
            "addressCountry": "Australia"
          },
          "priceRange": "$273",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 273,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/blue-mountains"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "LodgingBusiness",
          "description": "Set on 100 acres of trees and pasture, surrounded by the mountain peaks of the world’s widest canyon, Capertee Valley, Belle Bois, offers boutique country elegance. This idyllic adults-only retreat in the World Heritage-listed Greater Blue Mountains Area is ensconced in the Australian wilds. Sink into absolute comfort in your spacious suite with sweeping mountain vistas, as you revel in relaxation from sunrise to sunset. Enjoy the intimacy of this unique hosted abode and indulge in delicious country-style cuisine with the table d’hote dinner service, curl up in front of the fire in winter or enjoy a springtime picnic under the shade of a tree. Take some time to explore Capertee Valley's breathtaking surrounds on a bushwalk before plunging into the cool waters at Ganguddy Creek, or enjoy a leisurely drive through a backdrop of sweeping farmland and spectacular canyon cliffs, stopping by farm gates and cellar doors.",
          "image": "https://images.luxuryescapes.com/98vvbw4eci6j9a9orl69",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Blue Mountains",
            "addressCountry": "Australia"
          },
          "priceRange": "$394",
          "amenityFeature": [
            {
              "@type": "LocationFeatureSpecification",
              "name": "Free WiFi"
            },
            {
              "@type": "LocationFeatureSpecification",
              "name": "Luxury Accommodation"
            }
          ]
        },
        "price": 394,
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://mondoexplora.com/en/destination/blue-mountains"
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.5",
    "reviewCount": 7,
    "bestRating": "5",
    "worstRating": "1"
  }
