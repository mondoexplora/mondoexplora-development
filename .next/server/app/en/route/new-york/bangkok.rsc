a:{"metadata":[["$","title","0",{"children":"New York to Bangkok | Travel Guide & Hotel Deals | 45+ Hotels | MondoExplora | MondoExplora"}],["$","meta","1",{"name":"description","content":"Plan your trip from New York to Bangkok, Thailand. Find the best travel routes, compare 45+ hotels, and book exclusive deals. Best rates guaranteed with up to 60% off."}],["$","meta","2",{"name":"author","content":"MondoExplora Team"}],["$","link","3",{"rel":"manifest","href":"/site.webmanifest","crossOrigin":"$undefined"}],["$","meta","4",{"name":"keywords","content":"New York to Bangkok,New York Bangkok travel,Bangkok hotels,travel New York Bangkok,New York Bangkok route,hotels in Bangkok,Bangkok accommodation,travel guide New York Bangkok,Thailand travel,New York to Bangkok travel"}],["$","meta","5",{"name":"creator","content":"MondoExplora"}],["$","meta","6",{"name":"publisher","content":"MondoExplora"}],["$","meta","7",{"name":"robots","content":"index, follow"}],["$","meta","8",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","meta","9",{"name":"category","content":"travel"}],["$","meta","10",{"name":"classification","content":"Travel and Tourism"}],["$","meta","11",{"name":"geo.region","content":"Thailand"}],["$","meta","12",{"name":"geo.placename","content":"Bangkok"}],["$","link","13",{"rel":"canonical","href":"https://mondoexplora.com/en/route/new-york/bangkok/"}],["$","meta","14",{"name":"google-site-verification","content":"google-site-verification-code"}],["$","meta","15",{"property":"og:title","content":"New York to Bangkok | Travel Guide & Hotel Deals | 45+ Hotels | MondoExplora"}],["$","meta","16",{"property":"og:description","content":"Plan your trip from New York to Bangkok, Thailand. Find the best travel routes, compare 45+ hotels, and book exclusive deals. Best rates guaranteed with up to 60% off."}],["$","meta","17",{"property":"og:url","content":"https://mondoexplora.com/en/route/new-york/bang